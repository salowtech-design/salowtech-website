---
/**
 * Footer Component: Global site footer containing mission statement, navigation links,
 * direct contact coordinates (phone, email, WhatsApp), and copyright metadata.
 * Props: None
 */
import { Image } from "astro:assets";
import salowtechLogo from "../assets/salowtech_logo.png";
import { siteConfig } from "../data/site";
---

<footer class="ft" id="main-footer">
  <div class="wrap">
    <p class="quote">&ldquo;We build the next generation of India.&rdquo;</p>

    <div class="grid">
      <div>
        <a class="brand" href="/" aria-label="Salowtech Home">
          <Image
            src={salowtechLogo}
            width={46}
            height={32}
            alt="Salowtech Logo"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={95}
            class="h-8 sm:h-9 w-auto max-w-[48px] object-contain shrink-0"
          />
          <span class="block text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 font-sans">
            Salowtech
          </span>
        </a>
        <p class="about">
          We engineer the sovereign software platforms that power the next generation of India. Lifetime maintenance
          with all customizations included.
        </p>
        <a class="mail" href={`mailto:${siteConfig.contact.email}`}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          {siteConfig.contact.email}
        </a>
        <ul class="soc">
          <li>
            <a
              href={siteConfig.contact.whatsapp.directUrl}
              aria-label="WhatsApp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.42 14.28c-.23.65-1.33 1.24-1.86 1.32-.47.07-1.07.1-3.23-.79-2.76-1.14-4.52-3.96-4.66-4.14-.14-.18-1.12-1.49-1.12-2.85 0-1.36.71-2.02.96-2.3.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4.07.61.57.23.57.78 1.91.85 2.05.07.14.12.31.02.5-.1.19-.15.31-.3.48-.15.17-.32.38-.45.51-.15.15-.31.31-.13.62.18.31.79 1.3 1.7 2.11 1.17 1.04 2.15 1.37 2.46 1.52.31.15.49.13.67-.08.18-.21.78-.91.99-1.22.21-.31.42-.26.71-.15.29.11 1.83.86 2.14 1.02.31.16.52.23.6.36.08.13.08.76-.15 1.41z"></path>
              </svg>
              <span class="tip">WhatsApp</span>
            </a>
          </li>
          <li>
            <a href="https://instagram.com/salowtech" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
              </svg>
              <span class="tip">Instagram</span>
            </a>
          </li>
          <li>
            <a href="https://x.com/salowtech" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
              <span class="tip">X (Twitter)</span>
            </a>
          </li>
          <li>
            <a href="https://reddit.com/u/salowtech" aria-label="Reddit" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 11.5c0-1.38-1.12-2.5-2.5-2.5-.66 0-1.26.26-1.71.68-1.57-1.11-3.7-1.83-6.07-1.92l1.03-4.86 3.37.71c.07 1.05.94 1.89 2.01 1.89 1.12 0 2.03-.91 2.03-2.03s-.91-2.03-2.03-2.03c-.85 0-1.57.53-1.87 1.28l-3.87-.82a.5.5 0 0 0-.59.39l-1.18 5.55c-2.42.08-4.6.8-6.19 1.93-.45-.43-1.06-.69-1.73-.69-1.38 0-2.5 1.12-2.5 2.5 0 .98.57 1.82 1.39 2.22-.05.26-.08.52-.08.78 0 3.86 4.49 7 10 7s10-3.14 10-7c0-.26-.03-.52-.08-.77.83-.4 1.41-1.25 1.41-2.23zm-19.5 0c0-.83.67-1.5 1.5-1.5.4 0 .77.16 1.04.42-1.06.66-1.86 1.47-2.33 2.37-.13-.37-.21-.81-.21-1.29zm15 4.71c0 3.31-4.04 6-9 6s-9-2.69-9-6c0-.27.04-.54.12-.8 1.16 1.78 4.67 3.09 8.88 3.09s7.72-1.31 8.88-3.09c.08.26.12.53.12.8zm2.5-3.42c-.47-.9-1.27-1.71-2.33-2.37.27-.26.64-.42 1.04-.42.83 0 1.5.67 1.5 1.5 0 .48-.08.92-.21 1.29zM8.5 13.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm7 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-1.242 2.207c-.46-.46-1.3-.707-2.258-.707s-1.798.247-2.258.707a.498.498 0 0 0 .704.704c.264-.264.846-.411 1.554-.411s1.29.147 1.554.411a.498.498 0 0 0 .704-.704z"></path>
              </svg>
              <span class="tip">Reddit</span>
            </a>
          </li>
          <li>
            <a href={siteConfig.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path>
              </svg>
              <span class="tip">LinkedIn</span>
            </a>
          </li>
        </ul>
      </div>

      <nav aria-label="Services">
        <h3><a href="/services" class="hover:underline">Services</a></h3>
        <ul>
          <li>
            <a href="/services">All Services Overview</a>
          </li>
          <li>
            <a href="/web-development">Web Development</a>
          </li>
          <li>
            <a href="/mobile-app-development">Mobile App Development</a>
          </li>
          <li>
            <a href="/erp-development">ERP Development</a>
          </li>
          <li>
            <a href="/crm-development">CRM Development</a>
          </li>
          <li>
            <a href="/hrm-payroll">HRM &amp; Payroll</a>
          </li>
          <li>
            <a href="/ai-voice-assistant">AI Voice Assistant</a>
          </li>
          <li>
            <a href="/seo-and-growth">SEO &amp; Growth</a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3>Company</h3>
        <ul>
          <li>
            <a href="/about-us">About Us</a>
          </li>
          <li>
            <a href="/testimonials">Testimonials</a>
          </li>
          <li>
            <a href="/blog">Blog</a>
          </li>
          <li>
            <a href="#faq-section">FAQ &amp; Help</a>
          </li>
          <li>
            <a href="/contact-us">Contact Us</a>
          </li>
          <li>
            <a href="/privacy-policy">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms-and-conditions">Terms &amp; Conditions</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- Animated Staggered Lettermark -->
  <div class="wrap text-center flex justify-center">
    <div class="mark w-full text-center" id="mark" aria-hidden="true">
      <span style="--i:0">S</span>
      <span style="--i:1">a</span>
      <span style="--i:2">l</span>
      <span style="--i:3">o</span>
      <span style="--i:4">w</span>
      <span style="--i:5">t</span>
      <span style="--i:6">e</span>
      <span style="--i:7">c</span>
      <span style="--i:8">h</span>
    </div>
  </div>

  <div class="wrap">
    <div class="bar">
      <span>&copy; 2026 Salowtech. All rights reserved. 100% sovereign engineering.</span>
      <ul>
        <li>
          <a href="/privacy-policy">Privacy Policy</a>
        </li>
        <li>
          <a href="/terms-and-conditions">Terms &amp; Conditions</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
<!-- END: Footer Section -->
