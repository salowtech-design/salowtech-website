---
/**
 * QuoteForm Component: Universal lead capture form with reCAPTCHA v3 protection,
 * client validation, CRM logging, and live enterprise consultation details.
 * Props: eyebrow (string), titleHtml (string), description (string)
 */
import { Image } from "astro:assets";
import salowtechLogo from "../assets/salowtech_logo.png";
import salowtechMascot from "../assets/salowtech_mascot_3d.png";

interface Props {
  eyebrow?: string;
  titleHtml?: string;
  description?: string;
}

const {
  eyebrow = "Partner with India's Elite Digital Developers",
  titleHtml = 'Code. <span class="font-serif italic font-normal text-[#612319]">Rank. Convert.</span>',
  description = "Transform your digital infrastructure with high-performance software, enterprise HRM & ERM solutions, and automated intelligent workflows tailored for the Indian enterprise landscape."
} = Astro.props;
---

<!-- ================= LEAD CAPTURE: CODE. RANK. CONVERT. ================= -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 pt-8" id="lead-capture">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <!-- Left Pitch Column -->
    <div class="lg:col-span-6 flex flex-col justify-center">
      <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-neutral-600 mb-3 block">
        {eyebrow}
      </span>
      <h2
        class="font-editorial text-4xl sm:text-5xl lg:text-6xl text-neutral-950 font-normal tracking-tight leading-[1.1] mb-6"
        aria-label="Let's build your software product"
        set:html={titleHtml}
      />
      <p class="text-sm text-neutral-700 leading-relaxed max-w-md">{description}</p>
    </div>

    <!-- Right Lead Intake Form Card (Exact Style Matching Reference) -->
    <div class="lg:col-span-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] relative">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">Request A Quote</h3>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">Web roadmap &amp; sprint estimate in 24 hours</p>
          </div>
          <div class="w-10 h-10 rounded-full bg-[#FAF7F2] border border-[#7D3024]/20 p-1 flex items-center justify-center shadow-xs overflow-hidden shrink-0" title="Salowtech Mascot">
            <Image
              src={salowtechMascot}
              alt="Salowtech Mascot"
              width={40}
              height={40}
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>

        <form id="lead-intake-form" class="space-y-3.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
          <!-- Honeypot anti-spam trap (invisible to humans and screen-readers) -->
          <div class="hidden" aria-hidden="true" style="display:none !important;">
            <input type="text" name="_gotcha" id="home-gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field empty" />
          </div>
          <div>
            <label class="sr-only" for="home-name">
              Name*
            </label>
            <input
              class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
              id="home-name"
              name="name"
              aria-label="Name"
              placeholder="Name*"
              required=""
              type="text"
            />
          </div>
          <div>
            <label class="sr-only" for="home-phone">
              Phone No*
            </label>
            <input
              class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
              id="home-phone"
              name="phone"
              aria-label="Phone Number"
              placeholder="Phone No*"
              required=""
              type="tel"
            />
          </div>
          <div>
            <label class="sr-only" for="home-email">
              Email*
            </label>
            <input
              class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
              id="home-email"
              name="email"
              aria-label="Email Address"
              placeholder="Email*"
              required=""
              type="email"
            />
          </div>
          <div>
            <label class="sr-only" for="home-msg">
              Type Your Message*
            </label>
            <textarea
              class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
              id="home-msg"
              name="message"
              aria-label="Type Your Message"
              placeholder="Type Your Message*"
              required=""
              rows="3"
            ></textarea>
          </div>

          <!-- Trust / NDA Badge -->
          <div class="px-3.5 py-2.5 bg-[#FAF9F6] border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600">
            <span class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                />
              </svg>
              <span class="font-medium">100% Strict Mutual NDA Protected</span>
            </span>
            <span class="font-bold text-neutral-900">Verified</span>
          </div>
          <!-- Google reCAPTCHA v3 Protection Badge -->
          <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
            <span class="flex items-center gap-2 font-medium text-stone-700">
              <svg
                class="w-4 h-4 text-[#1a73e8]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                />
              </svg>
              <span>Protected by Google reCAPTCHA v3</span>
            </span>
            <span class="text-[11px] text-stone-400">
              <a
                href="https://policies.google.com/privacy"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline hover:text-stone-600 transition-colors"
              >
                Privacy
              </a>
              <span class="mx-1">&bull;</span>
              <a
                href="https://policies.google.com/terms"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline hover:text-stone-600 transition-colors"
              >
                Terms
              </a>
            </span>
          </div>

          <!-- Submit Button -->
          <div class="pt-1">
            <button type="submit" class="btn-salow-submit">
              <span class="btn-salow-logo-mark">
                <Image
                  src={salowtechLogo}
                  width={24}
                  height={24}
                  alt="Salowtech"
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  quality={90}
                />
              </span>
              <span class="btn-salow-text">SUBMIT REQUEST</span>
              <span class="btn-salow-arrow">&rarr;</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
