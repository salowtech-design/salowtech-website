---
/**
 * RelatedServicesAndGuides Component: Internal linking hub for SEO relevance across subpages.
 * Props: eyebrow (string), heading (string), services (ServiceItem[]), guides (GuideItem[])
 */
interface ServiceItem {
  title: string;
  path: string;
  description: string;
  tag: string;
}

interface GuideItem {
  title: string;
  path: string;
  readTime: string;
  tag: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  services: ServiceItem[];
  guides: GuideItem[];
}

const {
  eyebrow = "+ EXPAND YOUR INFRASTRUCTURE",
  heading = "Related Enterprise Solutions & Guides",
  services = [],
  guides = []
} = Astro.props;
---

<section
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-[#E8E1D3]"
  aria-labelledby="related-solutions-heading"
>
  <div class="mb-10 text-center sm:text-left">
    <span class="text-xs font-semibold uppercase tracking-widest text-[#7D3024] block mb-2">{eyebrow}</span>
    <h2
      id="related-solutions-heading"
      class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 font-display"
      aria-label={heading || "Related Services and Guides"}
    >
      {heading || "Related Services and Guides"}
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Related Services Column (7 cols) -->
    <div class="lg:col-span-7 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-stone-500 mb-3">Complementary Software Solutions</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {services.map((svc) => (
          <a
            href={svc.path}
            class="group p-5 bg-white rounded-2xl border border-[#E8E1D3] hover:border-[#7D3024] hover:shadow-md transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#FAF7F2] text-[#7D3024] border border-[#E8E1D3] mb-2.5">
                {svc.tag}
              </span>
              <h4 class="text-base font-bold text-neutral-900 group-hover:text-[#7D3024] transition-colors leading-snug">
                {svc.title}
              </h4>
              <p class="text-xs text-stone-600 mt-1.5 leading-relaxed">{svc.description}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-[#7D3024]">
              <span>Explore Architecture</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Related Technical Blog Guides Column (5 cols) -->
    <div class="lg:col-span-5 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-stone-500 mb-3">Engineering Guides &amp; Insights</h3>
      <div class="space-y-3">
        {guides.map((g) => (
          <a
            href={g.path}
            class="group p-4 bg-white rounded-xl border border-[#E8E1D3] hover:border-[#7D3024] hover:shadow-xs transition-all duration-200 block"
          >
            <div class="flex items-center justify-between text-[11px] text-stone-400 mb-1">
              <span class="font-semibold text-[#7D3024]">{g.tag}</span>
              <span>{g.readTime}</span>
            </div>
            <h4 class="text-sm font-semibold text-neutral-900 group-hover:text-[#7D3024] transition-colors leading-snug">
              {g.title}
            </h4>
          </a>
        ))}
        <div class="pt-2">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-xs font-bold text-[#7D3024] hover:text-[#5C2017] transition-colors"
          >
            <span>View All Engineering Articles</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
