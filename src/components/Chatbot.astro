---
/**
 * Chatbot Component: Salow AI enterprise conversational widget with 3D mascot,
 * audio chime, emoji picker, touch action hub, and client-side intent responses.
 * Props: None (self-contained global widget)
 */
import { Image } from "astro:assets";
import chatbotAvatar from "../assets/chatbot_avatar.png";
import { siteConfig } from "../data/site";
---

<div class="chatbot-widget-container" id="chatbot-widget">
  <!-- 3D Mascot Character Stage & Touch Quick Hub -->
  <div class="mascot-3d-stage" id="mascot-3d-stage">
    <!-- Mascot Jumping 3D Character Button -->
    <button
      type="button"
      id="chatbot-launcher"
      class="mascot-jumping-body"
      aria-label="Open Salowtech quick options & chat"
      aria-expanded="false"
      aria-controls="mascot-touch-menu chatbot-window"
    >
      <div class="mascot-avatar-wrapper">
        <Image
          src={chatbotAvatar}
          width={68}
          height={68}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          alt="Salowtech 3D Jumping Mascot"
          class="mascot-avatar-3d"
          format="webp"
          quality={92}
        />
        <!-- Online Pulse Indicator -->
        <span class="mascot-online-dot" title="Engineering Assistant Online"></span>
      </div>
    </button>

    <!-- 3D Ground Contact Shadow (Animated in sync with jump) -->
    <div class="mascot-ground-shadow" aria-hidden="true"></div>

    <!-- Smooth Touch Options Menu (Quick Action Hub) -->
    <div
      id="mascot-touch-menu"
      data-lenis-prevent
      class="mascot-touch-menu"
      role="menu"
      aria-label="Salowtech Quick Options"
      aria-hidden="true"
    >
      <!-- Menu Header -->
      <div class="mascot-menu-header">
        <div class="mascot-header-profile">
          <div class="mascot-mini-avatar">
            <Image
              src={chatbotAvatar}
              width={30}
              height={30}
              alt="Salow Mascot"
              class="object-contain"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={90}
            />
          </div>
          <div>
            <div class="mascot-menu-title">Salow Assistant</div>
            <div class="mascot-menu-status">
              <span class="mascot-status-sparkle">●</span> How can we help?
            </div>
          </div>
        </div>
        <button type="button" id="mascot-touch-close" class="mascot-menu-close" aria-label="Close options menu">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Quick Action Touch Items -->
      <div class="mascot-menu-items">
        <!-- Option 1: AI Chat Assistant -->
        <button type="button" id="touch-opt-chat" class="mascot-menu-btn group" role="menuitem">
          <div class="mascot-btn-icon bg-[#7D3024] text-white">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              />
            </svg>
          </div>
          <div class="mascot-btn-content">
            <span class="mascot-btn-label group-hover:text-[#7D3024] transition-colors">Chat with AI</span>
            <span class="mascot-btn-desc">Ask about stacks, timeline & cost</span>
          </div>
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-[#7D3024] group-hover:translate-x-0.5 transition-all"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Option 2: Request Proposal / Quote -->
        <a
          href="#lead-capture"
          id="touch-opt-quote"
          class="mascot-menu-btn group"
          role="menuitem"
          aria-label="Request a Quote - Proposal in 24 hours"
        >
          <div class="mascot-btn-icon bg-neutral-900 text-white">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
          </div>
          <div class="mascot-btn-content">
            <span class="mascot-btn-label group-hover:text-[#7D3024] transition-colors">Request a Quote</span>
            <span class="mascot-btn-desc">Proposal in 24 hours</span>
          </div>
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-[#7D3024] group-hover:translate-x-0.5 transition-all"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Option 3: WhatsApp Support -->
        <a
          href={siteConfig.contact.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mascot-menu-btn group"
          role="menuitem"
          aria-label="Connect with Salowtech on WhatsApp"
        >
          <div class="mascot-btn-icon bg-[#25D366] text-white">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
            </svg>
          </div>
          <div class="mascot-btn-content">
            <span class="mascot-btn-label group-hover:text-[#25D366] transition-colors">WhatsApp Live</span>
            <span class="mascot-btn-desc">Connect directly with team</span>
          </div>
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-[#25D366] group-hover:translate-x-0.5 transition-all"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Option 4: Direct Phone Call -->
        <a href={siteConfig.contact.phoneTel} class="mascot-menu-btn group" role="menuitem">
          <div class="mascot-btn-icon bg-amber-500 text-white">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
          </div>
          <div class="mascot-btn-content">
            <span class="mascot-btn-label group-hover:text-amber-600 transition-colors">Call Direct Desk</span>
            <span class="mascot-btn-desc">{siteConfig.contact.phone}</span>
          </div>
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-amber-600 group-hover:translate-x-0.5 transition-all"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Chat Modal Window -->
  <section
    id="chatbot-window"
    data-lenis-prevent
    class="chatbot-window"
    role="dialog"
    aria-modal="true"
    aria-labelledby="chatbot-heading"
  >
    <!-- Odoo Style Plum Header -->
    <header class="chatbot-header">
      <div class="chatbot-header-info">
        <Image
          src={chatbotAvatar}
          width={36}
          height={36}
          loading="lazy"
          decoding="async"
          alt="Salowtech Mascot"
          class="chatbot-header-avatar"
          format="webp"
          quality={90}
        />
        <div class="chatbot-header-text">
          <h3 id="chatbot-heading">Salowtech</h3>
        </div>
      </div>
      <div class="chatbot-header-actions">
        <button
          type="button"
          id="chatbot-minimize"
          class="chatbot-header-btn"
          title="Minimize Chat"
          aria-label="Minimize Chat"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 12H5" />
          </svg>
        </button>
        <button
          type="button"
          id="chatbot-close"
          class="chatbot-header-btn btn-close"
          title="Close Chat"
          aria-label="Close Chat"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Messages Stream -->
    <div class="chatbot-messages" id="chatbot-messages" data-lenis-prevent role="log" aria-live="polite">
      <!-- Date Divider -->
      <div class="chatbot-date-divider">
        <span class="chatbot-date-label">Today</span>
      </div>

      <!-- Initial Bot Message Row -->
      <div class="chatbot-msg-row">
        <Image
          src={chatbotAvatar}
          width={48}
          height={48}
          loading="lazy"
          decoding="async"
          alt="Salowtech Assistant"
          class="chatbot-bot-avatar"
          format="webp"
          quality={90}
        />
        <div class="chatbot-msg-content">
          <div class="chatbot-sender-meta">
            <span class="chatbot-sender-name">Salowtech</span>
            <span class="chatbot-timestamp" id="chatbot-init-time"></span>
          </div>
          <div class="chatbot-bot-bubble">Welcome to Salowtech! How can I help you?</div>
          <div class="chatbot-options-stack">
            <button type="button" class="chatbot-option-btn" data-query="Website Development">
              Website Development
            </button>
            <button type="button" class="chatbot-option-btn" data-query="App Development">
              App Development
            </button>
            <button type="button" class="chatbot-option-btn" data-query="CRM &amp; ERP">
              CRM &amp; ERP
            </button>
            <button type="button" class="chatbot-option-btn" data-query="HRM &amp; Payroll">
              HRM &amp; Payroll
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modern Input Footer -->
    <footer class="chatbot-footer-wrap">
      <!-- Emoji Popover -->
      <div id="chatbot-emoji-picker" data-lenis-prevent class="chatbot-emoji-picker" style="display: none;">
        <div class="chatbot-emoji-grid" id="chatbot-emoji-grid"></div>
      </div>

      <!-- Hidden Photo Input -->
      <label for="chatbot-file-input" class="sr-only">Upload attachment</label>
      <input
        type="file"
        id="chatbot-file-input"
        accept="image/*"
        style="display: none;"
        aria-label="Upload attachment"
      />

      <form id="chatbot-form" class="chatbot-input-box">
        <!-- Photo / Attachment Button -->
        <button
          type="button"
          id="chatbot-photo-btn"
          class="chatbot-input-action-btn"
          title="Send a Photo / Screenshot"
          aria-label="Send a photo"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </button>

        <!-- Speech-to-Text Microphone Button -->
        <button
          type="button"
          id="chatbot-mic-btn"
          class="chatbot-input-action-btn"
          title="Voice typing (Click to Speak)"
          aria-label="Voice typing"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
            />
          </svg>
        </button>

        <!-- Input Text Field (Zero Blue Outline) -->
        <label for="chatbot-input" class="sr-only">Type message</label>
        <input
          type="text"
          id="chatbot-input"
          class="chatbot-input-field"
          placeholder="Say something or speak..."
          autocomplete="off"
          aria-label="Type message"
        />

        <!-- Emoji Picker Toggle Button -->
        <button
          type="button"
          id="chatbot-emoji-btn"
          class="chatbot-input-action-btn"
          title="Insert Emoji"
          aria-label="Insert Emoji"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </button>

        <!-- Modern Straight Send Button -->
        <button
          type="submit"
          id="chatbot-send"
          class="chatbot-send-btn-modern"
          title="Send message"
          aria-label="Send message"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="margin-left: 2px;"
          >
            <path d="m3 3 3 9-3 9 19-9Z" />
            <path d="M6 12h16" />
          </svg>
        </button>
      </form>
    </footer>
  </section>
</div>
