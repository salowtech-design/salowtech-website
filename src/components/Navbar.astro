---
/**
 * Navbar Component: Antideploy-style morphing floating header with desktop flyouts,
 * mobile drawer, and dynamic active link highlighting.
 * Props: activePath (string) - Current pathname to set active indicator state
 */
import { Image } from "astro:assets";
import salowtechLogo from "../assets/salowtech_logo.png";

interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;
---

<!-- BEGIN: SiteHeader / Navigation -->
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none transition-all duration-300 ease-out pt-0 px-0"
>
  <div id="navbar-container" class="w-full flex items-center justify-between pointer-events-auto">
    <!-- Logo -->
    <a class="navbar-brand-wrap relative flex items-center gap-3.5 group flex-shrink-0" href="/">
      <Image
        id="navbar-logo"
        src={salowtechLogo}
        alt="Salowtech"
        width={120}
        height={40}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        format="webp"
        quality={95}
        class="h-10 w-auto object-contain group-hover:scale-95 transition-all duration-300"
      />
      <span
        id="navbar-brand-name"
        class="block text-2xl font-bold tracking-tight text-neutral-950 font-sans transition-all duration-300"
      >
        Salowtech
      </span>
    </a>

    <!-- Desktop Nav Items: Plain <a href> links for crawlable sitelinks hierarchy -->
    <nav class="hidden md:flex items-center space-x-1 sm:space-x-2 text-sm font-medium text-neutral-700 ml-auto mr-4">
      <!-- Services (Top-Level Sitelink Target + Flyout Menu) -->
      <div class="relative group/services">
        <a
          href="/services"
          id="services-menu-btn"
          aria-expanded="false"
          aria-haspopup="true"
          class={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors cursor-pointer font-medium text-sm focus:outline-none ${activePath === "/services" || activePath.startsWith("/services") ? "text-black bg-neutral-100 font-semibold" : ""}`}
        >
          <span>Services</span>
          <svg
            class="w-3.5 h-3.5 text-neutral-500 transition-transform duration-200 group-hover/services:rotate-180 group-focus-within/services:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Card -->
        <div
          id="services-dropdown-panel"
          role="menu"
          aria-orientation="vertical"
          class="absolute left-0 lg:left-1/2 lg:-translate-x-1/2 top-full pt-2.5 z-50 w-80 sm:w-96 opacity-0 pointer-events-none translate-y-2 group-hover/services:opacity-100 group-hover/services:pointer-events-auto group-hover/services:translate-y-0 group-focus-within/services:opacity-100 group-focus-within/services:pointer-events-auto group-focus-within/services:translate-y-0 transition-all duration-200 ease-out"
        >
          <div
            data-lenis-prevent
            class="bg-white rounded-2xl shadow-[0_20px_50px_-10px_rgba(43,35,26,0.12)] border border-[#E8E1D3] p-3 backdrop-blur-xl max-h-[82vh] overflow-y-auto"
          >
            <div class="flex items-center justify-between px-3 py-2.5 mb-1 border-b border-[#EFEAE1]">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[#F8EDE8] border border-[#7D3024]/15 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                    />
                  </svg>
                </div>
                <span class="font-bold text-base text-[#1C1A17] tracking-tight">Our Services</span>
              </div>
              <a href="/services" class="text-xs font-semibold text-[#7D3024] hover:underline">All Services &rarr;</a>
            </div>

            <div class="flex flex-col space-y-0.5">
              <a
                href="/web-development"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/web-development" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect
                      x="2"
                      y="4"
                      width="20"
                      height="13"
                      rx="2"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 20h8m-4-3v3" />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    Web Development
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Custom websites &amp; high-speed web apps
                  </span>
                </div>
              </a>

              <a
                href="/mobile-app-development"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/mobile-app-development" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect
                      x="6"
                      y="2"
                      width="12"
                      height="20"
                      rx="3"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle cx="12" cy="18" r="1" fill="currentColor" />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    Mobile App Development
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Native iOS &amp; Android applications
                  </span>
                </div>
              </a>

              <a
                href="/erp-development"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/erp-development" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect
                      x="3"
                      y="3"
                      width="18"
                      height="18"
                      rx="2"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M9 3v18M15 3v18M3 9h18M3 15h18"
                    />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    ERP Development
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Unified operations, inventory &amp; finance
                  </span>
                </div>
              </a>

              <a
                href="/crm-development"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/crm-development" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M4 7c0-2 4-3 8-3s8 1 8 3v10c0 2-4 3-8 3s-8-1-8-3V7z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M4 12c0 2 4 3 8 3s8-1 8-3"
                    />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v4m-3-2h6" />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    CRM Development
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Lead automation &amp; sales pipelines
                  </span>
                </div>
              </a>

              <a
                href="/hrm-payroll"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/hrm-payroll" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"
                    />
                    <circle cx="9" cy="7" r="4" stroke-width="1.8" />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
                    />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    HRM &amp; Payroll
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Workforce attendance &amp; statutory payroll
                  </span>
                </div>
              </a>

              <a
                href="/ai-voice-assistant"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/ai-voice-assistant" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M19 10v2a7 7 0 01-14 0v-2M12 19v4m-4 0h8"
                    />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    AI Voice Assistant
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Conversational AI voice agents &amp; 24/7 bots
                  </span>
                </div>
              </a>

              <a
                href="/seo-and-growth"
                class={`flex items-center gap-3.5 px-3 py-2 rounded-xl hover:bg-[#F5EFEB] text-left transition-colors duration-150 group/item ${activePath === "/seo-and-growth" ? "bg-[#F5EFEB]" : ""}`}
              >
                <div class="w-6 flex items-center justify-center text-[#7D3024] flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="m20 20-3.5-3.5M9 11l1.5 1.5 3-3"
                    />
                  </svg>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-semibold text-neutral-900 group-hover/item:text-[#7D3024] transition-colors leading-tight">
                    SEO &amp; Growth
                  </span>
                  <span class="text-xs text-neutral-500 font-normal mt-0.5 leading-snug">
                    Search engine rankings &amp; organic visibility
                  </span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <a
        class={`px-3.5 py-1.5 rounded-md text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors ${activePath === "/about-us" ? "text-black bg-neutral-100 font-semibold" : ""}`}
        href="/about-us"
      >
        About Us
      </a>
      <a
        class={`px-3.5 py-1.5 rounded-md text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors ${activePath === "/testimonials" ? "text-black bg-neutral-100 font-semibold" : ""}`}
        href="/testimonials"
      >
        Testimonials
      </a>
      <a
        class={`px-3.5 py-1.5 rounded-md text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors ${activePath === "/blog" ? "text-black bg-neutral-100 font-semibold" : ""}`}
        href="/blog"
      >
        Blog
      </a>
      <a
        class={`px-3.5 py-1.5 rounded-md text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors ${activePath === "/contact-us" ? "text-black bg-neutral-100 font-semibold" : ""}`}
        href="/contact-us"
      >
        Contact Us
      </a>
    </nav>

    <!-- Right CTAs -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <a
        href="#lead-capture"
        class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-neutral-950 hover:bg-neutral-800 text-white text-xs sm:text-sm font-semibold tracking-tight shadow-sm transition-all hover:shadow-md hover:scale-[1.02]"
      >
        <span>Get Started</span>
        <svg class="w-3.5 h-3.5 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-neutral-700 hover:text-black hover:bg-neutral-100 transition-colors focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu-drawer"
    data-lenis-prevent
    class="hidden md:hidden fixed top-16 left-0 right-0 bg-white/98 backdrop-blur-2xl border-b border-[#E8E1D3] shadow-2xl p-5 max-h-[85vh] overflow-y-auto pointer-events-auto transition-all duration-200"
  >
    <div class="flex flex-col space-y-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-[#7D3024] px-2 block mb-2">Company</span>
        <div class="grid grid-cols-1 gap-1">
          <a
            href="/about-us"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            About Us
          </a>
          <a
            href="/testimonials"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            Testimonials
          </a>
          <a
            href="/blog"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            Blog
          </a>
          <a
            href="/contact-us"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            Contact Us
          </a>
        </div>
      </div>

      <div class="border-t border-[#EFEAE1] pt-3">
        <a href="/services" class="text-xs font-bold uppercase tracking-wider text-[#7D3024] px-2 block mb-2 hover:underline flex items-center justify-between">
          <span>Services</span>
          <span class="text-[11px] font-semibold text-stone-500">View All &rarr;</span>
        </a>
        <div class="grid grid-cols-1 gap-1">
          <a
            href="/web-development"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            Web Development
          </a>
          <a
            href="/mobile-app-development"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            Mobile App Development
          </a>
          <a
            href="/erp-development"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            ERP Development
          </a>
          <a
            href="/crm-development"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            CRM Development
          </a>
          <a
            href="/hrm-payroll"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            HRM &amp; Payroll
          </a>
          <a
            href="/ai-voice-assistant"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            AI Voice Assistant
          </a>
          <a
            href="/seo-and-growth"
            class="px-3 py-2 rounded-lg text-sm font-medium text-neutral-800 hover:bg-[#F5EFEB] hover:text-[#7D3024] transition-colors"
          >
            SEO &amp; Growth
          </a>
        </div>
      </div>

      <div class="border-t border-[#EFEAE1] pt-3">
        <a
          href="#lead-capture"
          class="w-full flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-neutral-950 text-white font-semibold text-sm shadow-md"
        >
          <span>Get Started</span>
          <svg class="w-4 h-4 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
<!-- END: SiteHeader / Navigation -->
