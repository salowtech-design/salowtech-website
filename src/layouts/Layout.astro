---
/**
 * Main Layout Component: Standard HTML document shell with SEO meta tags, OpenGraph data,
 * font links, smooth scroll scripts, navigation bar, footer, and interactive chatbot.
 * Props: title, description, keywords, canonicalPath, ogTitle, ogDescription, ogImage, bodyClass, activePath, showChatbot, showPreFooterCTA, ctaHeading, schemaJson
 */
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Chatbot from "../components/Chatbot.astro";
import PreFooterCTA from "../components/PreFooterCTA.astro";
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
  activePath?: string;
  showChatbot?: boolean;
  showPreFooterCTA?: boolean;
  ctaHeading?: string;
  schemaJson?: any;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.meta.defaultDescription,
  keywords = siteConfig.meta.defaultKeywords,
  canonicalPath = "",
  ogTitle,
  ogDescription,
  ogImage = siteConfig.meta.defaultOgImage,
  bodyClass = "selection:bg-neutral-900 selection:text-white min-h-screen",
  activePath = "",
  showChatbot = true,
  showPreFooterCTA = false,
  ctaHeading,
  schemaJson,
  noindex = false
} = Astro.props;

// Clean canonical URL without www and without trailing slash (or '/' for home)
const cleanPath = canonicalPath.startsWith("/") ? canonicalPath : canonicalPath ? `/${canonicalPath}` : "";
const normalizedPath = cleanPath === "/" || cleanPath === "" ? "/" : cleanPath.replace(/\/$/, "");
const canonicalUrl = `${siteConfig.siteUrl}${normalizedPath}`;
const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Salowtech" />
    <meta name="apple-mobile-web-app-title" content="Salowtech" />
    {keywords && <meta name="keywords" content={keywords} />}
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      )
    }
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Salowtech" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="682" />
    <meta property="og:image:alt" content="Salowtech Core Engineering Team" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@salowtech" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons & Mobile Icons (Google Sitelinks & Favicon Guidelines Compliant) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload Critical Fonts -->
    <link
      rel="preload"
      href="/assets/fonts/plus-jakarta-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Local Self-Hosted Fonts -->
    <link rel="stylesheet" href="/css/fonts.css" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!-- FontAwesome 6 Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Stylesheets (Build-time Tailwind + Custom Styles) -->
    <link rel="stylesheet" href="/css/lenis.css" />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <link rel="stylesheet" href="/css/styles.css?v=20261030_v2" />

    {schemaJson && <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />}

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <Navbar activePath={activePath || cleanPath} />

    <slot />

    {showPreFooterCTA && <PreFooterCTA headingHtml={ctaHeading} />}

    <Footer />

    {showChatbot && <Chatbot />}

    <!-- Scripts -->
    <script is:inline src="/js/lenis.min.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline>
      // Canonical Lenis Smooth Inertia Engine Initialization (120fps GSAP Ticker Sync)
      (function () {
        if (typeof window === "undefined") return;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!prefersReducedMotion && typeof Lenis !== "undefined" && !window.lenis) {
          const lenis = new Lenis({
            duration: 1.15,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: "vertical",
            gestureOrientation: "vertical",
            smoothWheel: true,
            wheelMultiplier: 1.0,
            touchMultiplier: 1.0,
            syncTouch: false,
            smoothTouch: false,
            infinite: false
          });
          window.lenis = lenis;

          // Sync with GSAP ticker for 120fps stutter-free frame rendering
          if (typeof gsap !== "undefined" && gsap.ticker) {
            gsap.ticker.add((time) => {
              lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
          } else {
            function raf(time) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          }

          // Sync ScrollTrigger if available
          if (typeof ScrollTrigger !== "undefined") {
            lenis.on("scroll", ScrollTrigger.update);
          }

          // Respect prefers-reduced-motion dynamically
          window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", (e) => {
            if (e.matches && window.lenis) {
              window.lenis.destroy();
              window.lenis = null;
            }
          });
        }
      })();
    </script>
    <script is:inline src="/js/main.js?v=20261107_v4" defer></script>

    <script is:inline>
      // Accessibility: Sanitize dynamic iframes (e.g. reCAPTCHA role="presentation" W3C ARIA violation)
      (function () {
        function sanitizeIframe(node) {
          if (!node) return;
          if (node.nodeName === "IFRAME") {
            if (node.getAttribute("role") === "presentation" || node.getAttribute("role") === "none") {
              node.removeAttribute("role");
            }
            if (!node.getAttribute("title")) {
              node.setAttribute("title", "Security and Verification Service");
            }
          }
          if (node.querySelectorAll) {
            var nested = node.querySelectorAll('iframe[role="presentation"], iframe[role="none"]');
            for (var i = 0; i < nested.length; i++) {
              nested[i].removeAttribute("role");
            }
          }
        }

        function sanitizeAllIframes() {
          var iframes = document.querySelectorAll("iframe");
          for (var i = 0; i < iframes.length; i++) {
            var f = iframes[i];
            if (f.getAttribute("role") === "presentation" || f.getAttribute("role") === "none") {
              f.removeAttribute("role");
            }
            if (!f.getAttribute("title")) {
              f.setAttribute("title", "Security and Verification Service");
            }
          }
        }

        sanitizeAllIframes();

        if ("MutationObserver" in window) {
          var iframeObserver = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
              var m = mutations[i];
              if (m.type === "attributes" && m.target && m.target.nodeName === "IFRAME") {
                var role = m.target.getAttribute("role");
                if (role === "presentation" || role === "none") {
                  m.target.removeAttribute("role");
                }
              } else if (m.addedNodes) {
                for (var j = 0; j < m.addedNodes.length; j++) {
                  sanitizeIframe(m.addedNodes[j]);
                }
              }
            }
          });
          iframeObserver.observe(document.documentElement, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ["role"]
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", sanitizeAllIframes);
        }
        window.addEventListener("load", sanitizeAllIframes, { once: true });
      })();
    </script>

    <slot name="scripts" />
    <script src="../scripts/page-animations.ts"></script>
  </body>
</html>
