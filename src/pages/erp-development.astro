---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.erpDevelopment;
const title = seo.title;
const description = seo.description;
const keywords =
  "custom ERP software development India, enterprise ERP software solutions, manufacturing ERP software, multi-branch ERP system, GST compliant ERP India, cloud ERP software company, inventory supply chain management software";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "bg-cream-200 text-slate-800 font-sans antialiased selection:bg-maroon selection:text-white";
const showChatbot = true;
const relatedData = getServiceRelatedData("erp-development");
const schemaJson = getServiceSchema({
  serviceKey: "erp-development",
  serviceName: seo.title,
  serviceType: "Enterprise Resource Planning Software",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "ERP Development"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "ERP Development" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section class="relative pt-28 sm:pt-36 pb-16 lg:pt-36 lg:pb-24 overflow-hidden" data-purpose="hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left Column: Value Proposition & Bullet Points -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <!-- Main Hero Headline: Compact & stylish -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-tight leading-snug sm:leading-snug lg:leading-tight mb-4">
            ERP Development
          </h1>
          <p class="text-base sm:text-lg text-stone-600 font-medium mb-6">
            Synchronize Operations with{" "}
            <span class="font-serif italic font-bold text-maroon block sm:inline">Modern Cloud ERP Solutions</span>
          </p>

          <!-- 4 Value Bullets -->
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Unified Supply Chain, Finance &amp; Inventory Management
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Automated Cross-Departmental Workflows &amp; Real-Time Sync
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Seamless Cloud, Legacy &amp; Third-Party API Integrations
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Role-Based Access Controls &amp; Bank-Grade Security
              </span>
            </li>
          </ul>
          <!-- Dual Pill Button -->
          <div class="flex items-center">
            <div class="inline-flex rounded-full p-1 bg-maroon text-white shadow-lg shadow-maroon/25">
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase hover:bg-maroon-dark transition-colors cursor-pointer"
                href="/contact-us"
              >
                Contact Us
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Card (Exact Reference Style) -->
        <div class="lg:col-span-5" id="lead-form">
          <div class="bg-white rounded-2xl shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] p-6 sm:p-7 relative">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">ERP roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#7D3024]/20 p-0.5 flex items-center justify-center shadow-xs overflow-hidden shrink-0" title="Salowtech Mascot">
                <img src="/assets/salowtech_mascot_3d.png" alt="Salowtech Mascot" class="w-full h-full object-contain" />
              </div>
            </div>
            <form class="space-y-2.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
              <div>
                <label class="sr-only" for="erp-name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="erp-name"
                  name="name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="erp-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="erp-phone"
                  name="phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="erp-email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="erp-email"
                  name="email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="erp-message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="erp-message"
                  name="message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">SUBMIT REQUEST</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: BrandPropositionSection -->
  <section class="py-14 sm:py-16 bg-cream-100 border-y border-cream-300" data-purpose="brand-proposition">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-maroon/10 border border-maroon/20 w-fit mx-auto mb-3"></div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
        From Siloed Data to <span class="font-serif italic font-bold text-maroon">Unified Enterprise Intelligence</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto mb-7">
        At Salowtech, we architect tailored ERP platforms that connect finance, supply chain, warehouse, and human
        resources into one resilient ecosystem.
      </p>
      <div>
        <a
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide text-white bg-maroon hover:bg-maroon-dark shadow-md hover:shadow-lg transition-all duration-200"
          href="/contact-us"
        >
          Get Free ERP Consultation <span class="">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <!-- END: BrandPropositionSection -->

  <!-- BEGIN: SmartErpSolutionsSection (Exact Reference Tiered Design) -->
  <section class="py-16 lg:py-24" data-purpose="smart-erp-solutions-grid" id="solutions">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header Matching Reference -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-950 tracking-tight mb-3">
          Everything you need to operate, automate, and scale
        </h2>
        <p class="text-stone-600 text-sm sm:text-base">
          Unified operations. Zero-latency telemetry. Engineered for industrial enterprise scale.
        </p>
      </div>

      <!-- Tier 1: Financial & Supply Chain Core -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">1</span>
          <span class="tier-title">Financial &amp; Supply Chain Core</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 1 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Financial &amp; Accounting ERP
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Real-time multi-currency general ledgers, automated bank reconciliation, GST e-invoicing, and
                  audit-ready P&amp;L statements.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 2 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF6E8] border border-[#F3E5C7] text-[#D97706]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#D97706] transition-colors">
                  Supply Chain &amp; Logistics Control
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  End-to-end freight dispatching, GPS route monitoring, carrier contract rate engines, and automated
                  digital proof of delivery (e-POD).
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 2: Operations & Warehouse Automation -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">2</span>
          <span class="tier-title">Operations &amp; Warehouse Automation</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 3 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF1F0] border border-[#F3D5D3] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Inventory &amp; Warehouse Automation
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Multi-warehouse inventory routing, barcode/RFID scanning, batch expiry tracking, and automated min-max
                  reordering triggers.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 4 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#DCFCE7] text-[#059669]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#059669] transition-colors">
                  Manufacturing &amp; Production Scheduling
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Bill of materials (BOM), MRP II scheduling, shop-floor work orders, machine downtime alerts, and
                  quality control checkpoints.
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 3: Enterprise Ecosystem & Integration -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">3</span>
          <span class="tier-title">Enterprise Ecosystem &amp; Integration</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 5 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F5F2EB] border border-[#E2D7CD] text-[#5C2017]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#5C2017] transition-colors">
                  HRMS &amp; Payroll Integration
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Biometric attendance logging, 1-click salary disbursals, statutory PF/ESIC compliance, and employee
                  self-service portals.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 6 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  B2B Vendor &amp; Portals
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Role-based partner extranets with custom price books, credit limits, multi-tier purchase approvals,
                  and punchout catalogs.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 7 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#CCFBF1] text-[#0F766E]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#0F766E] transition-colors">
                  Multi-Branch Sync
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Zero-latency synchronization across distributed factories, warehouses, and retail outlets with offline
                  resilient queueing.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 8 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#FDF6E8] border border-[#F3E5C7] text-[#D97706]">
