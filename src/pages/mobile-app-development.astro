---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import ServiceVideoShowcase from "../components/ServiceVideoShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.mobileAppDevelopment;
const title = seo.title;
const description = seo.description;
const keywords =
  "mobile app development company India, custom iOS app development, Android app development agency, Flutter app development services, native mobile app architecture, React Native development Surat Bangalore";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "font-sans antialiased text-[#2A2428] selection:bg-[#7D3024]/20 selection:text-[#1C1713]";
const showChatbot = true;
const relatedData = getServiceRelatedData("mobile-app-development");
const schemaJson = getServiceSchema({
  serviceKey: "mobile-app-development",
  serviceName: seo.title,
  serviceType: "Mobile Application Development",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "Mobile App Development"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "Mobile App Development" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section
    class="relative pt-20 sm:pt-24 pb-8 sm:pb-12 overflow-hidden hero-circuit-bg border-b border-cream-300/60"
    data-purpose="hero-section"
  >
    <!-- Ambient ambient glow -->
    <div class="absolute -top-32 right-1/4 w-96 h-96 bg-[#7D3024]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        <!-- Left Content Column (Compact & Minimal for 100vh Laptop Viewport Fit) -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <h1 class="font-display text-3xl sm:text-4xl lg:text-[40px] font-extrabold leading-[1.16] tracking-tight mb-3 text-neutral-950">
            Mobile App Development
          </h1>
          <p class="font-display text-xl sm:text-2xl font-bold leading-snug tracking-tight mb-3 text-stone-700">
            Sovereign Mobile App Engineering Built for <span class="text-[#7D3024]">Exponential Scale</span>
          </p>

          <!-- Concise Narrative Subheading -->
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-4 max-w-xl">
            High-performance native iOS, Android, and Flutter applications engineered for silky 120 FPS
            micro-interactions, offline SQLite sync, and guaranteed App Store launch readiness.
          </p>

          <!-- Direct Answer AEO Block (Machine & Answer Engine Optimization) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#FAF7F2] border border-[#E8E1D3] text-stone-700 text-xs sm:text-sm leading-relaxed mb-6 max-w-xl" data-purpose="aeo-direct-answer">
            <p class="font-semibold text-neutral-900 mb-1 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#7D3024]"></span>
              <span>Quick Overview:</span>
            </p>
            <p>
              Salowtech Mobile App Development engineers high-performance native iOS, Android, and cross-platform Flutter applications. Designed for growing startups and established enterprises that demand 120 FPS fluid UI, offline-first SQLite synchronization, secure backend APIs, and guaranteed App Store and Google Play launch approval.
            </p>
          </div>

          <!-- Dual CTA Action Pills -->
          <div class="flex flex-wrap items-center gap-3 mb-5" data-purpose="dual-cta-group">
            <a
              class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#7D3024] hover:bg-[#5C2017] text-white rounded-full font-semibold text-xs sm:text-sm transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 cursor-pointer"
              href="/contact-us"
            >
              <span>Book Architecture Call</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-white hover:bg-cream-100 text-stone-800 border border-cream-300 rounded-full font-semibold text-xs sm:text-sm transition-all duration-200 shadow-xs hover:border-[#7D3024]/50"
              href="#mobile-showcase"
            >
              <span>Explore Capabilities</span>
              <span class="text-[#7D3024]">&darr;</span>
            </a>
          </div>
        </div>

        <!-- Right Floating Request A Quote Form (Compacted for screen fit) -->
        <div class="lg:col-span-5 relative" id="quote-card">
          <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-floating border border-cream-200 relative">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">Mobile app roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <span class="w-7 h-7 rounded-full bg-[#FFF5EE] text-[#F37021] flex items-center justify-center border border-[#FFE0CC] shadow-xs">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13 2L3 14h8l-1 8 11-13h-8l1-7z" />
                </svg>
              </span>
            </div>

            <form
              class="space-y-2.5"
              data-purpose="quote-form"
              onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);"
            >
              <div>
                <label class="sr-only" for="app-name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="app-name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="app-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="app-phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="app-email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="app-email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="app-message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="app-message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">SUBMIT REQUEST</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: StrategicTakeawaysSection (Realistic iPhone 16 Pro Flagship Showcase) -->
  <section
    class="py-12 lg:py-16 bg-cream-50 relative border-b border-cream-200 overflow-hidden"
    id="mobile-showcase"
    data-purpose="mobile-screen-showcase"
  >
    <!-- Ambient background radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#7D3024]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
        <span class="text-xs font-bold uppercase tracking-widest text-[#7D3024]">
          + REVOLUTIONARY MOBILE INTERFACES
        </span>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-neutral-950 tracking-tight mt-1.5 mb-2">
          Apps Engineered with the Precision of{" "}
          <span class="font-serif italic font-bold text-[#7D3024]">Fine Watchmaking</span>
        </h2>
        <p class="text-stone-600 text-xs sm:text-sm leading-relaxed max-w-2xl mx-auto">
          We engineer native systems designed specifically for hardware acceleration, offline resilience, and immediate
          touch feedback.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Strategic Value Pillars with Next-Level Bespoke SVG Icons -->
        <div class="lg:col-span-6 space-y-3.5">
          <!-- Pillar 1: Sub-100ms Native Cold Boot -->
          <div class="p-4 sm:p-4.5 rounded-2xl bg-white border border-cream-300 shadow-2xs hover:shadow-floating hover:border-[#7D3024]/60 transition-all duration-300 group">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#FFF5ED] via-[#FDF0E3] to-[#F5DEC7] border border-[#EACBB0] text-[#7D3024] flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:shadow-[0_8px_20px_rgba(125, 48, 36,0.25)] transition-all duration-300">
                <svg
                  class="w-5 h-5 text-[#7D3024]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M13 2L3 14h8l-1 8 11-13h-8l1-7z" fill="currentColor" fill-opacity="0.15" />
                  <path d="M13 2L3 14h8l-1 8 11-13h-8l1-7z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-sm sm:text-base text-neutral-900 group-hover:text-[#7D3024] transition-colors mb-1">
                  Sub-100ms Native Cold Boot
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Compiled native bytecodes with lazy asset hydration deliver immediate launch without white flash or
                  interpreter latency.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 2: Hardware Secure Enclave & Biometrics -->
          <div class="p-4 sm:p-4.5 rounded-2xl bg-white border border-cream-300 shadow-2xs hover:shadow-floating hover:border-[#10B981]/60 transition-all duration-300 group">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#EEFBF5] via-[#E2F7ED] to-[#C9EEDD] border border-[#A7E2C7] text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:shadow-[0_8px_20px_rgba(16,185,129,0.25)] transition-all duration-300">
                <svg
                  class="w-5 h-5 text-emerald-700"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.15" />
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <circle cx="12" cy="10.5" r="2.2" fill="currentColor" />
                  <path d="M12 12.7v3" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-sm sm:text-base text-neutral-900 group-hover:text-emerald-700 transition-colors mb-1">
                  Hardware Secure Enclave &amp; Biometrics
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Face ID, Touch ID, and hardware-isolated AES-256 encryption safeguard enterprise tokens and sensitive
                  offline records.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 3: Zero-Drop Offline SQLite Synchronization -->
          <div class="p-4 sm:p-4.5 rounded-2xl bg-white border border-cream-300 shadow-2xs hover:shadow-floating hover:border-[#0284C7]/60 transition-all duration-300 group">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#F0F8FF] via-[#E4F2FC] to-[#CFE8F9] border border-[#B3DBF4] text-sky-700 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:shadow-[0_8px_20px_rgba(2,132,199,0.25)] transition-all duration-300">
                <svg
                  class="w-5 h-5 text-sky-700"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <ellipse cx="12" cy="5" rx="8" ry="3" fill="currentColor" fill-opacity="0.15" />
                  <ellipse cx="12" cy="5" rx="8" ry="3" />
                  <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
                  <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
                  <path d="M16 19l2 2 4-4" stroke-width="2" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-sm sm:text-base text-neutral-900 group-hover:text-sky-700 transition-colors mb-1">
                  Zero-Drop Offline SQLite Synchronization
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Full functionality with zero network; transactional queuing and state-based CRDT algorithms guarantee
                  seamless conflict reconciliation.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 4: 100% App Store Clearance Guarantee -->
          <div class="p-4 sm:p-4.5 rounded-2xl bg-white border border-cream-300 shadow-2xs hover:shadow-floating hover:border-[#7D3024]/60 transition-all duration-300 group">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#FFF9F2] via-[#FDF2E6] to-[#F8E2CD] border border-[#ECCEB3] text-[#7D3024] flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:shadow-[0_8px_20px_rgba(125, 48, 36,0.25)] transition-all duration-300">
                <svg
                  class="w-5 h-5 text-[#7D3024]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                  <path
                    d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-4.05 11a22.4 22.4 0 0 1-3.95 2z"
                    fill="currentColor"
                    fill-opacity="0.15"
                  />
                  <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-4.05 11a22.4 22.4 0 0 1-3.95 2z" />
                  <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display font-bold text-sm sm:text-base text-neutral-900 group-hover:text-[#7D3024] transition-colors mb-1">
                  100% App Store Clearance Guarantee
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Strict adherence to Apple Human Interface Guidelines, sandboxed privacy declarations, and automated
                  TestFlight release CI/CD.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Solid, High-Converting Native Mobile App Showcase (iPhone 18 Pro 3D Interactive Model) -->
        <div class="lg:col-span-6 relative flex flex-col items-center justify-center py-4 lg:py-6" id="phone-stage">
          <!-- 3D iPhone 18 Pro Flagship Chassis -->
          <div class="iphone-3d-stage w-full flex flex-col items-center justify-center">
            <div class="iphone-18-frame w-full max-w-[345px] sm:max-w-[365px]" id="interactive-phone">
              <!-- Physical Hardware Side Buttons -->
              <div
                class="iphone-btn-action"
                title="Action Button"
                onclick="triggerToast('⚡ Action Button: Focus Mode Active')"
              ></div>
              <div class="iphone-btn-volup" title="Volume Up" onclick="triggerToast('🔊 Volume: 85%')"></div>
              <div class="iphone-btn-voldown" title="Volume Down" onclick="triggerToast('🔉 Volume: 60%')"></div>
              <div class="iphone-btn-power" title="Side Button (Apple Pay)" onclick="openApplePaySheet()"></div>

              <!-- Top Ear Speaker Micro Slit -->
              <div class="iphone-ear-speaker"></div>

              <!-- Inner OLED Screen Display -->
              <div class="iphone-inner shadow-inner relative" id="iphone-screen">
                <!-- Screen Glass Specular Glare Overlay -->
                <div class="iphone-glass-glare" id="iphone-glare"></div>

                <!-- Dynamic Island (Interactive & Expandable) -->
                <div
                  class="iphone-island"
                  id="dynamic-island"
                  title="Interactive Dynamic Island - Tap to expand"
                  onclick="toggleDynamicIsland(event)"
                >
                  <!-- Collapsed Pill View -->
                  <div class="island-collapsed-content flex items-center justify-between w-full" id="island-collapsed">
                    <div class="flex items-center gap-1.5">
                      <div class="iphone-island-camera"></div>
                      <div class="flex items-center gap-0.5 ml-1">
                        <span class="island-wave-bar"></span>
                        <span class="island-wave-bar"></span>
                        <span class="island-wave-bar"></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1 text-[9px] font-sans font-bold text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span>Live Order &bull; 4m</span>
                    </div>
                  </div>

                  <!-- Expanded Dynamic Island View -->
                  <div
                    class="island-expanded-content hidden w-full h-full flex flex-col justify-between text-white font-sans"
                    id="island-expanded"
                  >
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                          <svg
                            class="w-3.5 h-3.5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <rect x="1" y="3" width="15" height="13" />
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                          </svg>
                        </div>
                        <span class="text-[11px] font-bold text-white leading-tight">Express Fleet #8492</span>
                      </div>
                      <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/20 px-2 py-0.5 rounded-full">
                        ETA 3m 48s
                      </span>
                    </div>
                    <div class="flex items-center justify-between text-[9px] text-stone-300 pt-1">
                      <span>Courier: Vikram S. • 4.9★</span>
                      <div class="flex items-center gap-1.5">
                        <button
                          type="button"
                          class="px-2 py-0.5 rounded-md bg-emerald-600 text-white font-bold text-[8px] hover:bg-emerald-500 transition"
                          onclick="callCourier(event)"
                        >
                          📞 Call
                        </button>
                        <button
                          type="button"
                          class="px-2 py-0.5 rounded-md bg-neutral-800 text-stone-300 font-bold text-[8px] hover:bg-neutral-700 transition"
                          onclick="openLiveTrackSheet(event)"
                        >
                          📍 Map
                        </button>
                      </div>
