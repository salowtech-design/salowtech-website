---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import salowtechMascot3d from "../assets/salowtech_mascot_3d.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { siteConfig } from "../data/site";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.crmDevelopment;
const title = seo.title;
const description = seo.description;
const keywords =
  "custom CRM software development company, enterprise CRM development services, sales pipeline automation CRM, multi-channel lead tracking CRM, custom customer relationship management software, bespoke CRM solutions India";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "bg-cream-200 text-slate-800 font-sans antialiased selection:bg-maroon selection:text-white";
const showChatbot = true;
const relatedData = getServiceRelatedData("crm-development");
const schemaJson = getServiceSchema({
  serviceKey: "crm-development",
  serviceName: seo.title,
  serviceType: "Customer Relationship Management Software",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "CRM Development"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "CRM Development" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section class="relative pt-28 sm:pt-36 pb-20 lg:pt-36 lg:pb-28 overflow-hidden" data-purpose="hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Column: Value Proposition & Bullet Points -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <!-- Main Hero Headline -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-tight leading-snug sm:leading-snug lg:leading-tight mb-4">
            CRM Development
          </h1>
          <p class="text-base sm:text-lg text-stone-600 font-medium mb-6">
            Transform Customer Relationships with{" "}
            <span class="font-serif italic font-bold text-maroon block sm:inline">Scalable Sales Pipelines</span>
          </p>

          <!-- 4 Bullet Points with Icons -->
          <ul class="space-y-3.5 mb-10">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Custom Workflow Automation &amp; Pipeline Management
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                360° Lead Tracking &amp; Predictive Sales Intelligence
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Omnichannel Integrations (Email, Telephony, WhatsApp, ERP)
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Enterprise-Grade Data Privacy &amp; Role-Based Access
              </span>
            </li>
          </ul>

          <!-- Dual Pill Button -->
          <div class="flex items-center">
            <div class="inline-flex rounded-full p-1 bg-maroon text-white shadow-lg shadow-maroon/25">
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase hover:bg-maroon-dark transition-colors"
                href="/contact-us"
              >
                Contact Us
              </a>
              <span class="flex items-center px-3 text-xs uppercase tracking-wider text-white/70 font-medium">OR</span>
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase bg-white/10 hover:bg-white/20 transition-colors"
                href={siteConfig.contact.phoneTel}
              >
                Call Now
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Card (Exact Reference Style) -->
        <div class="lg:col-span-5" id="lead-form">
          <div class="bg-white rounded-2xl shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] p-6 sm:p-7 relative">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">CRM roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#7D3024]/20 p-0.5 flex items-center justify-center shadow-xs overflow-hidden shrink-0" title="Salowtech Mascot">
                <Image src={salowtechMascot3d} alt="Salowtech Mascot" width={32} height={32} class="w-full h-full object-contain" loading="lazy" />
              </div>
            </div>
            <form class="space-y-2.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
              <div>
                <label class="sr-only" for="crm-name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="crm-name"
                  name="name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="crm-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="crm-phone"
                  name="phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="crm-email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="crm-email"
                  name="email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="crm-message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="crm-message"
                  name="message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">SUBMIT REQUEST</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: BrandPropositionSection -->
  <section class="py-16 sm:py-20 bg-cream-100 border-y border-cream-300" data-purpose="brand-proposition">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Headline with Italic Serif Accent -->
      <h2 class="text-2xl sm:text-3xl lg:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-5">
        From Fragmented Data to <span class="font-serif italic font-bold text-maroon">Actionable CRM Intelligence</span>
      </h2>
      <!-- Concise Copy -->
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto mb-8">
        At Salowtech, we design and build bespoke CRM platforms that unify sales, marketing, and customer support into
        one synchronized revenue ecosystem. Eliminate manual bottlenecks, forecast with precision, and scale your
        operations effortlessly.
      </p>
      <!-- CTA Button -->
      <div>
        <a
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-sm font-bold uppercase tracking-wide text-white bg-maroon hover:bg-maroon-dark shadow-md hover:shadow-lg transition-all duration-200"
          href="/contact-us"
        >
          Get Free CRM Consultation <span class="">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <!-- END: BrandPropositionSection -->

  <!-- BEGIN: SmartCrmSolutionsSection (Exact Reference Tiered Design) -->
  <section class="py-16 lg:py-24" data-purpose="smart-crm-solutions-grid" id="solutions">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header Matching Reference -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-950 tracking-tight mb-3">
          Everything you need to run, sell, and scale
        </h2>
        <p class="text-stone-600 text-sm sm:text-base">
          Powerful capabilities. Predictable value. Built to grow with your business.
        </p>
      </div>

      <!-- Tier 1: Core Platform -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">1</span>
          <span class="tier-title">Core Platform</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 1 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  CRM for Small Business
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Manage leads, contacts, and pipelines in one intuitive platform designed to help you grow
                  relationships and close more deals.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 2 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF6E8] border border-[#F3E5C7] text-[#D97706]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#D97706] transition-colors">
                  Predictable Pricing &amp; ROI
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Fixed, transparent pricing with no hidden costs. Full source code ownership and long-term value you
                  can count on.
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 2: Dedicated Engineering -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">2</span>
          <span class="tier-title">Dedicated Engineering</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 3 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF1F0] border border-[#F3D5D3] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Hire Dedicated CRM Developers
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Scale your team with skilled, vetted CRM developers who integrate seamlessly and deliver impact from
                  day one.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 4 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#F5F2EB] border border-[#E2D7CD] text-[#1C1917]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Full-Stack Web Developers
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Expert developers across front-end, back-end, and databases—building secure, scalable, and
                  future-ready solutions.
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 3: Connected Experiences -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">3</span>
          <span class="tier-title">Connected Experiences</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 5 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#DCFCE7] text-[#059669]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#059669] transition-colors">
                  LMS Development Services
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Engaging learning platforms with robust content management and seamless user experiences.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 6 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  B2C Customer Portal
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Personalized, secure portals that empower customers and strengthen relationships.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 7 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#CCFBF1] text-[#0F766E]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#0F766E] transition-colors">
                  B2B Enterprise Portal
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Streamline operations and collaboration with enterprise-grade portals built for scale and security.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 8 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F5F2EB] border border-[#E2D7CD] text-[#5C2017]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
