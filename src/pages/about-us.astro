    <!-- ================= 7. CLOSING & STANDARDIZED QUOTE FORM ================= -->
    <section class="max-w-6xl mx-auto px-6 py-20 sm:py-28 animate-on-scroll" id="contact">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Closing Statement (hello.html Specification) -->
        <div class="lg:col-span-6">
          <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#7D3024] uppercase mb-4">
            Start a conversation
          </p>
          <h2 class="editorial-headline text-4xl sm:text-5xl md:text-6xl text-neutral-950 font-normal leading-[1.08] mb-6">
            We don’t chase trends.
            <br />
            We compound quality.
          </h2>
          <p class="text-neutral-600 text-lg leading-relaxed mb-8 max-w-lg">
            If you’re looking for an engineering partner who values depth over noise and long-term sovereignty over
            quick hacks, we should talk.
          </p>

          <div class="space-y-4 text-sm text-neutral-700">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-[#FAF3F1] text-[#7D3024] flex items-center justify-center font-bold text-xs">
                &check;
              </span>
