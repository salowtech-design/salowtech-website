      <!-- Bottom Row Marquee (Reverse) -->
      <div class="overflow-hidden w-full relative">
        <div class="marquee-track-reverse flex items-center gap-6">
          <div class="w-72 h-48 rounded-2xl overflow-hidden soft-card flex-shrink-0 bg-stone-100">
            <Image
              src={cs6}
