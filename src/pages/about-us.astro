  #swBadge,#swMascotHero,#swBubble,#swScrollHint,
  .sw-fcard,.sw-fph,.sw-fph>img,.sw-fghost,.sw-frule,.sw-fname,.sw-frole,.sw-fbio,
  .sw-stat .sw-lb,.sw-stat .sw-bar,.sw-hstep,.sw-spark,
  #swCta .sw-sub,.sw-btnLight,#swCta .sw-mail,#swMascotCta{opacity:1!important;transform:none!important;clip-path:none!important}
