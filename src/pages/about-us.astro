</style>

<script is:inline>
/* ═══════════════════════════════════════════════════════════
   SALOWTECH ABOUT — DETERMINISTIC ANIMATION ENGINE
   Ported from hello.astro reference. Everything is a pure
   function of time t (seconds) and scroll position y (pixels).
   ═══════════════════════════════════════════════════════════ */
(function(){
'use strict';
if(typeof window==='undefined')return;
var prefersReduced=window.matchMedia('(prefers-reduced-motion:reduce)').matches;

var clamp=function(v,a,b){if(a===undefined)a=0;if(b===undefined)b=1;return Math.min(b,Math.max(a,v))};
var lerp=function(a,b,p){return a+(b-a)*p};
var eoExpo=function(p){return p>=1?1:1-Math.pow(2,-10*p)};
var eoCubic=function(p){return 1-Math.pow(1-p,3)};
var eioCubic=function(p){return p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2};
var eoBack=function(p){var c=1.70158,c3=c+1;return 1+c3*Math.pow(p-1,3)+c*Math.pow(p-1,2)};
var spring=function(p){return 1-Math.cos(p*Math.PI*2.2)*Math.exp(-4.2*p)};

var $=function(s){return document.querySelector(s)};
var $$=function(s){return Array.prototype.slice.call(document.querySelectorAll(s))};

/* ---- split hero headline into words ---- */
function splitWords(el){
  if(!el)return[];
  var walk=function(n){Array.prototype.slice.call(n.childNodes).forEach(function(c){
    if(c.nodeType===3){
      var frag=document.createDocumentFragment();
      c.textContent.split(/(\s+)/).forEach(function(part){
        if(!part)return;
        if(/^\s+$/.test(part)){frag.appendChild(document.createTextNode(' '));return}
        var w=document.createElement('span');w.className='w';
        var wi=document.createElement('span');wi.className='wi';wi.textContent=part;
        w.appendChild(wi);frag.appendChild(w);
      });
      n.replaceChild(frag,c);
    } else if(c.nodeType===1) walk(c);
  })};walk(el);
  return Array.prototype.slice.call(el.querySelectorAll('.wi'));
}

/* ---- split statement into words ---- */
function splitStmt(el){
  if(!el)return[];
  var walk=function(n){Array.prototype.slice.call(n.childNodes).forEach(function(c){
    if(c.nodeType===3){
      var frag=document.createDocumentFragment();
      c.textContent.split(/(\s+)/).forEach(function(part){
        if(!part)return;
        if(/^\s+$/.test(part)){frag.appendChild(document.createTextNode(' '));return}
        var s=document.createElement('span');s.className='sw-sw';s.textContent=part;frag.appendChild(s);
      });n.replaceChild(frag,c);
    } else if(c.nodeType===1) walk(c);
  })};walk(el);
  return Array.prototype.slice.call(el.querySelectorAll('.sw-sw'));
}

var heroWords=splitWords($('#swH1'));
var stmtWords=splitStmt($('#swStmtP'));

/* ---- marquees ---- */
var MQ1=['Web Development','Mobile Apps','CRM','ERP','HRM & Payroll','AI Voice','SEO & Growth'];
var mq1El=$('#swMq1');
if(mq1El) mq1El.innerHTML=Array(3).fill(MQ1.map(function(s){return '<span>'+s+'<i class="sw-st">✦</i></span>'}).join('')).join('');
var MQ3=["Let's build yours","Salowtech","Let's build yours","Salowtech"];
var mq3El=$('#swMq3');
if(mq3El) mq3El.innerHTML=Array(2).fill(MQ3.map(function(s){return '<span>'+s+'</span>'}).join('')).join('');

/* ---- geometry ---- */
var G=null;
function getY(){return window.lenis?window.lenis.scroll:(window.scrollY||window.pageYOffset||0)}
function getStaticTop(el){
  var top=0;
  while(el){
    top+=el.offsetTop||0;
    el=el.offsetParent;
  }
  return top;
}
function measure(){
  var q=function(s){var el=$(s);return el?getStaticTop(el):0};
  var el=function(s){var e=$(s);return e?e.offsetHeight:0};
  G={
    vh:innerHeight,
    stmtTop:q('#swStmtWrap'),stmtH:el('#swStmtWrap'),
    storyTop:q('#swStory'),storyH:el('#swStory'),
    teamTop:q('#swTeam'),teamH:el('#swTeam'),
    foundersTop:q('#swFounders'),frowsH:el('#swFounders'),
    frows:$$('.sw-fcard').map(function(c){return getStaticTop(c)}),
    statsTop:q('#swStats'),statsH:el('#swStats'),
    valuesTop:q('#swValuesWrap'),valuesH:el('#swValuesWrap'),
    vcards:$$('.sw-vcard').map(function(e){return{top:getStaticTop(e),h:e.offsetHeight}}),
    howTop:q('#swHow'),howH:el('#swHow'),
    ctaTop:q('#swCta'),ctaH:el('#swCta'),
    mq1W:mq1El?mq1El.scrollWidth/3:1000,
    mq3W:mq3El?mq3El.scrollWidth/2:1000
  };
  G.maxY=Math.max(1,document.documentElement.scrollHeight-G.vh);
}

/* ---- per-frame render ---- */
var lastY=0,velo=0;
function render(t,y){
  velo=lerp(velo,(y-lastY),0.35);lastY=y;
  var vh=G.vh;

  /* progress */
  var prog=$('#swProgress');if(prog) prog.style.transform='scaleX('+clamp(y/G.maxY)+')';

  /* ========= HERO ========= */
  var heroP=clamp(y/vh);
  var ey=$('#swEyebrow');
  if(ey){
    var ep=eoCubic(clamp((t-0.15)/0.7));
    ey.style.opacity=ep*(1-clamp((heroP-0.15)/0.6));
    ey.style.transform='translateY('+(1-ep)*18+'px)';
  }
  heroWords.forEach(function(w,i){
    var p=clamp((t-0.35-i*0.085)/0.9),e=eoExpo(p);
    w.style.transform='translateY('+(1-e)*112+'%) rotate('+(1-e)*7+'deg)';
    w.style.opacity=p<=0?0:1;
  });
  var heroFade=clamp((heroP-0.15)/0.6);
  var h1=$('#swH1');if(h1) h1.style.transform='translateY('+(-heroP*vh*0.22)+'px)';
  var hs=$('#swHeroSub');if(hs){var sp=eoCubic(clamp((t-1.35)/0.9));hs.style.opacity=sp*(1-heroFade);hs.style.transform='translateY('+(1-sp)*26+'px)';}
  var hm=$('#swHeroMeta');if(hm){var mp=eoCubic(clamp((t-1.6)/0.9));hm.style.opacity=mp*(1-heroFade);hm.style.transform='translateY('+(1-mp)*26+'px)';}
  var wm=$('#swWatermark');if(wm) wm.style.transform='translate(calc(-50% + '+t*-14+'px), calc(-50% + '+(-heroP*vh*0.35)+'px))';
  /* badge */
  var bdg=$('#swBadge');
  if(bdg){var bp=eoBack(clamp((t-1.8)/0.8));bdg.style.opacity=bp;
    var bs=bdg.querySelector('svg');if(bs) bs.style.transform='rotate('+t*14+'deg) scale('+bp+')';
    var bst=bdg.querySelector('.sw-star');if(bst) bst.style.transform='scale('+bp+') rotate('+(-t*20)+'deg)';}
  /* swash */
  var sw=eoCubic(clamp((t-1.75)/0.8));
  var swp=$('#swSwashPath');if(swp) swp.setAttribute('stroke-dashoffset',100*(1-sw));
  /* mascot */
  var mp2=spring(clamp((t-2.0)/1.4));
  var bob=Math.sin(t*2.1)*9;
  var tilt=clamp(velo*0.25,-14,14);
  var mh=$('#swMascotHero');if(mh){mh.style.transform='translateY('+((1-mp2)*260+bob)+'px) rotate('+(Math.sin(t*1.4)*3+tilt)+'deg) scale('+mp2+')';mh.style.opacity=clamp((t-2.0)/0.3);}
  var sh=$('#swMascotShadow');if(sh){sh.style.opacity=clamp((t-2.0)/0.4)*(1-heroFade)*(0.9-bob*0.02);sh.style.transform='scaleX('+(1-bob*0.006)+')';}
  var arr=$('#swHeroMeta .sw-btnPrimary span');if(arr) arr.style.transform='translateX('+Math.max(0,Math.sin(t*2.4))*4+'px)';
  /* bubble */
  var bb=spring(clamp((t-2.9)/1.1));
  var bub=$('#swBubble');if(bub){bub.style.transform='scale('+bb+')';bub.style.opacity=clamp((t-2.9)/0.25);}
  /* scroll hint */
  var sHint=$('#swScrollHint');if(sHint){sHint.style.opacity=clamp((t-2.4)/0.6)*(1-heroFade*2);
    var shl=sHint.querySelector('.sw-line i');if(shl) shl.style.top=((t*0.7)%1.6-0.6)*100+'%';}

  /* ========= MARQUEES ========= */
  var sk=clamp(velo*0.55,-16,16);
  if(mq1El) mq1El.style.transform='translateX('+(-((t*70)%G.mq1W))+'px) skewX('+sk+'deg)';
  if(mq3El) mq3El.style.transform='translateX('+(-((t*40)%G.mq3W))+'px)';

  /* ========= STATEMENT ========= */
  var stP=clamp((y-G.stmtTop)/(G.stmtH-vh));
  stmtWords.forEach(function(w,i){
    var p=clamp((stP*1.15-i/stmtWords.length)*stmtWords.length/4);
    w.style.opacity=lerp(0.13,1,p);
  });

  /* ========= STORY ========= */
  revLines('#swStory',y,vh);
  var storyP=clamp((y+vh-G.storyTop)/(vh+G.storyH));
  var rules=$('#swStory .sw-rules');if(rules) rules.style.transform='translateY('+(storyP-0.5)*-40+'px)';

  /* ========= FOUNDERS ========= */
  revLines('#swTeam',y,vh);
  $$('.sw-fcard').forEach(function(c,i){
    var rt=G.frows[i];if(!rt)return;
    var base=clamp((y+vh*0.82-rt)/560);
    var p=eoCubic(base);
    var ti=(i%2?0.8:-0.8)*p;
    c.style.opacity=clamp(base*1.6);c.style.transform='translateY('+(1-p)*52+'px) rotate('+ti+'deg)';
    var ph=c.querySelector('.sw-fph');
    if(ph) ph.style.clipPath='inset('+(1-eoCubic(clamp(base*1.15)))*100+'% 0 0 0)';
    var phImg=c.querySelector('.sw-fph>img');
    if(phImg) phImg.style.transform='scale('+lerp(1.12,1,eoCubic(clamp(base*1.15)))+')';
    var ghost=c.querySelector('.sw-fghost');if(ghost) ghost.style.opacity=eoCubic(clamp(base));
    var rule=c.querySelector('.sw-frule');if(rule) rule.style.transform='scaleX('+eoCubic(clamp(base-0.28))+')';
    var textEls=c.querySelectorAll('.sw-fname,.sw-frole,.sw-fbio');
    for(var j=0;j<textEls.length;j++){
      var q=eoCubic(clamp(base-0.14-j*0.10));
      textEls[j].style.opacity=q;textEls[j].style.transform='translateY('+(1-q)*20+'px)';
    }
  });

  /* ========= STATS ========= */
  var staP=eoExpo(clamp((y+vh*0.72-G.statsTop)/(vh*0.55)));
  $$('.sw-stat .sw-num').forEach(function(n){
    var target=+n.dataset.count;
    if(n.dataset.plain) n.textContent=Math.round(lerp(1999,target,staP));
    else n.textContent=Math.round(target*staP)+(n.dataset.suffix||'');
  });
  $$('.sw-stat .sw-bar').forEach(function(b){b.style.transform='scaleX('+staP+')'});
  $$('.sw-stat .sw-lb').forEach(function(l){l.style.opacity=staP;l.style.transform='translateY('+(1-staP)*16+'px)'});
  var sk2=$('#swStats .sw-kick');if(sk2) sk2.style.opacity=clamp((y+vh*0.85-G.statsTop)/200);
  var sbig=$('#swStats .sw-big');if(sbig) sbig.style.transform='translateX(calc(-50% + '+(y-G.statsTop)*-0.06+'px))';

  /* ========= VALUES STACKING CARDS ========= */
  var valEnd = G.valuesTop + G.valuesH - vh;
  $$('.sw-vcard').forEach(function(el,i){
    var c=G.vcards[i];if(!c)return;
    var inner=el.querySelector('.sw-inner');if(!inner)return;
    var entering=clamp((y+vh-c.top)/vh);
    var next=G.vcards[i+1];
    var covered=0;
    if(next) covered=clamp((y-(next.top-vh))/vh);
    var maxPin=Math.max(0,valEnd - c.top);
    var pinTy=clamp(y-c.top,0,maxPin);
    inner.style.transform='translateY('+(pinTy+lerp(90,0,eoCubic(clamp(entering))))+'px) scale('+lerp(1,0.93,eioCubic(covered))+')';
    inner.style.opacity=1;
    var shade=inner.querySelector('.sw-shade');
    if(shade) shade.style.opacity=eioCubic(covered)*0.55;
  });

  /* ========= SVG CHARACTER ANIMATIONS ========= */
  var mg=document.getElementById('prMag');if(mg) mg.setAttribute('transform','rotate('+5*Math.sin(t*1.6)+' 96 96)');
  var pbk=document.getElementById('prBlink');if(pbk) pbk.setAttribute('opacity',0.3+0.7*Math.abs(Math.sin(t*2.2)));
  var pc1=document.getElementById('prChar1');if(pc1) pc1.setAttribute('transform','translate(0 '+1.5*Math.sin(t*1.3)+')');
  var shk=document.getElementById('ptShake');if(shk) shk.setAttribute('transform','translate(0 '+1.7*Math.sin(t*5.5)+')');
  var spk=document.getElementById('ptSpark');if(spk){var s=0.85+0.25*Math.sin(t*2.4);spk.setAttribute('transform','translate(110 52) scale('+s+') rotate('+9*Math.sin(t*1.1)+')');spk.setAttribute('opacity',0.75+0.25*Math.sin(t*2.4));}
  var pmc=document.getElementById('pmChar');if(pmc) pmc.setAttribute('transform','translate(0 '+1.5*Math.sin(t*1.2+1)+')');
  var pmcn=document.getElementById('pmCan');if(pmcn) pmcn.setAttribute('transform','rotate('+(-4-4*Math.sin(t*1.2))+' 108 112)');
  var pmt=document.getElementById('pmTree');if(pmt) pmt.setAttribute('transform','rotate('+2.2*Math.sin(t*0.9)+' 151 148)');
  for(var di=1;di<=3;di++){var wd=document.getElementById('wd'+di);if(wd){var q2=((t*0.85)+di*0.37)%1;wd.setAttribute('cy',104+38*q2);wd.setAttribute('opacity',Math.sin(Math.PI*clamp(q2)));}}

  /* ========= HOW ========= */
  var howP=clamp((y+vh*0.6-G.howTop)/(vh*0.8));
  var hl=$('#swHowLine i');if(hl) hl.style.width=eoCubic(howP)*100+'%';
  $$('.sw-hstep').forEach(function(s,i){
    var p=eoCubic(clamp(howP*2.2-i*0.45));
    s.style.opacity=p;s.style.transform='translateY('+(1-p)*40+'px)';
  });
  revLines('#swHow',y,vh);

  /* ========= CTA ========= */
  revLines('#swCta',y,vh);
  var ctaP=eoCubic(clamp((y+vh*0.55-G.ctaTop)/(vh*0.6)));
  var cs=$('#swCta .sw-sub');if(cs){cs.style.opacity=ctaP;cs.style.transform='translateY('+(1-ctaP)*26+'px)';}
  var bp2=spring(clamp((y+vh*0.45-G.ctaTop)/(vh*0.5)));
  var bl=$('.sw-btnLight');if(bl){bl.style.transform='scale('+bp2+')';bl.style.opacity=clamp((y+vh*0.5-G.ctaTop)/(vh*0.4));}
  var ml=$('#swCta .sw-mail');if(ml) ml.style.opacity=clamp((y+vh*0.35-G.ctaTop)/(vh*0.4));
  var mcp=spring(clamp((y+vh*0.75-G.ctaTop)/(vh*0.7)));
  var mcta=$('#swMascotCta');if(mcta){mcta.style.transform='translateY('+((1-mcp)*180+Math.sin(t*2.3)*6)+'px) rotate('+Math.sin(t*1.8)*4+'deg)';mcta.style.opacity=clamp((y+vh*0.75-G.ctaTop)/(vh*0.3));}
  $$('.sw-spark').forEach(function(s,i){
    var d=parseFloat(getComputedStyle(s).getPropertyValue('--d'))||i*1.3;
    s.style.transform='translateY('+Math.sin(t*1.25+d)*10+'px) rotate('+Math.sin(t*0.9+d)*20+'deg) scale('+(0.85+0.3*Math.sin(t*1.6+d))+')';
    s.style.opacity=(0.45+0.4*Math.sin(t*1.4+d))*ctaP;
  });
}

/* ---- line reveals ---- */
function revLines(secSel,y,vh){
  var sec=$(secSel);if(!sec)return;
  var top=getStaticTop(sec);
  var rls=sec.querySelectorAll('.sw-rl>span');
  for(var i=0;i<rls.length;i++){
    var p=eoExpo(clamp((y+vh*0.82-top-80)/380-i*0.14));
    rls[i].style.transform='translateY('+(1-p)*110+'%)';
  }
  var rlps=sec.querySelectorAll('.sw-rlP');
  for(var j=0;j<rlps.length;j++){
    var p2=eoCubic(clamp((y+vh*0.72-top-140)/300-j*0.16));
    rlps[j].style.opacity=p2;rlps[j].style.transform='translateY('+(1-p2)*28+'px)';
  }
}

/* ---- boot ---- */
var booted=false;
function boot(){
  if(booted)return;
  booted=true;
  measure();
  if(prefersReduced){render(8,getY());return;}
  render(0,0);
  var start=performance.now();
  var loop=function(now){
    var t=(now-start)/1000;
    var y=getY();
    render(t,y);
    requestAnimationFrame(loop);
  };
  requestAnimationFrame(loop);
  addEventListener('resize',function(){measure()});
}

if(document.readyState==='complete'||document.readyState==='interactive'){
  boot();
}else{
  addEventListener('DOMContentLoaded',boot);
}

if(document.fonts && document.fonts.ready){
  document.fonts.ready.then(function(){
    measure();
  });
}
window.addEventListener('load',function(){
  measure();
});
})();
</script>

</Layout>
