                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight font-sans">Request A Quote</h3>
                <p class="text-xs sm:text-sm text-stone-500 mt-0.5">
                  Architecture roadmap &amp; sprint estimate in 24 hours
                </p>
              </div>
              <div class="w-9 h-9 rounded-full bg-amber-50 flex items-center justify-center text-amber-500 shadow-2xs flex-shrink-0">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" />
                </svg>
              </div>
            </div>

            <form class="space-y-3.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
              <!-- Honeypot anti-spam trap (invisible to humans and screen-readers) -->
              <div class="hidden" aria-hidden="true" style="display:none !important;">
                <input type="text" name="_gotcha" id="about-gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
              </div>
              <div>
                <label class="sr-only" for="about-name">
                  Name*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="about-name"
                  name="name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="about-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="about-phone"
                  name="phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="about-email">
                  Email*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="about-email"
                  name="email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="about-msg">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="about-msg"
                  name="message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="3"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="px-3.5 py-2.5 bg-[#FAF9F6] border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600">
                <span class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span class="font-medium">100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-900">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <div class="pt-1">
                <button type="submit" class="btn-salow-submit">
                  <span class="btn-salow-logo-mark">
                    <Image
                      src={salowtechLogo}
                      width={24}
                      height={24}
                      alt="Salowtech"
                      loading="lazy"
                      decoding="async"
                      format="webp"
                      quality={90}
                    />
                  </span>
                  <span class="btn-salow-text">SUBMIT REQUEST</span>
                  <span class="btn-salow-arrow">&rarr;</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 8. CTA SECTION ================= -->
