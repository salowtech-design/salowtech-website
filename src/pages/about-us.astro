---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import teamHeroImg from "../assets/salowtech_team_hero.jpg";
import cs1 from "../assets/about/culture-slider-1.png";
import cs2 from "../assets/about/culture-slider-2.png";
import cs3 from "../assets/about/culture-slider-3.png";
import cs4 from "../assets/about/culture-slider-4.png";
import cs5 from "../assets/about/culture-slider-5.png";
import cs6 from "../assets/about/culture-slider-6.png";
import cs7 from "../assets/about/culture-slider-7.png";
import cs8 from "../assets/about/culture-slider-8.png";
import cs9 from "../assets/about/culture-slider-9.png";
import cs10 from "../assets/about/culture-slider-10.png";
import cs11 from "../assets/about/culture-slider-11.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import Breadcrumb from "../components/Breadcrumb.astro";
import { pagesSEO } from "../data/seo";
import { getAboutSchema } from "../data/schema";

const seo = pagesSEO.aboutUs;
const title = seo.title;
const description = seo.description;
const keywords =
  "about Salowtech, sovereign software engineering, IT consulting firm India, enterprise software architects, software engineering studio Surat Bangalore, custom software developers India";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "selection:bg-neutral-900 selection:text-white min-h-screen";
const showChatbot = true;
const schemaJson = getAboutSchema();
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- ================= MAIN CONTENT ================= -->
  <Breadcrumb currentPage="About Us" />
  <main class="relative w-full pt-20">
    <!-- ================= 1. HERO SECTION (hello.html Specification) ================= -->
    <section class="max-w-6xl mx-auto px-6 pt-24 pb-20 about-hero-enter">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end">
        <div class="lg:col-span-7">
          <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#7D3024] uppercase mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#7D3024] inline-block animate-pulse"></span>
            Salow Technologies
          </p>
          <h1 class="editorial-headline text-5xl sm:text-6xl md:text-7xl lg:text-[76px] text-neutral-950 font-normal mb-4">
            About Us
          </h1>
          <p class="text-xl sm:text-2xl text-stone-600 font-serif italic">
            Built by people who care about the details.
          </p>
        </div>
        <div class="lg:col-span-5 pb-2">
          <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed font-normal">
            We are a focused team of software engineers and system designers creating sovereign enterprise platforms
            that feel inevitable &mdash; simple on the surface, powerful underneath.
          </p>
        </div>
      </div>

      <!-- Founders Photo & Architecture Team (Refined & Elegantly Sized) -->
      <div class="mt-10 sm:mt-12 max-w-2xl sm:max-w-3xl mx-auto">
        <div class="rounded-2xl sm:rounded-3xl p-2 sm:p-2.5 bg-white border border-[#E8E1D3] shadow-sm overflow-hidden group">
          <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] rounded-xl sm:rounded-2xl overflow-hidden bg-[#FAF7F2]">
            <Image
              src={teamHeroImg}
              alt="Salowtech Core Architects & Founders"
              class="w-full h-[320px] sm:h-[400px] lg:h-[480px] object-cover rounded-3xl border border-stone-200/80 shadow-[0_20px_50px_-15px_rgba(43,35,26,0.14)]"
              width={1200}
              height={480}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              format="webp"
              quality={92}
            />
          </div>
        </div>

        <!-- Core Architects Typography (No box, elegant font) -->
        <div class="mt-4 text-center">
          <p class="text-xs sm:text-sm uppercase tracking-[0.22em] font-semibold text-[#7D3024] font-sans">
            Core Architects
          </p>
          <p class="text-base sm:text-lg font-serif italic text-neutral-700 mt-1">
            Founders of Salowtech &mdash; Sovereign Software Engineering
          </p>
        </div>
      </div>
    </section>

    <!-- Subtle Hairline Divider -->
    <div class="max-w-6xl mx-auto px-6">
      <div class="h-px bg-stone-300/60"></div>
    </div>

    <!-- ================= 2. WHAT DRIVES US (hello.html Specification) ================= -->
    <section class="max-w-6xl mx-auto px-6 py-24 sm:py-28 animate-on-scroll">
      <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#7D3024] uppercase mb-14">What drives us</p>

      <div class="grid md:grid-cols-3 gap-10 lg:gap-14">
        <div class="soft-card rounded-3xl p-8 sm:p-10 bg-white">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF3F1] border border-[#E8D2CF] flex items-center justify-center mb-6 text-[#7D3024] font-bold text-base">
            01
          </div>
          <h3 class="text-2xl font-bold mb-3.5 text-neutral-900 tracking-tight">Precision</h3>
          <p class="text-neutral-600 leading-relaxed text-base sm:text-lg font-normal">
            Every line of code and every interaction is intentional. We refuse to ship complexity for the sake of
            features. Architectural clarity is our permanent default.
          </p>
        </div>

        <div class="soft-card rounded-3xl p-8 sm:p-10 bg-white">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF3F1] border border-[#E8D2CF] flex items-center justify-center mb-6 text-[#7D3024] font-bold text-base">
            02
          </div>
          <h3 class="text-2xl font-bold mb-3.5 text-neutral-900 tracking-tight">Partnership</h3>
          <p class="text-neutral-600 leading-relaxed text-base sm:text-lg font-normal">
            We embed with your core leadership. Your operational goals become our roadmap. We measure engineering
            success only by the measurable enterprise outcomes we create together.
          </p>
        </div>

        <div class="soft-card rounded-3xl p-8 sm:p-10 bg-white">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF3F1] border border-[#E8D2CF] flex items-center justify-center mb-6 text-[#7D3024] font-bold text-base">
            03
          </div>
          <h3 class="text-2xl font-bold mb-3.5 text-neutral-900 tracking-tight">Permanence</h3>
          <p class="text-neutral-600 leading-relaxed text-base sm:text-lg font-normal">
            We engineer systems meant to compound for decades &mdash; maintainable, scalable, and free from rented
            technical debt. Short-term vendor lock-in has zero place at Salowtech.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= 3. OUR STORY + METRICS (hello.html Specification) ================= -->
    <section class="max-w-6xl mx-auto px-6 py-12 animate-on-scroll">
      <div class="grid lg:grid-cols-12 gap-10 items-stretch">
        <!-- Story Card -->
        <div class="lg:col-span-7 soft-card rounded-3xl p-8 sm:p-12 bg-white flex flex-col justify-center">
          <h2 class="editorial-headline text-4xl sm:text-5xl mb-6 text-neutral-950 font-normal">Our Story</h2>
          <div class="space-y-5 text-neutral-600 leading-relaxed text-base sm:text-lg font-normal">
            <p>
              Most software is overcomplicated. Bloated interfaces, endless configuration screens, and subscription
              tools that create more manual work than they save. We saw this pattern repeat across Indian enterprises
              and decided to engineer differently.
            </p>
            <p>
              We started with an uncompromising belief: the best enterprise platforms feel obvious in hindsight. They
              remove operational friction instead of adding unnecessary features. They respect the operator's time and
              the engineer's craft in equal measure.
            </p>
            <p>
              Today, we partner with ambitious manufacturing plants, retail logistics, and high-growth enterprises to
              design software that compounds in value over years &mdash; not just quarters. Every client engagement is
              treated as a permanent sovereign partnership, never a disposable transaction.
            </p>
          </div>
        </div>

        <!-- Metrics Cards Stack -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-5">
          <div class="soft-card rounded-3xl p-8 bg-white flex-1 flex flex-col justify-center">
            <p class="text-4xl sm:text-5xl font-bold tracking-tight text-neutral-950 font-sans">2021</p>
            <p class="text-neutral-500 mt-1.5 text-base sm:text-lg font-medium">Founded in Surat, Gujarat</p>
          </div>
          <div class="soft-card rounded-3xl p-8 bg-white flex-1 flex flex-col justify-center">
            <p class="text-4xl sm:text-5xl font-bold tracking-tight text-[#7D3024] font-sans">40+</p>
            <p class="text-neutral-500 mt-1.5 text-base sm:text-lg font-medium">Senior Engineering Specialists</p>
          </div>
          <div class="soft-card rounded-3xl p-8 bg-white flex-1 flex flex-col justify-center">
            <p class="text-4xl sm:text-5xl font-bold tracking-tight text-neutral-950 font-sans">Zero VC</p>
            <p class="text-neutral-500 mt-1.5 text-base sm:text-lg font-medium">100% Bootstrapped &amp; Sovereign</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 4. HOW WE WORK (hello.html Specification) ================= -->
    <section class="max-w-6xl mx-auto px-6 py-24 sm:py-28 animate-on-scroll">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#7D3024] uppercase mb-4">How we work</p>
          <h2 class="editorial-headline text-4xl sm:text-5xl leading-tight text-neutral-950 font-normal">
            A calm, deliberate process designed for clarity.
          </h2>
          <p class="text-neutral-600 text-base sm:text-lg mt-5 leading-relaxed font-normal">
            We reject chaotic agency churn. We work directly with founders and CTOs with zero junior middle-managers.
          </p>
        </div>

        <div class="lg:col-span-7 space-y-8">
          <div class="soft-card rounded-3xl p-8 bg-white flex items-start gap-6">
            <div class="text-3xl sm:text-4xl font-serif text-[#7D3024] font-normal leading-none pt-1">01</div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-neutral-900 tracking-tight">Deep Discovery</h3>
              <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
                We start by mapping the actual physical workflow, edge cases, and compliance constraints. No hasty
                assumptions. No rushed, inaccurate estimates.
              </p>
            </div>
          </div>

          <div class="soft-card rounded-3xl p-8 bg-white flex items-start gap-6">
            <div class="text-3xl sm:text-4xl font-serif text-[#7D3024] font-normal leading-none pt-1">02</div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-neutral-900 tracking-tight">Focused Execution</h3>
              <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
                Dedicated senior squad. Daily automated staging builds. Complete transparency in Discord and GitHub. We
                ship production increments, not slide-deck theatre.
              </p>
            </div>
          </div>

          <div class="soft-card rounded-3xl p-8 bg-white flex items-start gap-6">
            <div class="text-3xl sm:text-4xl font-serif text-[#7D3024] font-normal leading-none pt-1">03</div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-neutral-900 tracking-tight">Long-term Ownership</h3>
              <p class="text-neutral-600 text-base sm:text-lg leading-relaxed">
                We stay accountable for the lifetime of your deployment. Comprehensive codemaps, on-premise
                infrastructure handover, and 24/7 SLA stewardship are included by design.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 5. CULTURE & VALUES INFINITE GALLERY ================= -->
    <section class="py-16 overflow-hidden bg-[#FAF7F2]" aria-label="Culture photo gallery">
      <div class="max-w-6xl mx-auto px-6 mb-10 text-center">
        <p class="text-xs sm:text-sm font-semibold tracking-widest text-[#7D3024] uppercase mb-3">Our Culture</p>
