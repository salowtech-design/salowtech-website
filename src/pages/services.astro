---
/**
 * Services Hub Page: Top-level parent directory for Salowtech core engineering verticals.
 * Establishes hierarchical parent-child structure for Google organic sitelinks.
 */
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { pagesSEO } from "../data/seo";
import { getServicesHubSchema } from "../data/schema";

const seo = pagesSEO.services;
const title = seo.title;
const description = seo.description;
const canonicalPath = seo.canonicalPath;
const schemaJson = getServicesHubSchema();

const servicesList = [
  {
    title: "Web Development",
    slug: "/web-development",
    tag: "High-Speed Web Platforms",
    badge: "Web Systems",
    summary:
      "Modern cloud web apps, custom SaaS portals, and scalable cloud architectures engineered for sub-second TTFB, zero layout shift, and resilient performance.",
    features: [
      "Sub-second cold-start performance",
      "Semantic HTML5 & WCAG 2.2 accessibility",
      "Custom SaaS architectures & REST/GraphQL APIs",
      "Multi-tenant database security & RBAC"
    ],
    ctaText: "Explore Web Development"
  },
  {
    title: "Mobile App Development",
    slug: "/mobile-app-development",
    tag: "iOS & Android",
    badge: "Mobile Apps",
    summary:
      "Native iOS, Android, and Flutter mobile applications built for fluid 120 FPS animations, offline-first SQLite sync, and mission-critical reliability.",
    features: [
      "Native Swift, Kotlin & Flutter codebases",
      "Offline-first synchronization & local storage",
      "Biometric authentication & secure keychain vaults",
      "Strict App Store & Google Play compliance SLAs"
    ],
    ctaText: "Explore Mobile App Development"
  },
  {
    title: "ERP Development",
    slug: "/erp-development",
    tag: "Supply Chain & Operations",
    badge: "Enterprise ERP",
    summary:
      "Sovereign cloud ERP systems integrating multi-warehouse inventory, double-entry financial accounting, and procurement without per-seat licensing fees.",
    features: [
      "Real-time multi-warehouse inventory telemetry",
      "Double-entry ledger with immutable audit trails",
      "Automated vendor procurement & PO workflows",
      "PostgreSQL row-level security & encrypted data vaults"
    ],
    ctaText: "Explore ERP Development"
  },
  {
    title: "CRM Development",
    slug: "/crm-development",
    tag: "Revenue & Sales Operations",
    badge: "Sales CRM",
    summary:
      "Tailored CRM software built for multi-channel sales pipelines, lead routing automation, real-time quotations, and WhatsApp Business API integration.",
    features: [
      "Omnichannel lead capture with auto-routing",
      "Interactive drag-and-drop deal stages",
      "Official WhatsApp Cloud API conversational sync",
      "Detailed conversion analytics & revenue forecasts"
    ],
    ctaText: "Explore CRM Development"
  },
  {
    title: "HRM & Payroll",
    slug: "/hrm-payroll",
    tag: "Workforce & Compliance",
    badge: "Workforce Platform",
    summary:
      "Automate biometric attendance, statutory tax deductions, leave approvals, and multi-tier salary disbursements with 100% data sovereignty.",
    features: [
      "Biometric hardware & geofenced check-in sync",
      "Automated Indian statutory tax & PF/ESI calculations",
      "Self-service employee portals for leave & slips",
      "Single-click batch payroll disbursement bank exports"
    ],
    ctaText: "Explore HRM & Payroll"
  },
  {
    title: "AI Voice Assistant",
    slug: "/ai-voice-assistant",
    tag: "Conversational Telephony",
    badge: "AI Telephony",
    summary:
      "Low-latency conversational voice bots and automated call assistants providing 24/7 customer support, inbound routing, and CRM timeline sync.",
    features: [
      "Sub-400ms end-to-end voice latency",
      "Natural Indian accent & multilingual recognition",
      "Asterisk/FreeSWITCH SIP trunk telephony integration",
      "Automated CRM call recording & transcript sync"
    ],
    ctaText: "Explore AI Voice Assistant"
  },
  {
    title: "SEO & Growth",
    slug: "/seo-and-growth",
    tag: "Search & Generative Optimization",
    badge: "Organic Search",
    summary:
      "Technical SEO, Core Web Vitals optimization, and structured search architecture engineered to dominate high-intent Google rankings and AI engine discovery.",
    features: [
      "Core Web Vitals green score optimization (LCP, INP, CLS)",
      "Deep Schema.org JSON-LD entity graph markup",
      "Generative Engine Optimization (GEO) for ChatGPT & Perplexity",
      "Authoritative technical content & internal linking models"
    ],
    ctaText: "Explore SEO & Growth"
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  activePath="/services"
  showChatbot={true}
  showPreFooterCTA={true}
  schemaJson={schemaJson}
>
  <Breadcrumb currentPage="Services" />

  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 sm:pt-40 pb-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF3F1] border border-[#E8D2CF] text-[#7D3024] text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-[#7D3024]"></span>
        <span>Sovereign Software Engineering</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif text-neutral-950 font-normal tracking-tight mb-5 leading-tight">
        Services
      </h1>
      <p class="text-stone-600 text-base sm:text-lg leading-relaxed">
        We engineer bespoke enterprise software platforms with 100% intellectual property ownership, zero recurring SaaS license taxes, and lifetime code maintainability.
      </p>
    </div>

    <!-- Services Grid (7 Core Capabilities) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {servicesList.map((svc, idx) => (
        <article
          class={`group bg-white rounded-3xl p-7 sm:p-8 border border-[#E8E1D3] shadow-[0_4px_20px_-4px_rgba(43,35,26,0.04)] hover:shadow-xl hover:border-[#7D3024]/40 transition-all duration-300 flex flex-col justify-between ${
            idx === 6 ? "md:col-span-2 lg:col-span-3 lg:max-w-xl lg:mx-auto" : ""
          }`}
        >
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="text-xs font-bold text-[#7D3024] uppercase tracking-wider bg-[#FAF3F1] px-3 py-1 rounded-full border border-[#E8D2CF]">
                {svc.badge}
              </span>
              <span class="text-xs text-stone-400 font-mono">0{idx + 1}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-neutral-950 group-hover:text-[#7D3024] transition-colors mb-3 leading-snug">
              <a href={svc.slug} class="focus:outline-none">
                {svc.title}
              </a>
            </h2>

            <p class="text-stone-600 text-sm leading-relaxed mb-6">
              {svc.summary}
            </p>

            <ul class="space-y-2.5 mb-6 border-t border-stone-100 pt-5">
              {svc.features.map((feat) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-stone-700">
                  <svg class="w-4 h-4 text-[#7D3024] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-stone-100 mt-auto">
            <a
              href={svc.slug}
              class="inline-flex items-center justify-between w-full text-sm font-semibold text-[#7D3024] group-hover:text-[#5C2017] transition-colors"
            >
              <span>{svc.ctaText}</span>
              <span class="group-hover:translate-x-1.5 transition-transform duration-200" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Sovereign Engineering Advantage -->
    <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D3]">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#7D3024] block mb-2">
          The Sovereign Advantage
        </span>
        <h3 class="text-2xl sm:text-3xl font-serif text-neutral-950 font-normal tracking-tight mb-4">
          Why Enterprises Choose Custom Engineering Over Off-the-Shelf SaaS
        </h3>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6">
          Commercial SaaS applications trap growing companies with escalating per-seat fees, vendor lock-in, and generic workflows. Salowtech builds sovereign platforms designed around your exact business logic where you own 100% of the code, database schema, and intellectual property.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/contact-us"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-neutral-950 hover:bg-neutral-800 text-white text-sm font-semibold tracking-tight transition-all shadow-sm"
          >
            <span>Consult an Engineering Lead</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/testimonials"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white hover:bg-[#F5EFEB] border border-[#E8E1D3] text-neutral-900 text-sm font-semibold tracking-tight transition-all"
          >
            <span>Read Client Feedback</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

