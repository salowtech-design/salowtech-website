---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import salowtechMascot3d from "../assets/salowtech_mascot_3d.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import ServiceVideoShowcase from "../components/ServiceVideoShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.seoAndGrowth;
const title = seo.title;
const description = seo.description;
const keywords =
  "enterprise SEO services India, technical SEO agency, B2B search engine optimization, programmatic SEO digital growth, Core Web Vitals optimization, organic lead generation agency Surat Bangalore";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "bg-cream-100 text-slate-800 antialiased selection:bg-maroon-800 selection:text-white";
const showChatbot = true;
const relatedData = getServiceRelatedData("seo-and-growth");
const schemaJson = getServiceSchema({
  serviceKey: "seo-and-growth",
  serviceName: seo.title,
  serviceType: "Search Engine Optimization",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "SEO & Growth"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <main>
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Services", url: "/services" },
        { name: "SEO & Growth" }
      ]}
    />

    <!-- BEGIN: HeroSection -->
    <section class="relative pt-28 sm:pt-36 pb-16 lg:pb-20 overflow-hidden bg-cream-50" data-purpose="hero-section">
      <div class="absolute inset-0 hero-pattern pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <!-- Hero Left Column: Narrative & Key Bullets -->
          <div class="lg:col-span-7 space-y-6">
            <!-- Main Title -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-[1.12] tracking-tight">
              SEO &amp; Growth
            </h1>
            <p class="text-xl sm:text-2xl font-bold text-slate-800 leading-snug mb-2">
              Dominate Search Rankings &amp; Accelerate{" "}
              <span class="italic font-serif text-maroon-800">Digital Growth</span>
            </p>

            <!-- 4 Concise Bullet Points -->
            <ul class="space-y-3.5 pt-2 text-slate-700">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-cream-200 text-maroon-800 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">Technical SEO &amp; Website Architecture Optimization</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-cream-200 text-maroon-800 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">High-Intent Keyword Strategy &amp; Content Authority</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-cream-200 text-maroon-800 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">AI-Powered Search Optimization (AEO, GEO &amp; LLMO)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-cream-200 text-maroon-800 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">Measurable Organic Conversions &amp; Revenue Scaling</span>
              </li>
            </ul>

            <!-- Dual Pill CTA Button -->
            <div class="pt-4 flex flex-wrap items-center gap-4">
              <div class="inline-flex rounded-full bg-maroon-800 p-1.5 shadow-md">
                <a
                  class="px-6 py-2.5 rounded-full text-white font-medium text-sm hover:bg-maroon-900 transition-colors flex items-center gap-2"
                  href="/contact-us"
                >
                  <i class="fa-regular fa-paper-plane text-xs"></i> Contact Us
                </a>
              </div>
            </div>
          </div>

          <!-- Hero Right Column: Request A Quote Card -->
          <div class="lg:col-span-5" id="contact">
            <div class="bg-white rounded-2xl shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] p-6 sm:p-7 relative">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                  <p class="text-[11px] text-stone-500 mt-0.5">SEO roadmap &amp; sprint estimate in 24 hours</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#7D3024]/20 p-0.5 flex items-center justify-center shadow-xs overflow-hidden shrink-0" title="Salowtech Mascot">
                  <Image src={salowtechMascot3d} alt="Salowtech Mascot" width={32} height={32} class="w-full h-full object-contain" loading="lazy" />
                </div>
              </div>
              <form class="space-y-2.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
                <div>
                  <label class="sr-only" for="lead_name">
                    Name*
                  </label>
                  <input
                    class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                    id="lead_name"
                    name="name"
                    placeholder="Name*"
                    required=""
                    type="text"
                  />
                </div>
                <div>
                  <label class="sr-only" for="lead_phone">
                    Phone No*
                  </label>
                  <input
                    class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                    id="lead_phone"
                    name="phone"
                    placeholder="Phone No*"
                    required=""
                    type="tel"
                  />
                </div>
                <div>
                  <label class="sr-only" for="lead_email">
                    Email*
                  </label>
                  <input
                    class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                    id="lead_email"
                    name="email"
                    placeholder="Email*"
                    required=""
                    type="email"
                  />
                </div>
                <div>
                  <label class="sr-only" for="lead_message">
                    Type Your Message*
                  </label>
                  <textarea
                    class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                    id="lead_message"
                    name="message"
                    placeholder="Type Your Message*"
                    required=""
                    rows="2"
                  ></textarea>
                </div>

                
        </div>
      </div>
    </section>
    <!-- END: HeroSection -->

    <!-- BEGIN: AuthorityValueSection -->
    <section class="py-16 bg-cream-100 border-y border-cream-200" data-purpose="value-proposition">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          From Search Clicks to{" "}
          <span class="text-maroon-800 underline decoration-cream-300 decoration-wavy underline-offset-8 italic font-serif">
            Get SEO Consultant
          </span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          At Salowtech, we help modern brands capture the top spot across search engines and AI platforms. Our
          data-driven SEO engineering combines deep technical auditing, content authority, and conversion optimization
          to turn search visibility into lasting business growth.
        </p>
        <div class="pt-2">
          <a
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-maroon-800 hover:bg-maroon-900 text-white font-semibold text-sm transition-all shadow-sm hover:shadow-md"
            href="/contact-us"
          >
            <span>Get SEO Consultation</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>
    </section>
    <!-- END: AuthorityValueSection -->

    <!-- BEGIN: StrategicTakeawaysSection -->
    <section class="py-20 bg-cream-50" data-purpose="key-takeaways" id="methodology">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Strategic Takeaways: How Salowtech Powers Search Dominance
          </h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Left Column: Content, Bullet points, Action Button -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-3xl font-extrabold text-maroon-800 italic font-serif">Key Takeaways</h3>
            <p class="text-slate-700 leading-relaxed">
              <strong class="font-bold text-maroon-800">SEO Services</strong> optimize your visibility across search
              engines and AI search platforms. We combine technical audits, high-intent keywords, and authority building
              to drive rankings and measurable business growth.
            </p>
            <h4 class="text-base font-bold text-slate-900 pt-2">What's included in our SEO services:</h4>
            <ul class="space-y-3.5 text-slate-700">
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">Technical SEO &amp; Website Optimization</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">Keyword Research &amp; Search Intent Strategy</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">On-Page SEO &amp; Content Optimization</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">Local SEO &amp; Google Business Profile Optimization</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">High-Quality Authority Link Building</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">AI SEO (AEO, GEO, LLMO &amp; HEO)</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-5 h-5 rounded-full bg-maroon-800/10 text-maroon-800 flex items-center justify-center shrink-0 text-xs">
                  <i class="fa-solid fa-check"></i>
                </span>
                <span class="font-medium text-slate-800">
                  Monthly Performance Reports &amp; Strategic Recommendations
                </span>
              </li>
            </ul>
          </div>
          <!-- Right Column: Visual Mockup -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl overflow-hidden border border-cream-300 shadow-warm-card bg-white flex items-center justify-center">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAsLhjnBsIVNVPy2B7nnzupcYVQbxpXJQCzhlBkQn8H50ZdBuAq7jReqVnM9u7oLsnf2rqUK_jAdbOgTZmu1uLL4CzjXUDsXcQO6ETOf1Cxp2f07CIhWLhK88_AY6PSGuwFsGncOzjLSAdGKdCX1g0zIzTF45DETCUG--dqj9pdCFuj4OQzx-O-TUZz7RGiHYC_sbrScfVNIUQ7yHlJ3GaPd8YSnOp6vWEKentZ33f7L5OviTEhD2eV-HiHPR_eVLKg"
                alt="SEO Strategy to Rank #1 on Google"
                class="w-full h-auto object-cover rounded-2xl transition-transform hover:scale-105 duration-300"
                width="600"
                height="380"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- END: StrategicTakeawaysSection -->

    <!-- BEGIN: CoreServicesGrid (Exact Reference Asymmetric Bento Grid) -->
    <section class="py-20 lg:py-24 bg-cream-50" data-purpose="core-services-grid" id="services">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header Matching Reference -->
        <div class="text-center max-w-3xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-950 tracking-tight mb-3">
            Growth that compounds
          </h2>
          <p class="text-stone-600 text-xs sm:text-sm tracking-wide flex items-center justify-center gap-2">
            <span>Technical excellence</span>
            <span class="text-[#7D3024]">✦</span>
            <span>content authority</span>
            <span class="text-[#7D3024]">✦</span>
            <span>continuous optimization</span>
          </p>
        </div>

        <!-- 5-Card Asymmetric Bento Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
          <!-- Left Column: Tall Card (Technical SEO Foundation) -->
          <div class="lg:col-span-5">
            <a href="/contact-us" class="seo-bento-tall-card block group">
              <!-- Geometric subtle watermark -->
              <svg class="seo-card-geo-watermark" viewBox="0 0 100 100" fill="none" aria-hidden="true">
                <circle cx="50" cy="50" r="45" stroke="#7D3024" stroke-width="1.5" stroke-dasharray="3 3" />
                <circle cx="50" cy="50" r="30" stroke="#7D3024" stroke-width="1" />
                <circle cx="50" cy="50" r="15" stroke="#7D3024" stroke-width="0.8" />
              </svg>

              <div>
                <div class="seo-squircle-icon bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024] mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-serif font-bold text-slate-950 mb-3 group-hover:text-[#7D3024] transition-colors relative inline-block">
                  Technical SEO Foundation
                  <span class="block h-0.5 w-12 bg-[#7D3024]/60 rounded-full mt-2"></span>
                </h3>
                <p class="text-stone-600 text-sm leading-relaxed mt-4">
                  Core Web Vitals, crawl efficiency, and a robust architecture foundation ensure visibility, speed, and
                  scalability.
                </p>
              </div>

              <div class="mt-auto pt-6 border-t border-cream-200/80 flex items-center justify-between text-xs font-semibold text-[#5C2017]">
                <span>Explore Technical Audit</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>
          </div>

          <!-- Right Column: Stacked Bento Cards -->
          <div class="lg:col-span-7 flex flex-col gap-6 justify-between">
            <!-- Top Wide Card: Content that ranks & converts -->
            <a href="/contact-us" class="seo-bento-card block group flex-1">
              <!-- Leaf decorative watermark -->
              <svg
                class="seo-card-leaf-watermark text-[#7D3024]"
                viewBox="0 0 100 100"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M50 0 C60 30 80 50 100 50 C70 60 50 80 50 100 C40 70 20 50 0 50 C30 40 50 20 50 0 Z" />
              </svg>

              <div class="flex items-start gap-4">
                <div class="seo-squircle-icon bg-[#F0FDF4] border border-[#CCFBF1] text-[#0F766E]">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-serif font-bold text-slate-950 mb-1 group-hover:text-[#0F766E] transition-colors">
                    Content that ranks &amp; converts
                  </h3>
                  <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                    Strategic, authoritative content that answers intent, builds trust, and drives measurable outcomes.
                  </p>
                </div>
              </div>
            </a>

            <!-- Middle Wide Card: Authority & Digital PR -->
            <a href="/contact-us" class="seo-bento-card block group flex-1">
              <div class="flex items-start gap-4">
                <div class="seo-squircle-icon bg-[#FDF6E8] border border-[#F3E5C7] text-[#D97706]">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-serif font-bold text-slate-950 mb-1 group-hover:text-[#D97706] transition-colors">
                    Authority &amp; Digital PR
                  </h3>
                  <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                    Earned backlinks, trusted domain signals, and strategic partnerships build authority and long-term
                    equity.
                  </p>
                </div>
              </div>
            </a>

            <!-- Bottom Row: 2 Split Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Card 4: Local & International SEO -->
              <a href="/contact-us" class="seo-bento-card block group">
                <div class="seo-squircle-icon bg-[#FDF1F0] border border-[#F3D5D3] text-[#7D3024] mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-base font-serif font-bold text-slate-950 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Local &amp; International SEO
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Localized relevance and global scalability—optimized for every market you serve.
                </p>
              </a>

              <!-- Card 5: Conversion & Iteration -->
              <a href="/contact-us" class="seo-bento-card block group">
                <div class="seo-squircle-icon bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024] mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <h3 class="text-base font-serif font-bold text-slate-950 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Conversion &amp; Iteration
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Data-informed experiments, UX refinement, and continuous iteration turn traffic into growth.
                </p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- END: CoreServicesGrid -->

    <!-- BEGIN: Superb Radial Orbit Transmission Hub (Exact Reference Match) -->
    <section class="transmission-orbit-section" id="ecosystem" aria-labelledby="transmission-title">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10">
        <span class="text-xs font-bold uppercase tracking-widest text-[#7D3024]">+ REAL-TIME SEARCH TRANSMISSION</span>
        <h2
          id="transmission-title"
          class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 tracking-tight mt-2 mb-3"
        >
          Programmatic Search &amp; <span class="font-editorial italic font-normal text-[#7D3024]">Growth Transmission Engine</span>
        </h2>
        <p class="text-stone-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          How high-velocity technical crawls, semantic entity schemas, and edge rendering pipelines drive unshakeable
          algorithmic dominance on Google.
        </p>
      </div>

      <div class="transmission-stage">
        <!-- Concentric Pulsing Wave Halos -->
        <div class="transmission-halo transmission-halo-1" aria-hidden="true"></div>
        <div class="transmission-halo transmission-halo-2" aria-hidden="true"></div>
        <div class="transmission-halo transmission-halo-3" aria-hidden="true"></div>

        <!-- Center Hub: Mascot in the middle surrounded by orbiting components -->
        <div class="orbit-center-hub orbit-mascot-hub group">
          <div class="mascot-stage">
            <Image
              src={mascotExplaining}
              alt="Salowtech Mascot - Sovereign Search Core"
              width={120}
              height={120}
              loading="lazy"
              decoding="async"
              class="mascot-img"
            />
          </div>
          <div class="hub-text text-center">
            <span class="hub-title">Salowtech</span>
            <span class="hub-badge">Sovereign Search Core</span>
          </div>
        </div>

