---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import ServiceVideoShowcase from "../components/ServiceVideoShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { siteConfig } from "../data/site";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.aiVoiceAssistant;
const title = seo.title;
const description = seo.description;
const keywords =
  "enterprise AI voice assistant development, conversational AI voice bots, custom LLM voice agents, real-time voice AI customer support, multilingual AI telephony voice agents, call center AI automation India";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "bg-cream-200 text-slate-800 font-sans antialiased selection:bg-maroon selection:text-white";
const showChatbot = true;
const relatedData = getServiceRelatedData("ai-voice-assistant");
const schemaJson = getServiceSchema({
  serviceKey: "ai-voice-assistant",
  serviceName: seo.title,
  serviceType: "Artificial Intelligence Development",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "AI Voice Assistant"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "AI Voice Assistant" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section class="relative pt-28 sm:pt-36 pb-16 lg:pt-36 lg:pb-24 overflow-hidden" data-purpose="hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left Column: Value Proposition & Bullet Points -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <span class="text-xs uppercase tracking-widest text-maroon font-bold mb-3 block">
            Conversational AI &amp; Voice Agents
          </span>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-tight leading-snug sm:leading-snug lg:leading-tight mb-4">
            AI Voice Assistant
          </h1>
          <p class="text-base sm:text-lg text-stone-600 font-medium mb-6">
            Automate Operations with{" "}
            <span class="font-serif italic font-bold text-maroon block sm:inline">24/7 Conversational Voice Agents</span>
          </p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Human-Like Inbound &amp; Outbound Telephone Voice Agents
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                24/7 Automated Appointment Booking &amp; Calendar Synchronization
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Multilingual Support (Hindi, English, Regional Dialects) with Zero Latency
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Seamless Two-Way Integration with CRM, ERP &amp; WhatsApp API
              </span>
            </li>
          </ul>
          <div class="flex items-center">
            <div class="inline-flex rounded-full p-1 bg-maroon text-white shadow-lg shadow-maroon/25">
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase hover:bg-maroon-dark transition-colors cursor-pointer"
                href="/contact-us"
              >
                Contact Us
              </a>
              <span class="flex items-center px-3 text-xs uppercase tracking-wider text-white/70 font-medium">OR</span>
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase bg-white/10 hover:bg-white/20 transition-colors"
                href={siteConfig.contact.phoneTel}
              >
                Call Now
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Card (Exact Reference Style) -->
        <div class="lg:col-span-5" id="lead-form">
          <div class="bg-white rounded-2xl shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] p-6 sm:p-7 relative">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">Voice AI roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#7D3024]/20 p-0.5 flex items-center justify-center shadow-xs overflow-hidden shrink-0" title="Salowtech Mascot">
                <img src="/assets/salowtech_mascot_3d.png" alt="Salowtech Mascot" class="w-full h-full object-contain" />
              </div>
            </div>
            <form class="space-y-2.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
              <div>
                <label class="sr-only" for="voice-name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="voice-name"
                  name="name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="voice-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="voice-phone"
                  name="phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="voice-email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="voice-email"
                  name="email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="voice-message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="voice-message"
                  name="message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">SUBMIT REQUEST</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: BrandPropositionSection -->
  <section class="py-14 sm:py-16 bg-cream-100 border-y border-cream-300" data-purpose="brand-proposition">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
        Zero Hold Times with <span class="font-serif italic font-bold text-maroon">Autonomous Voice Agents</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto mb-7">
        Never miss a lead or leave customer queries unanswered. Our neural voice agents speak naturally, resolve queries
        in real time, and route critical calls to human experts when needed.
      </p>
      <div>
        <a
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide text-white bg-maroon hover:bg-maroon-dark shadow-md hover:shadow-lg transition-all duration-200"
          href="/contact-us"
        >
          Get Free AI Voice Consultation <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <!-- END: BrandPropositionSection -->

  <!-- BEGIN: SmartVoiceSolutionsSection (Exact Reference Split Console Design) -->
  <section class="py-16 lg:py-24" data-purpose="smart-voice-solutions-grid" id="solutions">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left Column: Typography & 3 Feature Rows -->
        <div class="lg:col-span-6">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-950 tracking-tight leading-tight mb-4">
            Speak. It handles the rest.
          </h2>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-8">
            An AI voice assistant that understands context, takes action, and works inside your existing tools.
          </p>

          <!-- 3 Vertical Feature Rows -->
          <div class="space-y-1">
            <!-- Row 1 -->
            <div class="voice-feature-row">
              <div class="voice-icon-box">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Natural Conversation</h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Talk naturally. It understands nuance, tone, and keeps continuous context across deep workflows.
                </p>
              </div>
            </div>

            <!-- Row 2 -->
            <div class="voice-feature-row">
              <div class="voice-icon-box">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Instant Business Actions</h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  It turns conversation into action—creating tickets, scheduling meetings, logging transactions, and
                  updating CRM records.
                </p>
              </div>
            </div>

            <!-- Row 3 -->
            <div class="voice-feature-row">
              <div class="voice-icon-box">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Enterprise Security</h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Built for trust. Your data stays private, encrypted with AES-256, protected, and fully compliant.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Elevated Soft White Floating Console Card -->
        <div class="lg:col-span-6">
          <div class="voice-console-card max-w-md mx-auto">
            <!-- Pulsing Acoustic Orb with Animated Soundwaves -->
            <div class="voice-orb-stage" aria-hidden="true">
              <div class="voice-orb-glow"></div>
              <div class="voice-orb-core">
                <div class="voice-bars-wrap">
                  <span class="voice-bar"></span>
                  <span class="voice-bar"></span>
                  <span class="voice-bar"></span>
                  <span class="voice-bar"></span>
                  <span class="voice-bar"></span>
                  <span class="voice-bar"></span>
                </div>
              </div>
            </div>

            <!-- Listening Status Indicator -->
            <div class="text-center mb-6">
              <span class="text-sm font-semibold text-stone-700">Listening...</span>
              <span class="text-xs text-[#7D3024] font-sans tracking-widest ml-1" aria-hidden="true">
                ıllıllı
              </span>
            </div>

            <!-- Floating Action Toast Pills -->
            <div class="space-y-3">
              <div class="voice-action-pill">
                <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-xs font-bold text-slate-900">Ticket created</div>
                  <div class="text-[11px] text-stone-500 truncate">Order follow-up #1234 • Priority High</div>
                </div>
                <span class="text-[10px] font-sans font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  Done
                </span>
              </div>

              <div class="voice-action-pill">
                <div class="w-9 h-9 rounded-lg bg-amber-50 border border-amber-100 flex items-center justify-center text-[#D97706] shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-xs font-bold text-slate-900">Meeting scheduled</div>
                  <div class="text-[11px] text-stone-500 truncate">Tomorrow at 10:00 AM • Google Meet</div>
                </div>
                <span class="text-[10px] font-sans font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  Synced
                </span>
              </div>

              <div class="voice-action-pill">
                <div class="w-9 h-9 rounded-lg bg-teal-50 border border-teal-100 flex items-center justify-center text-[#0F766E] shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-xs font-bold text-slate-900">CRM Pipeline Synced</div>
                  <div class="text-[11px] text-stone-500 truncate">Opportunity moved to 'Qualified'</div>
                </div>
                <span class="text-[10px] font-sans font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  Live
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: SmartVoiceSolutionsSection -->

  <!-- BEGIN: Superb Radial Orbit Transmission Hub (Exact Reference Match) -->
  <section class="transmission-orbit-section" id="ecosystem" aria-labelledby="transmission-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-[#7D3024]">+ REAL-TIME VOICE TRANSMISSION</span>
      <h2
        id="transmission-title"
        class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-950 tracking-tight mt-2 mb-3"
      >
        Conversational Voice &amp; <span class="font-editorial italic font-normal text-[#7D3024]">AI Transmission Core</span>
      </h2>
      <p class="text-stone-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        How streaming speech recognition, fine-tuned domain LLMs, and natural neural voice synthesis stream over
        ultra-low-latency WebSockets in real time.
      </p>
    </div>

    <div class="transmission-stage">
      <!-- Concentric Pulsing Wave Halos -->
      <div class="transmission-halo transmission-halo-1" aria-hidden="true"></div>
      <div class="transmission-halo transmission-halo-2" aria-hidden="true"></div>
      <div class="transmission-halo transmission-halo-3" aria-hidden="true"></div>

      <!-- Center Hub: Mascot in the middle surrounded by orbiting components -->
      <div class="orbit-center-hub orbit-mascot-hub group">
        <div class="mascot-stage">
          <Image
            src={mascotExplaining}
            alt="Salowtech Mascot - Sovereign Voice Core"
            width={120}
            height={120}
            loading="lazy"
            decoding="async"
            class="mascot-img"
          />
        </div>
        <div class="hub-text text-center">
          <span class="hub-title">Salowtech</span>
          <span class="hub-badge">Sovereign Voice Core</span>
        </div>
      </div>

      <!-- 8 Orbiting Nodes with Real SVGs -->
      <div class="orbit-node node-pos-1">
        <span class="orbit-node-icon" style="background: #00A67E;">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="2">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
            <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
            <line x1="12" y1="19" x2="12" y2="23" />
            <line x1="8" y1="23" x2="16" y2="23" />
          </svg>
        </span>
        <span>Whisper Real-Time ASR</span>
      </div>
      <div class="orbit-node node-pos-2">
        <span class="orbit-node-icon" style="background: #5C2017;">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="#FFF" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
