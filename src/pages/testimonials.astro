---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import salowtechMascot3d from "../assets/salowtech_mascot_3d.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import Breadcrumb from "../components/Breadcrumb.astro";
import { pagesSEO } from "../data/seo";
import { getTestimonialsSchema } from "../data/schema";

const seo = pagesSEO.testimonials;
const title = seo.title;
const description = seo.description;
const keywords =
  "Salowtech client reviews, enterprise software case studies, custom ERP client testimonials, verified IT client feedback, software development success stories India";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "font-sans antialiased text-[#171513] selection:bg-[#F8EDE8] selection:text-[#7D3024]";
const showChatbot = true;
const schemaJson = getTestimonialsSchema();
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb currentPage="Testimonials" />

  <!-- ================= MAIN CONTENT ================= -->
  <main class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- 1. Blurred Background Layer (The Entire Page with All Testimonials & Sections Blurred) -->
    <div class="testimonials-page-backdrop absolute inset-0 z-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
    <!-- 01. EDITORIAL ACCELERATION HERO (INTERCOM PARTNER STYLE) -->
    <style>
      /* Hero typography harmonized with site-wide styles */
      .editorial-hero-title {
        font-family: "Instrument Serif", Georgia, serif;
        font-weight: 400;
        letter-spacing: -0.015em;
        line-height: 1.08;
      }

      .editorial-hero-subtext {
        line-height: 1.62;
      }

      /* Subtle gentle wave bobbing animation */
      @keyframes gentleFloat {
        0%,
        100% {
          transform: translateY(0px) rotate(0deg);
        }

        50% {
          transform: translateY(-7px) rotate(0.8deg);
        }
      }

      @keyframes parasailSway {
        0%,
        100% {
          transform: translate(0, 0) rotate(-1.5deg);
        }

        50% {
          transform: translate(4px, -10px) rotate(2deg);
        }
      }

      @keyframes waveSurge {
        0%,
        100% {
          transform: translateX(0);
        }

        50% {
          transform: translateX(-8px);
        }
      }

      .anim-parasail {
        transform-origin: 390px 420px;
        animation: parasailSway 4.8s ease-in-out infinite;
      }

      .anim-boat {
        animation: gentleFloat 3.2s ease-in-out infinite;
      }

      .anim-wave-front {
        animation: waveSurge 5s ease-in-out infinite;
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-parasail,
        .anim-boat,
        .anim-wave-front {
          animation: none !important;
        }
      }
    </style>

    <section class="relative overflow-hidden pt-6 sm:pt-10 pb-16 lg:pb-24 bg-[#FAF7F0]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <!-- LEFT COLUMN: Editorial Typography & Conversion Engine -->
          <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-center z-10">
            <!-- Eyebrow Pill / Category (Exact Intercom Style) -->
            <div class="inline-flex items-center gap-2 mb-5">
              <span class="text-[12px] sm:text-[13px] font-bold uppercase tracking-wider text-[#1F1B18] opacity-80">
                Enterprise Sovereign Partnership
              </span>
            </div>

            <!-- Main Punchy Headline (Matching site-wide font-editorial / Instrument Serif) -->
            <h1 class="font-editorial text-4xl sm:text-5xl lg:text-[60px] xl:text-[68px] font-normal text-neutral-950 leading-[1.08] tracking-tight mb-4">
              Testimonials
            </h1>
            <p class="font-editorial text-2xl sm:text-3xl lg:text-4xl font-normal text-stone-700 leading-snug mb-6">
              A partnership to accelerate <br class="hidden sm:inline" />
              <span class="italic text-[#7D3024]">your enterprise.</span>
            </p>

            <!-- High-converting 2-3 line subtext -->
            <p class="editorial-hero-subtext text-base sm:text-lg lg:text-[19px] text-[#5C524C] font-normal mb-8 max-w-xl">
              Software you own will always outrun SaaS you rent. Partner with Salowtech today to unlock custom
              multi-plant ERPs, high-converting platforms, and 24/7 AI systems with zero per-seat taxes.
            </p>

            <!-- Dual CTA Buttons with trailing arrow (Intercom style) -->
            <div class="flex flex-wrap items-center gap-3.5 mb-5">
              <!-- Primary Action Button: Solid Brand Maroon with Arrow -->
              <a
                href="#demo-consultation"
                class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#7D3024] hover:bg-[#581C15] text-[#FAF7F0] text-sm sm:text-base font-semibold tracking-tight transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5"
              >
                <span>Join as partner</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1 font-bold text-base">→</span>
              </a>

              <!-- Secondary Action Button: Clean Outline Button with Arrow -->
              <a
                href="#all-testimonials"
                class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-[#1F1B18] bg-transparent hover:bg-[#F8EDE8] text-[#1F1B18] hover:text-[#7D3024] hover:border-[#7D3024] text-sm sm:text-base font-semibold tracking-tight transition-all duration-200 hover:-translate-y-0.5 shadow-2xs"
              >
                <span>Explore client stories</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1 font-bold text-base">→</span>
              </a>
            </div>

            <!-- Footnote Link (Exact reference: "No app? Build one.") -->
            <div class="text-xs sm:text-[13px] text-[#5C524C]">
              <span>Existing partner? </span>
              <button
                type="button"
                onclick="openSubmitTestimonialModal()"
                class="text-[#1F1B18] font-semibold underline underline-offset-4 hover:text-[#7D3024] transition-colors cursor-pointer"
              >
                Submit your story.
              </button>
            </div>

            <!-- Quick Trust Micro-Badges -->
            <div class="mt-10 pt-6 border-t border-[#E8E3D7] flex flex-wrap items-center gap-6 sm:gap-8 text-xs text-[#5C524C]">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0F6848]"></span>
                <span class="font-medium text-[#1F1B18]">100% Source Code Ownership</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#7D3024]"></span>
                <span class="font-medium text-[#1F1B18]">Zero Per-Seat SaaS Taxes</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0F6848]"></span>
                <span class="font-medium text-[#1F1B18]">Live in 90 Days</span>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: High-Energy Illustration Crafted in Brand Palette -->
          <div class="lg:col-span-6 xl:col-span-6 relative flex items-center justify-center select-none">
            <!-- Ambient Backing Glow Tint -->
            <div class="absolute -inset-4 bg-gradient-to-tr from-[#F8EDE8] via-transparent to-[#F3EFE6] rounded-3xl opacity-70 filter blur-2xl -z-10"></div>

            <!-- Custom Vector Illustration mirroring the screenshot composition in Salowtech brand palette -->
            <svg
              class="w-full max-w-[560px] h-auto drop-shadow-xs"
              viewBox="0 0 680 580"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <!-- Gradients for subtle depth -->
                <linearGradient id="cloudGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#7D3024" stop-opacity="0.12" />
                  <stop offset="100%" stop-color="#7D3024" stop-opacity="0.05" />
                </linearGradient>
                <linearGradient id="canopyMaroonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#842D23" />
                  <stop offset="100%" stop-color="#581C15" />
                </linearGradient>
                <linearGradient id="waveFoamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#EFE9DE" />
                  <stop offset="100%" stop-color="#FAF7F0" />
                </linearGradient>
              </defs>

              <!-- 1. Background Clouds (Soft Brand Accents) -->
              <!-- Top-right cloud -->
              <g opacity="0.85">
                <path
                  d="M575 110 C575 95 590 85 605 85 C615 85 625 90 630 98 C636 93 646 94 651 100 C656 106 657 114 653 120 C655 122 656 125 656 128 C656 135 650 140 642 140 L578 140 C568 140 560 133 560 125 C560 117 567 110 575 110 Z"
                  fill="#0F6848"
                  fill-opacity="0.25"
                  stroke="#1F1B18"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </g>

              <!-- Middle cloud behind parachute -->
              <g opacity="0.95">
                <path
                  d="M370 210 C370 190 390 180 410 180 C422 180 435 186 442 195 C450 188 465 190 472 198 C480 206 480 218 475 228 C482 232 486 240 484 248 C482 258 472 264 460 264 L375 264 C360 264 348 253 348 240 C348 226 358 212 370 210 Z"
                  fill="#7D3024"
                  fill-opacity="0.15"
                  stroke="#1F1B18"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </g>

              <!-- Small ambient accent cloud -->
              <g opacity="0.7">
                <path
                  d="M190 160 C190 148 202 140 215 140 C223 140 232 144 237 151 C243 146 253 147 258 153 C262 160 261 168 257 174 L192 174 C184 174 178 168 178 160 C178 152 184 146 190 160 Z"
                  fill="#0F6848"
                  fill-opacity="0.18"
                  stroke="#1F1B18"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </g>

              <!-- 2. Ocean Waves (Sea of Enterprise Agility) -->
              <!-- Base Sea Mass with energetic waves -->
              <g class="anim-wave-front">
                <!-- Main Turquoise/Mint Sea Crest matching the reference energetic splash -->
                <path
                  d="M40 480 C70 410 110 395 145 425 C175 450 205 385 245 420 C280 450 325 390 370 430 C410 465 455 420 495 445 C535 470 575 420 615 450 C640 468 665 480 680 490 L680 570 L30 570 L30 510 Z"
                  fill="#42D3B8"
                  stroke="#1F1B18"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <!-- Deep wave accent shadow in brand cream/sage -->
                <path
                  d="M30 520 C90 510 130 535 180 515 C230 495 270 525 320 505 C370 485 420 515 470 495 C520 475 570 510 680 495 L680 570 L30 570 Z"
                  fill="#1EAA90"
                  opacity="0.3"
                />

                <!-- Stylized water crest spray curves -->
                <path
                  d="M95 420 C105 405 125 400 138 415"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  fill="none"
                />
                <path
                  d="M190 415 C202 395 225 395 238 412"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  fill="none"
                />
                <path
                  d="M290 422 C305 402 330 405 342 425"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  fill="none"
                />
                <path
                  d="M480 450 C495 430 515 432 528 448"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  fill="none"
                />
                <path
                  d="M570 445 C585 428 605 430 618 445"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  fill="none"
                />

                <!-- Water splashes / droplets -->
                <circle cx="85" cy="400" r="4.5" fill="#42D3B8" stroke="#1F1B18" stroke-width="2.2" />
                <circle cx="115" cy="380" r="3.5" fill="#42D3B8" stroke="#1F1B18" stroke-width="2" />
                <circle cx="270" cy="390" r="4" fill="#42D3B8" stroke="#1F1B18" stroke-width="2" />
                <circle cx="450" cy="415" r="3" fill="#42D3B8" stroke="#1F1B18" stroke-width="1.8" />
              </g>

              <!-- 3. High-Speed Powerboat (The Enterprise Engine) -->
              <g class="anim-boat">
                <!-- Boat Wake Foam -->
                <path
                  d="M465 520 C490 510 520 515 540 500"
                  stroke="#1F1B18"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="3 5"
                />
                <path
                  d="M450 535 C480 525 510 530 535 520"
                  stroke="#FAF7F0"
                  stroke-width="3.5"
                  stroke-linecap="round"
                />

                <!-- Boat Hull (Crisp White/Cream with Terracotta Stripe) -->
                <!-- Hull main body -->
                <path
                  d="M500 505 L590 415 L660 460 C660 460 625 500 560 520 L500 505 Z"
                  fill="#FFFFFF"
                  stroke="#1F1B18"
                  stroke-width="3"
                  stroke-linejoin="round"
                />
                <!-- Hull terracotta brand accent stripe -->
                <path d="M515 503 L595 425 L630 450 L560 514 Z" fill="#7D3024" stroke="#1F1B18" stroke-width="2" />
                <!-- Windshield -->
                <path
                  d="M575 428 L590 395 L615 412 L605 438 Z"
                  fill="#FAF7F0"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />
                <!-- Cockpit Interior -->
                <path d="M545 470 L580 435 L610 450 L575 485 Z" fill="#FAF3F1" stroke="#1F1B18" stroke-width="2" />

                <!-- Outboard Motor on Transom -->
                <rect x="495" y="475" width="22" height="36" rx="4" fill="#1F1B18" stroke="#1F1B18" stroke-width="2" />
                <path d="M506 480 L506 505" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />

                <!-- Boat Driver (Enterprise Leader at the Helm) -->
                <!-- Hat / Cap with feather -->
                <path
                  d="M540 380 C548 370 565 370 575 378 L588 382 C592 384 585 390 570 388 C555 388 545 388 540 380 Z"
                  fill="#FAF7F0"
                  stroke="#1F1B18"
                  stroke-width="2.4"
                  stroke-linejoin="round"
                />
                <!-- Head -->
                <circle cx="560" cy="390" r="11" fill="#FFFFFF" stroke="#1F1B18" stroke-width="2.5" />
                <!-- Ponytail / Hair blowing in wind -->
                <path
                  d="M548 390 C535 390 530 398 525 395"
                  stroke="#1F1B18"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  fill="none"
                />
                <!-- Smiling face profile -->
                <path
                  d="M567 390 C569 392 568 395 565 396"
                  stroke="#1F1B18"
                  stroke-width="2"
                  stroke-linecap="round"
                  fill="none"
                />
                <!-- Body / Shirt in Terracotta Maroon -->
                <path
                  d="M550 402 C558 402 575 408 580 425 L555 438 L540 415 Z"
                  fill="#7D3024"
                  stroke="#1F1B18"
                  stroke-width="2.5"
                  stroke-linejoin="round"
                />
                <!-- Arms holding steering wheel / waving forward -->
                <!-- Arm 1 forward -->
                <path
                  d="M565 410 L585 400 L600 385"
                  stroke="#1F1B18"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
                <!-- Open Hand waving forward -->
                <path
                  d="M600 385 L608 380 M600 385 L609 385 M600 385 L607 390"
                  stroke="#1F1B18"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />

                <!-- Tow Hitch Mast & Rope Mount -->
                <circle cx="515" cy="465" r="5" fill="#7D3024" stroke="#1F1B18" stroke-width="2.5" />
              </g>

              <!-- 4. High-Tension Tow Line linking Boat to Soaring Parasailer -->
              <g>
                <!-- Dynamic Taut Line from boat hitch (515, 465) to parasailer harness (390, 245) -->
                <line x1="515" y1="465" x2="390" y2="245" stroke="#1F1B18" stroke-width="2.8" stroke-linecap="round" />
                <!-- Speed motion tick lines around rope -->
                <line
                  x1="470"
                  y1="380"
                  x2="480"
                  y2="385"
                  stroke="#1F1B18"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  opacity="0.6"
                />
                <line
                  x1="435"
                  y1="320"
                  x2="445"
                  y2="325"
                  stroke="#1F1B18"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  opacity="0.6"
                />
              </g>

              <!-- 5. Soaring Parasailer & Giant Accelerating Canopy -->
              <g class="anim-parasail">
                <!-- Parasail Canopy Shroud Lines (Rigging connecting harness to canopy) -->
                <line x1="390" y1="200" x2="330" y2="160" stroke="#1F1B18" stroke-width="2" stroke-linecap="round" />
                <line x1="390" y1="200" x2="355" y2="163" stroke="#1F1B18" stroke-width="1.8" stroke-linecap="round" />
                <line x1="390" y1="200" x2="380" y2="164" stroke="#1F1B18" stroke-width="1.8" stroke-linecap="round" />
                <line x1="390" y1="200" x2="410" y2="164" stroke="#1F1B18" stroke-width="1.8" stroke-linecap="round" />
                <line x1="390" y1="200" x2="435" y2="163" stroke="#1F1B18" stroke-width="1.8" stroke-linecap="round" />
                <line x1="390" y1="200" x2="465" y2="160" stroke="#1F1B18" stroke-width="2" stroke-linecap="round" />

                <!-- THE PARACHUTE CANOPY (Iconic Striped Design styled in Salowtech Terracotta & Warm Tones) -->
                <!-- Canopy Outline Dome -->
                <!-- Slice 1: Leftmost outer rib (Cream) -->
                <path
                  d="M330 160 C320 135 325 105 345 80 C352 95 356 125 355 163 Z"
                  fill="#FAF7F0"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />
                <!-- Slice 2: Terracotta Brand Maroon Strip -->
                <path
                  d="M355 163 C356 125 352 95 345 80 C360 65 375 60 380 58 C382 85 382 120 380 164 Z"
                  fill="#7D3024"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />
                <!-- Slice 3: Warm Mustard / Amber Accent (Momentum) -->
                <path
                  d="M380 164 C382 120 382 85 380 58 C392 56 405 56 415 58 C414 85 412 120 410 164 Z"
                  fill="#E09F3E"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />
                <!-- Slice 4: Deep Maroon Stripe -->
                <path
                  d="M410 164 C412 120 414 85 415 58 C425 62 440 70 452 82 C444 98 438 128 435 163 Z"
                  fill="#581C15"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />
                <!-- Slice 5: Rightmost outer rib (Cream/White) -->
                <path
                  d="M435 163 C438 128 444 98 452 82 C468 102 475 130 465 160 Z"
                  fill="#FAF7F0"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />

                <!-- Canopy Vent Trim & Scalloped Bottom Edge -->
                <path
                  d="M330 160 Q342 165 355 163 Q367 166 380 164 Q395 166 410 164 Q422 166 435 163 Q450 165 465 160"
                  stroke="#1F1B18"
                  stroke-width="3"
                  fill="none"
                  stroke-linecap="round"
                />

                <!-- THE PARASAILER (Joyful, Agility, Reaching New Heights) -->
                <!-- Hair tied back / in wind -->
                <path d="M385 180 C382 168 398 165 400 178 C402 188 392 195 385 180 Z" fill="#1F1B18" />
                <path
                  d="M382 172 C375 168 370 170 365 167"
                  stroke="#1F1B18"
                  stroke-width="2.5"
                  stroke-linecap="round"
                />

                <!-- Head -->
                <circle cx="390" cy="186" r="9.5" fill="#FFFFFF" stroke="#1F1B18" stroke-width="2.4" />
                <!-- Smiling face -->
                <path
                  d="M386 186 Q390 190 394 186"
                  stroke="#1F1B18"
                  stroke-width="2"
                  stroke-linecap="round"
                  fill="none"
                />

                <!-- Torso / White Oversized Shirt (Intercom style) -->
                <path
                  d="M375 196 L405 196 L410 230 L370 230 Z"
                  fill="#FFFFFF"
                  stroke="#1F1B18"
                  stroke-width="2.8"
                  stroke-linejoin="round"
                />

                <!-- Left Arm outstretched catching the air -->
                <path
                  d="M375 200 L350 205 L335 195"
                  stroke="#1F1B18"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
                <path
                  d="M335 195 L330 190 M335 195 L328 195 M335 195 L330 200"
                  stroke="#1F1B18"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />

                <!-- Right Arm outstretched celebrating freedom -->
                <path
                  d="M405 200 L430 195 L445 180"
                  stroke="#1F1B18"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
                <path
                  d="M445 180 L448 174 M445 180 L452 178 M445 180 L450 185"
                  stroke="#1F1B18"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />

                <!-- Black / Dark Pants (Intercom style) -->
                <!-- Left Leg bent in dynamic pose -->
                <path
                  d="M375 230 L365 260 L350 270"
                  stroke="#1F1B18"
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <!-- Left shoe/foot pointing -->
                <ellipse cx="346" cy="273" rx="5" ry="3" fill="#1F1B18" />

                <!-- Right Leg trailing downward -->
                <path
                  d="M400 230 L405 265 L395 295"
                  stroke="#1F1B18"
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <!-- Right shoe/foot -->
                <ellipse cx="392" cy="298" rx="5" ry="3" fill="#1F1B18" />

                <!-- Wind / Speed lines around the parasailer -->
                <path
                  d="M325 175 C315 178 305 180 295 178"
                  stroke="#1F1B18"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-dasharray="2 4"
                />
                <path
                  d="M315 220 C305 224 290 225 280 222"
                  stroke="#1F1B18"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-dasharray="2 4"
                />
                <path
                  d="M455 160 C465 158 478 156 490 160"
                  stroke="#1F1B18"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-dasharray="2 4"
                />
              </g>

              <!-- Floating Brand Tag / Micro-Badge on Art -->
              <g transform="translate(180, 470)">
                <rect
                  x="0"
                  y="0"
                  width="168"
                  height="38"
                  rx="19"
                  fill="#FFFFFF"
                  stroke="#E8E3D7"
                  stroke-width="1.5"
                  filter="drop-shadow(0 4px 12px rgba(31,27,24,0.06))"
                />
                <circle cx="20" cy="19" r="6" fill="#0F6848" />
                <text
                  x="34"
                  y="23"
                  fill="#1F1B18"
                  font-size="12"
                  font-weight="700"
                  font-family="'Plus Jakarta Sans', sans-serif"
                >
                  Zero SaaS Rent · 100% Own
                </text>
              </g>
            </svg>
          </div>
        </div>
      </div>
