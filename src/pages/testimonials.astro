          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl border-2 border-stone-300 hover:border-[#7D3024] bg-white/90 hover:bg-[#FAF3F1] text-neutral-900 hover:text-[#7D3024] text-sm font-bold tracking-tight transition-all duration-200 shadow-xs hover:-translate-y-0.5"
        >
          <span>Get in Touch</span>
          <span class="font-bold text-base">&rarr;</span>
        </a>
      </div>
    </div>
  </main>

  <!-- ================= SUBMIT TESTIMONIAL MODAL ================= -->
  <div
    id="submit-testimonial-modal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 modal-backdrop bg-black/60"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-[#E8E3D7] relative shadow-2xl max-h-[90vh] overflow-y-auto" data-lenis-prevent>
      <div class="flex items-center justify-between mb-5 border-b border-[#EFEAE1] pb-4">
        <div>
          <span class="text-xs font-bold uppercase text-[#7D3024]">Client Contribution</span>
          <h3 id="modal-title" class="text-xl font-bold text-neutral-950 mt-0.5">
            Share Your Experience
          </h3>
        </div>
        <button
          type="button"
          onclick="closeSubmitTestimonialModal()"
          class="w-8 h-8 rounded-full bg-[#FAF7F0] flex items-center justify-center text-neutral-500 hover:text-black transition-colors"
          aria-label="Close modal"
        >
          ✕
        </button>
      </div>

      <form id="client-testimonial-form" onsubmit="handleClientTestimonialSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-client-name">
            Your Full Name &amp; Designation *
          </label>
          <input
            class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
            id="modal-client-name"
            placeholder="e.g. Anand Rathi, Head of Supply Chain"
            required
            type="text"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-company-name">
            Company / Organization *
          </label>
          <input
            class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
            id="modal-company-name"
            placeholder="e.g. Apex Industrial Solutions"
            required
            type="text"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-service">
              Service Deployed *
            </label>
            <select
              id="modal-service"
              class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
              required
            >
              <option value="ERP Solutions">ERP Solutions</option>
              <option value="CRM Development">CRM Development</option>
              <option value="Web Development">Web Development</option>
              <option value="Mobile App Development">Mobile App Development</option>
              <option value="AI &amp; Voice Assistant">AI &amp; Voice Assistant</option>
              <option value="HRM &amp; Payroll">HRM &amp; Payroll</option>
              <option value="SEO &amp; Growth">SEO &amp; Growth</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-rating">
              Overall Rating *
            </label>
            <select
              id="modal-rating"
              class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
              required
            >
              <option value="5">★★★★★ (5.0 / 5.0)</option>
              <option value="4.5">★★★★½ (4.5 / 5.0)</option>
              <option value="4">★★★★☆ (4.0 / 5.0)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-metric">
            Measurable Metric or Result Achieved *
          </label>
          <input
            class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
            id="modal-metric"
            placeholder="e.g. 64% reduction in paperwork; ₹1.2 Cr saved"
            required
            type="text"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-neutral-800 mb-1" for="modal-quote">
            Your Testimonial Quote *
          </label>
          <textarea
            class="w-full text-xs sm:text-sm rounded-xl border-[#E8E3D7] bg-[#FAF7F0] text-neutral-900 px-3 py-2.5 focus:border-[#7D3024] focus:ring-[#7D3024]"
            id="modal-quote"
            rows="4"
            placeholder="How has Salowtech benefited your operations, engineering, or team productivity?"
            required
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#EFEAE1]">
          <button
            type="button"
            onclick="closeSubmitTestimonialModal()"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-neutral-600 hover:text-black"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-6 py-2.5 rounded-xl bg-[#7D3024] hover:bg-[#581C15] text-white text-xs font-bold tracking-wide uppercase transition-all shadow-md"
          >
            Submit for Review
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= EXACT MAIN SITE FOOTER (Untouched / 100% Match) ================= -->
  <!-- BEGIN: Footer Section -->
</Layout>
