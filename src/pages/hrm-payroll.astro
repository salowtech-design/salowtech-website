---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import ServiceVideoShowcase from "../components/ServiceVideoShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { siteConfig } from "../data/site";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.hrmPayroll;
const title = seo.title;
const description = seo.description;
const keywords =
  "custom HRM software development India, statutory payroll software India PF ESIC TDS, biometric attendance management software, employee lifecycle HRMS platform, cloud HR and payroll management system Surat Bangalore";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "bg-cream-200 text-slate-800 font-sans antialiased selection:bg-maroon selection:text-white";
const showChatbot = true;
const relatedData = getServiceRelatedData("hrm-payroll");
const schemaJson = getServiceSchema({
  serviceKey: "hrm-payroll",
  serviceName: seo.title,
  serviceType: "Human Resource Management Software",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "HRM & Payroll"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "HRM & Payroll" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section class="relative pt-28 sm:pt-36 pb-16 lg:pt-36 lg:pb-24 overflow-hidden" data-purpose="hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left Column: Value Proposition & Bullet Points -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <span class="text-xs uppercase tracking-widest text-maroon font-bold mb-3 block">
            Human Resource Management &amp; Payroll Software
          </span>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-tight leading-snug sm:leading-snug lg:leading-tight mb-4">
            HRM &amp; Payroll
          </h1>
          <p class="text-base sm:text-lg text-stone-600 font-medium mb-4">
            Empower Your Workforce with{" "}
            <span class="font-serif italic font-bold text-maroon block sm:inline">Intelligent Attendance &amp; Payroll</span>
          </p>

          <!-- Direct Answer AEO Block (Machine & Answer Engine Optimization) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#FAF7F2] border border-[#E8E1D3] text-stone-700 text-xs sm:text-sm leading-relaxed mb-6 max-w-xl" data-purpose="aeo-direct-answer">
            <p class="font-semibold text-neutral-900 mb-1 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-maroon"></span>
              <span>Quick Overview:</span>
            </p>
            <p>
              Salowtech Custom HRM &amp; Payroll Software centralizes workforce management with biometric and geo-fenced attendance, automated statutory payroll calculation, leave workflows, and performance tracking. Built for growing companies needing compliant, error-free employee administration without recurring third-party seat costs.
            </p>
          </div>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Biometric Attendance, Geo-Fencing &amp; Shift Rostering
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                100% Automated Statutory Compliance (PF, ESIC, PT, TDS &amp; Form 16)
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Self-Service Portals for Leave, Claims, Payslips &amp; Tax Planning
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-maroon/10 text-maroon flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text-sm sm:text-base font-semibold text-slate-800">
                Seamless Integration with Bank Batch Disbursal &amp; ERP Ledgers
              </span>
            </li>
          </ul>
          <div class="flex items-center">
            <div class="inline-flex rounded-full p-1 bg-maroon text-white shadow-lg shadow-maroon/25">
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase hover:bg-maroon-dark transition-colors cursor-pointer"
                href="/contact-us"
              >
                Contact Us
              </a>
              <span class="flex items-center px-3 text-xs uppercase tracking-wider text-white/70 font-medium">OR</span>
              <a
                class="px-6 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide uppercase bg-white/10 hover:bg-white/20 transition-colors"
                href={siteConfig.contact.phoneTel}
              >
                Call Now
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Lead Capture Card (Exact Reference Style) -->
        <div class="lg:col-span-5" id="lead-form">
          <div class="bg-white rounded-2xl shadow-[0_12px_40px_-10px_rgba(43,35,26,0.08)] border border-[#E8E3D7] p-6 sm:p-7 relative">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-neutral-900 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">HRM roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <span class="w-7 h-7 rounded-full bg-[#FFF5EE] text-[#F37021] flex items-center justify-center font-bold text-xs border border-[#FFE0CC] shadow-xs">
                ⚡
              </span>
            </div>
            <form class="space-y-2.5" onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);">
              <div>
                <label class="sr-only" for="hrm-name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="hrm-name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="hrm-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="hrm-phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="hrm-email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="hrm-email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="hrm-message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="hrm-message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">SUBMIT REQUEST</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: BrandPropositionSection -->
  <section class="py-14 sm:py-16 bg-cream-100 border-y border-cream-300" data-purpose="brand-proposition">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug mb-4">
        Eliminate Payroll Errors and <span class="font-serif italic font-bold text-maroon">Retain Top Talent</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto mb-7">
        From applicant tracking to lifecycle offboarding, Salowtech HRM centralizes employee profiles, dynamic shift
        schedules, performance OKRs, and one-click compliant payroll calculations.
      </p>
      <div>
        <a
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide text-white bg-maroon hover:bg-maroon-dark shadow-md hover:shadow-lg transition-all duration-200"
          href="/contact-us"
        >
          Get Free HRM Consultation <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <!-- END: BrandPropositionSection -->

  <!-- BEGIN: SmartHrmSolutionsSection (Exact Reference Tiered Design) -->
  <section class="py-16 lg:py-24" data-purpose="smart-hrm-solutions-grid" id="solutions">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header Matching Reference -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-slate-950 tracking-tight mb-3">
          Everything you need to recruit, pay, and retain
        </h2>
        <p class="text-stone-600 text-sm sm:text-base">
          Compliant automation. Frictionless self-service. Built to scale your workforce.
        </p>
      </div>

      <!-- Tier 1: Workforce & Attendance Core -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">1</span>
          <span class="tier-title">Workforce &amp; Attendance Core</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 1 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Automated Time &amp; Attendance
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Direct integration with biometric fingerprint/face scanners, RFID badges, and geofenced mobile
                  punch-in with selfie validation.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 2 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF1F0] border border-[#F3D5D3] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Leave &amp; Holiday Management
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Multi-tiered leave approval workflows, compensatory off tracking, custom holiday calendars by
                  state/branch, and annual encashment rules.
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 2: Compliant Financial Disbursals -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">2</span>
          <span class="tier-title">Compliant Financial Disbursals</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Card 3 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#FDF6E8] border border-[#F3E5C7] text-[#D97706]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#D97706] transition-colors">
                  1-Click Statutory Payroll Engine
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Configurable salary structures with automatic deductions for Provident Fund (PF), ESIC, Professional
                  Tax, TDS slabs, and gratuity calculations.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 4 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#CCFBF1] text-[#0F766E]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-[#0F766E] transition-colors">
                  Direct Bank Disbursals
                </h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  Direct export of encrypted NACH and NEFT/RTGS batch transfer files formatted for major banking
                  institutions (HDFC, ICICI, SBI, Axis).
                </p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Tier 3: Talent & People Intelligence -->
      <div class="tier-group">
        <div class="tier-header">
          <span class="tier-num-pill">3</span>
          <span class="tier-title">Talent &amp; People Intelligence</span>
          <div class="tier-divider-line"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 5 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F5F2EB] border border-[#E2D7CD] text-[#5C2017]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#5C2017] transition-colors">
                  Employee Self-Service (ESS)
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Dedicated mobile and web portal allowing employees to view digitized payslips, submit reimbursement
                  bills, and declare tax investments.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 6 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#FAF4EE] border border-[#E8DCD1] text-[#7D3024]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#7D3024] transition-colors">
                  Applicant Tracking &amp; Onboarding
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Job portal pipeline management, resume parser, automated offer letter generation, digital signature
                  capture, and document verification.
                </p>
              </div>
            </div>
          </a>
          <!-- Card 7 -->
          <a href="/contact-us" class="tier-card block group">
            <div class="tier-card-content flex-col items-start gap-3">
              <div class="tier-icon-circle bg-[#F0FDF4] border border-[#DCFCE7] text-[#059669]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path
                    d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1 group-hover:text-[#059669] transition-colors">
                  Performance &amp; 360° Appraisals
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed">
                  Structured goal setting (OKRs &amp; KPIs), manager review cycles, continuous feedback, and transparent
                  promotion matrices.
                </p>
