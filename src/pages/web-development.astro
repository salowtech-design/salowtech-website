---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import mascotExplaining from "../assets/mascot_explaining.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import ServiceVideoShowcase from "../components/ServiceVideoShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedServicesAndGuides from "../components/RelatedServicesAndGuides.astro";
import { pagesSEO } from "../data/seo";
import { getServiceSchema } from "../data/schema";
import { getServiceRelatedData } from "../data/serviceGuides";

const seo = pagesSEO.webDevelopment;
const title = seo.title;
const description = seo.description;
const keywords =
  "custom web development services India, enterprise web application development, full-stack React Next.js development agency, custom corporate website development, headless web development company, fast loading secure web applications";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "font-sans antialiased text-[#2A2428] selection:bg-[#F8EDE8] selection:text-[#7D3024]";
const showChatbot = true;
const relatedData = getServiceRelatedData("web-development");
const schemaJson = getServiceSchema({
  serviceKey: "web-development",
  serviceName: seo.title,
  serviceType: "Web Application Development",
  description: seo.description,
  path: seo.canonicalPath,
  breadcrumbTitle: "Web Development"
});
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb
    items={[
      { name: "Home", url: "/" },
      { name: "Services", url: "/services" },
      { name: "Web Development" }
    ]}
  />

  <!-- BEGIN: HeroSection -->
  <section
    class="relative pt-20 sm:pt-24 pb-8 sm:pb-12 overflow-hidden hero-circuit-bg border-b border-cream-300/60"
    data-purpose="hero-section"
  >
    <!-- Decorative background glow -->
    <div class="absolute -top-32 right-1/4 w-96 h-96 bg-[#7D3024]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        <!-- Left Content Column (Compact & Minimal for 100vh Laptop Viewport Fit) -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <h1 class="font-display text-3xl sm:text-4xl lg:text-[40px] font-extrabold leading-[1.16] tracking-tight mb-3 text-neutral-950">
            Web Development
          </h1>
          <p class="font-display text-xl sm:text-2xl font-bold leading-snug tracking-tight mb-3 text-stone-700">
            Create a Website That <span class="text-[#7D3024]">Captures Attention</span>, Builds Trust &amp;{" "}
            <span class="text-[#7D3024]">Drives Action</span>
          </p>

          <!-- Concise Value Narrative -->
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6 max-w-xl">
            High-performance Next.js and React web applications engineered to capture attention, build enterprise trust,
            and accelerate conversions.
          </p>

          <!-- CTA Action -->
          <div class="flex flex-wrap items-center gap-3 mb-5" data-purpose="dual-cta-group">
            <a
              class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#7D3024] hover:bg-[#5C2017] text-white rounded-full font-semibold text-xs sm:text-sm transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 cursor-pointer"
              href="/contact-us"
            >
              <span>Get Free Consultation</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Floating Request A Quote Form (Compacted for screen fit) -->
        <div class="lg:col-span-5 relative" id="quote-card">
          <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-floating border border-cream-200 relative">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-cream-200">
              <div>
                <h2 class="text-lg font-bold font-display text-neutral-950 tracking-tight">Request A Quote</h2>
                <p class="text-[11px] text-stone-500 mt-0.5">Web roadmap &amp; sprint estimate in 24 hours</p>
              </div>
              <span
                class="w-7 h-7 rounded-full bg-[#7D3024]/10 text-[#7D3024] flex items-center justify-center font-bold text-xs"
                title="Instant Roadmap"
              >
                <svg
                  class="w-3.5 h-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              </span>
            </div>

            <form
              class="space-y-2.5"
              data-purpose="quote-form"
              onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);"
            >
              <div>
                <label class="sr-only" for="name">
                  Name*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] transition placeholder:text-stone-400 text-stone-800"
                  id="name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] transition placeholder:text-stone-400 text-stone-800"
                  id="phone"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="email">
                  Email*
                </label>
                <input
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] transition placeholder:text-stone-400 text-stone-800"
                  id="email"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="message">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-3.5 py-2 text-xs sm:text-sm bg-[#F8FAFC] border border-stone-200 rounded-lg focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] transition placeholder:text-stone-400 text-stone-800 resize-none"
                  id="message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="2"
                ></textarea>
              </div>
              <!-- Mock Trust Badge -->
              <div class="p-2.5 bg-[#F9F9F9] border border-stone-200 rounded-lg flex items-center justify-between text-[11px] text-stone-600">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span>100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-800">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <button class="btn-salow-submit" type="submit">
                <span class="btn-salow-logo-mark">
                  <Image
                    src={salowtechLogo}
                    width={24}
                    height={24}
                    alt="Salowtech"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    quality={90}
                  />
                </span>
                <span class="btn-salow-text">Submit Request</span>
                <span class="btn-salow-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- END: HeroSection -->

  <!-- BEGIN: ValuePropositionSection -->
  <section class="py-20 bg-cream-50 relative" data-purpose="value-proposition">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl md:text-[40px] font-bold leading-[1.2] mb-8 text-neutral-950">
        <span class="font-extrabold text-neutral-950">From Digital Ideas to </span>
        <span class="italic font-extrabold text-[#7D3024]">High-Impact Websites</span>
      </h2>
      <div class="space-y-6 text-stone-600 text-sm sm:text-base leading-relaxed text-center max-w-3xl mx-auto">
        <p>
          Today, your website is the cornerstone of your brand identity and the first touchpoint where visitors evaluate
          your credibility, expertise, and digital authority. At Salowtech, we craft high-performance, professional
          websites engineered to elevate your business presence, captivate your target audience, and turn visitors into
          loyal customers.
        </p>
        <p>
          From initial strategy and custom UI/UX design to robust development, lightning-fast speed, and search
          optimization, our dedicated team builds digital experiences focused entirely on accelerating your long-term
          business growth. Partner with Salowtech to build a scalable digital foundation that drives sustained
          inquiries, sales, and competitive success.
        </p>
      </div>
      <div class="mt-8">
        <a
          class="inline-flex items-center justify-center px-8 py-3.5 bg-[#7D3024] hover:bg-[#5C2017] text-white rounded-full font-semibold text-sm transition-all duration-200 shadow-md hover:shadow-lg"
          href="/contact-us"
        >
          Get Free Consultation
        </a>
      </div>
    </div>
  </section>
  <!-- END: ValuePropositionSection -->

  <!-- BEGIN: LaptopShowcaseSection (MacBook Pro Flagship SaaS Web Platform) -->
  <section
    class="py-16 sm:py-20 bg-[#FAF7F2] border-t border-cream-200 relative overflow-hidden"
    id="web-laptop-showcase"
    data-purpose="laptop-web-showcase"
  >
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#7D3024]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#7D3024]">+ LIVE ENTERPRISE SAAS PREVIEW</span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-[42px] font-extrabold text-neutral-950 leading-[1.2] tracking-tight mt-2 mb-3">
          Custom Web Platforms Engineered to{" "}
          <span class="italic font-extrabold text-[#7D3024]">Drive Real Revenue</span>
        </h2>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
          See how SalowTech builds high-converting enterprise SaaS, customer portals, and sovereign web applications
          with sub-second speeds and bank-grade reliability.
        </p>
      </div>

      <!-- MacBook Pro Hardware Mockup Frame (Solid & Stable) -->
      <div class="macbook-chassis mb-14">
        <!-- Screen Lid -->
        <div class="macbook-lid">
          <div class="macbook-notch"></div>
          <div class="macbook-screen">
            <!-- Browser Chrome Top Bar -->
            <div class="bg-[#FAF6F0] px-3 sm:px-4 py-2 sm:py-2.5 border-b border-[#E8DFC5] flex items-center justify-between text-xs select-none">
              <div class="flex items-center gap-1.5 sm:gap-2">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#7D3024] inline-block border border-[#7D3024]/40"
                  title="Close"
                ></span>
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#CEAB93] inline-block border border-[#BA9780]/40"
                  title="Minimize"
                ></span>
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#E3CAA5] inline-block border border-[#CEAB93]/40"
                  title="Expand"
                ></span>
              </div>
              <!-- Browser URL Pill -->
              <div class="flex items-center gap-2 bg-white text-neutral-800 px-3 sm:px-5 py-1 rounded-full text-[10px] sm:text-[11px] font-sans border border-[#E3CAA5]/80 shadow-2xs max-w-xs sm:max-w-md w-full justify-center">
                <svg class="w-3 h-3 text-[#7D3024] shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                </svg>
                <span class="truncate font-medium">https://cloud.salowtech.com/enterprise-dashboard</span>
              </div>
              <div class="hidden sm:flex items-center gap-2 text-stone-500 text-[10px] font-sans">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="font-medium text-emerald-700">99.99% Uptime SLA</span>
              </div>
            </div>

            <!-- Inside SaaS Web Application UI -->
            <div class="bg-[#FAF8F5] text-stone-900 grid grid-cols-12 min-h-[320px] sm:min-h-[420px]">
              <!-- Sidebar Rail -->
              <div class="hidden md:flex md:col-span-3 bg-white border-r border-cream-200 p-4 flex-col justify-between">
                <div class="space-y-4">
                  <!-- Brand Identity -->
                  <div class="flex items-center gap-2.5 px-2">
                    <div class="w-7 h-7 rounded-lg bg-[#7D3024] text-white font-bold text-xs flex items-center justify-center shadow-xs">
                      S
                    </div>
                    <span class="font-bold text-xs tracking-tight text-neutral-950">SalowTech Cloud</span>
                  </div>
                  <!-- Nav Links with Clean Bespoke SVGs (No Emojis) -->
                  <nav class="space-y-1">
                    <a
                      class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg bg-[#7D3024]/15 text-[#7D3024] font-bold text-xs"
                      href="#"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                      </svg>
                      <span>Dashboard</span>
                    </a>
                    <a
                      class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-stone-600 hover:bg-cream-100 text-xs font-medium transition"
                      href="#"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                      <span>Customer CRM</span>
                    </a>
                    <a
                      class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-stone-600 hover:bg-cream-100 text-xs font-medium transition"
                      href="#"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="2" y="5" width="20" height="14" rx="2" />
                        <line x1="2" y1="10" x2="22" y2="10" />
                      </svg>
                      <span>Billing &amp; Subscriptions</span>
                    </a>
                    <a
                      class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-stone-600 hover:bg-cream-100 text-xs font-medium transition"
                      href="#"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M13 2L3 14h8l-1 8 11-13h-8l1-7z" />
                      </svg>
                      <span>AI Automations</span>
                    </a>
                    <a
                      class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-stone-600 hover:bg-cream-100 text-xs font-medium transition"
                      href="#"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      </svg>
                      <span>Security &amp; SLA</span>
                    </a>
                  </nav>
                </div>
                <!-- Sidebar Footer Pill -->
                <div class="p-2.5 rounded-xl bg-cream-100 border border-cream-300 text-[10px] text-stone-600">
                  <div class="flex items-center justify-between font-bold text-neutral-800 mb-0.5">
                    <span>Sovereign Cloud</span>
                    <span class="text-emerald-600 font-bold">100% Owned</span>
                  </div>
                  <span>Zero Vendor Lock-In</span>
                </div>
              </div>

              <!-- Main Dashboard Area -->
              <div class="col-span-12 md:col-span-9 p-3 sm:p-6 space-y-3 sm:space-y-4">
                <!-- Top 3 Revenue & Performance Metrics Row -->
                <div class="grid grid-cols-3 gap-2 sm:gap-3">
                  <div class="p-2.5 sm:p-3.5 rounded-xl bg-white border border-cream-200 shadow-2xs">
                    <div class="text-[9px] sm:text-[10px] text-stone-500 font-medium leading-tight">
                      Monthly Recurring Revenue
                    </div>
                    <div class="text-xs sm:text-xl font-extrabold text-neutral-900 mt-0.5">$184,500</div>
                    <span class="inline-block mt-0.5 sm:mt-1 text-[8px] sm:text-[9px] font-bold px-1 sm:px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-600">
                      +31.4% Growth
                    </span>
                  </div>
                  <div class="p-2.5 sm:p-3.5 rounded-xl bg-white border border-cream-200 shadow-2xs">
                    <div class="text-[9px] sm:text-[10px] text-stone-500 font-medium leading-tight">
                      Active Enterprise Clients
                    </div>
                    <div class="text-xs sm:text-xl font-extrabold text-[#7D3024] mt-0.5">12,480</div>
                    <span class="inline-block mt-0.5 sm:mt-1 text-[8px] sm:text-[9px] font-bold px-1 sm:px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-600">
                      98.2% Retention
                    </span>
                  </div>
                  <div class="p-2.5 sm:p-3.5 rounded-xl bg-white border border-cream-200 shadow-2xs">
                    <div class="text-[9px] sm:text-[10px] text-stone-500 font-medium leading-tight">
                      Conversion Speed (LCP)
                    </div>
                    <div class="text-xs sm:text-xl font-extrabold text-neutral-900 mt-0.5">0.42 sec</div>
                    <span class="inline-block mt-0.5 sm:mt-1 text-[8px] sm:text-[9px] font-bold px-1 sm:px-1.5 py-0.5 rounded bg-[#FDF6E8] text-[#D97706]">
                      3.8x Industry Avg
                    </span>
                  </div>
                </div>

                <!-- Center Interactive Analytics Graph Card -->
                <div class="p-4 rounded-xl bg-white border border-cream-200 shadow-2xs">
                  <div class="flex items-center justify-between mb-2">
                    <div>
                      <div class="text-xs font-bold text-neutral-900">
                        Enterprise Revenue &amp; Subscription Trajectory
                      </div>
                      <div class="text-[10px] text-stone-500">Real-Time B2B Multi-Tenant Platform Performance</div>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span>Verified Live Stream</span>
                    </span>
                  </div>
                  <!-- Responsive SVG Area Chart -->
                  <div class="w-full h-32 sm:h-40">
                    <svg class="w-full h-full" viewBox="0 0 500 140" preserveAspectRatio="none">
                      <defs>
                        <linearGradient id="laptopChartGrad" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#7D3024" stop-opacity="0.35" />
                          <stop offset="100%" stop-color="#7D3024" stop-opacity="0.0" />
                        </linearGradient>
                      </defs>
                      <!-- Grid lines -->
                      <line x1="0" y1="35" x2="500" y2="35" stroke="#EAE4DA" stroke-dasharray="4 4" stroke-width="1" />
                      <line x1="0" y1="70" x2="500" y2="70" stroke="#EAE4DA" stroke-dasharray="4 4" stroke-width="1" />
                      <line
                        x1="0"
                        y1="105"
                        x2="500"
                        y2="105"
                        stroke="#EAE4DA"
                        stroke-dasharray="4 4"
                        stroke-width="1"
                      />
                      <!-- Filled Area -->
                      <path
                        d="M 0,115 C 50,110 80,95 120,75 C 160,55 200,85 240,60 C 280,35 320,65 370,40 C 420,15 460,30 500,10 L 500,140 L 0,140 Z"
                        fill="url(#laptopChartGrad)"
                      />
                      <!-- Stroke line -->
