---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { siteConfig } from "../data/site";
import { pagesSEO } from "../data/seo";
import { getContactSchema } from "../data/schema";

const seo = pagesSEO.contactUs;
const title = seo.title;
const description = seo.description;
const keywords =
  "contact Salowtech, hire software developers India, enterprise software consultation, request software project quote Surat Bangalore, custom software architects";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "selection:bg-neutral-900 selection:text-white min-h-screen bg-white";
const showChatbot = true;
const schemaJson = getContactSchema();
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <Breadcrumb currentPage="Contact Us" />

  <!-- BEGIN: Main Page Content -->
  <main class="cu cu-page" id="contact">
    <div class="cu-wrap">
      <h1 class="cu-title">Contact Us</h1>

      <!-- Top: 2 Columns (Support & Sales) -->
      <div class="cu-top">
        <div>
          <div class="cu-label">
            <svg viewBox="0 0 24 24">
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" />
            </svg>
            Support
          </div>
          <p class="big">Already working with us? Send your issue and our team will look into it.</p>
          <div class="cu-btns">
            <a class="cu-pill solid" href={`mailto:${siteConfig.contact.email}?subject=Support%20request`}>
              Get support
            </a>
          </div>
        </div>

        <div>
          <div class="cu-label">
            <svg viewBox="0 0 24 24">
              <path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M14 9h5a1 1 0 0 1 1 1v11M3 21h18M8 8h2M8 12h2M8 16h2" />
            </svg>
            Sales team
          </div>
          <p class="big">Discuss your website, app, CRM or AI chatbot idea and get a clear plan for your project.</p>
          <div class="cu-btns">
            <a class="cu-pill solid" href={`mailto:${siteConfig.contact.email}?subject=New%20project%20enquiry`}>
              Talk to sales
            </a>
            <a class="cu-pill ghost" href={siteConfig.contact.whatsapp.url} target="_blank" rel="noopener">
              Chat on WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom: 3 Columns (Email, Social, Booking) -->
      <div class="cu-bottom">
        <div>
          <div class="cu-label">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            Email us
          </div>
          <p>For general queries and partnerships, write to {siteConfig.contact.email}.</p>
          <a class="cu-pill ghost" href={`mailto:${siteConfig.contact.email}`}>
            Send email
          </a>
        </div>
        <div>
          <div class="cu-label">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <path d="M17.5 6.5h.01" />
            </svg>
            Follow us
          </div>
          <p>See our latest projects and updates on social media.</p>
          <a class="cu-pill ghost" href="https://instagram.com/salowtech" target="_blank" rel="noopener">
            Follow on Instagram
          </a>
        </div>
        <div>
          <div class="cu-label">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path d="M8 3v4M16 3v4M3 10h18" />
            </svg>
            Book a consultation
          </div>
          <p>Get a free one-to-one call to plan your website, app or marketing.</p>
          <a class="cu-pill ghost" href="/#lead-capture">
            Book a call
          </a>
        </div>
      </div>
    </div>
  </main>
  <!-- END: Main Page Content -->

  <!-- BEGIN: Footer Section -->
</Layout>
