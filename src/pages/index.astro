                /* TABS HEIGHT: every panel sits in the same grid cell, so the area is always as tall as the tallest
                   tab and the content below never moves. Inactive panels are invisible, not clickable and skipped by
                   screen readers. Webflow's fade-in on the new panel still works.
                   opacity: 0 on the inactive panel matters: the Explore buttons (am-nav-btn) have "transition: all 500ms",
                   which also animates visibility, so a button would stay visible for half a second after its tab closes.
                   A parent's opacity can't be undone by its children, so the old button disappears at once. */
                .am-personas-tabs-body {
                  display: grid;
                }
                .am-personas-tabs-body > .am-personas-tabs-content-wrapper {
                  display: block; /* overrides Webflow's display: none on inactive tabs */
                  grid-area: 1 / 1; /* all panels in the same cell */
