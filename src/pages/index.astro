              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/95 backdrop-blur-md shadow-2xl flex items-center justify-center text-neutral-950 group-hover:scale-110 group-hover:bg-white transition-all border border-white/90 mb-3">
                <svg
                  id="playIconSvg"
                  class="w-6 h-6 sm:w-8 sm:h-8 ml-1 text-neutral-900 fill-current"
                  viewBox="0 0 24 24"
                >
