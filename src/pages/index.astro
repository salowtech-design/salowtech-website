---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import sketchWeb from "../assets/personas/sketch_web.png";
import sketchMobile from "../assets/personas/sketch_mobile.png";
import sketchCrm from "../assets/personas/sketch_crm.png";
import sketchErp from "../assets/personas/sketch_erp.png";
import sketchAi from "../assets/personas/sketch_ai.png";
import mascot3d from "../assets/salowtech_mascot_3d.png";
import ctaIllustration from "../assets/cta_illustration_cream.png";
import salowtechLogo from "../assets/salowtech_logo.png";
import { siteConfig } from "../data/site";
import { pagesSEO } from "../data/seo";
import { getHomeSchema } from "../data/schema";

const seo = pagesSEO.home;
const title = seo.title;
const description = seo.description;
const keywords =
  "custom software development company India, enterprise ERP software development, custom CRM development, HRM payroll software India, native mobile app development, conversational AI voice assistant, enterprise software architecture, Surat, Bangalore";
const canonicalPath = seo.canonicalPath;
const ogTitle = seo.title;
const ogDescription = seo.description;
const bodyClass = "selection:bg-neutral-900 selection:text-white min-h-screen";
const showChatbot = true;
const schemaJson = getHomeSchema();
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  bodyClass={bodyClass}
  showChatbot={showChatbot}
  schemaJson={schemaJson}
>
  <!-- END: SiteHeader / Navigation -->

  <main id="spa-container" class="relative w-full">
    <section class="hero" id="hero">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/assets/clouds_hero_poster.jpg"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/assets/clouds_hero_clean.mp4" type="video/mp4" />
      </video>

      <div class="hero__content">
        <h1 class="sr-only">
          Salowtech — Custom Software, CRM, ERP and App Development
        </h1>
        <div class="hero__title hero-cycler-container" aria-live="polite">
          <!-- Cycle 1: Your growth, our engineering -->
          <div class="hero-cycle-slide is-active" data-cycle-slide="0">
            <span class="line">Your growth,</span>
            <span class="line">
              our <em>engineering.</em>
            </span>
          </div>
          <!-- Cycle 2: Your problem, our solution -->
          <div class="hero-cycle-slide" data-cycle-slide="1">
            <span class="line">Your problem,</span>
            <span class="line">
              our <em>solution.</em>
            </span>
          </div>
          <!-- Cycle 3: Built by real engineers — Salow Technologies with mascot -->
          <div class="hero-cycle-slide" data-cycle-slide="2">
            <span class="hero-line-lead">Built by real engineers &mdash;</span>
            <span class="hero-line-brand">
              <span>Salow Technologies</span>
              <Image
                src={mascot3d}
                alt="Salow Technologies 3D mascot avatar"
                class="hero-mascot-badge"
                width={56}
                height={56}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                format="webp"
                quality={92}
              />
            </span>
          </div>
        </div>
      </div>

      <div class="hero__curve" aria-hidden="true"></div>
    </section>

    <section class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-8" id="tech-stack">
      <div class="text-center mb-12">
        <h2 class="tech-stack-title font-editorial text-4xl sm:text-5xl lg:text-6xl text-neutral-950 font-normal mt-2">
          Built with world-class developer tools
        </h2>
      </div>

      <!-- 24 Tools Grid seamlessly integrated without outer boxed border -->
      <div class="w-full">
        <div class="grid grid-cols-6 gap-2 sm:gap-4 md:gap-6 lg:gap-8 justify-items-center items-start">
          <!-- 1. HTML -->
          <a
            href="https://www.google.com/search?q=what+is+the+use+of+HTML"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center group cursor-pointer no-underline text-inherit"
            title="What is the use of HTML"
