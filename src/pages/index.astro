            <form
              id="lead-intake-form"
              class="space-y-3.5"
              onsubmit="event.preventDefault(); handleQuoteFormSubmit(this);"
            >
              <!-- Honeypot anti-spam trap (invisible to humans and screen-readers) -->
              <div class="hidden" aria-hidden="true" style="display:none !important;">
                <input type="text" name="_gotcha" id="index-gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field empty" />
              </div>
              <div>
                <label class="sr-only" for="home-name">
                  Name*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="home-name"
                  name="name"
                  aria-label="Name"
                  placeholder="Name*"
                  required=""
                  type="text"
                />
              </div>
              <div>
                <label class="sr-only" for="home-phone">
                  Phone No*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="home-phone"
                  name="phone"
                  aria-label="Phone Number"
                  placeholder="Phone No*"
                  required=""
                  type="tel"
                />
              </div>
              <div>
                <label class="sr-only" for="home-email">
                  Email*
                </label>
                <input
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none"
                  id="home-email"
                  name="email"
                  aria-label="Email Address"
                  placeholder="Email*"
                  required=""
                  type="email"
                />
              </div>
              <div>
                <label class="sr-only" for="home-msg">
                  Type Your Message*
                </label>
                <textarea
                  class="w-full px-4 py-3 text-sm bg-[#F8FAFC] border border-stone-200 rounded-xl focus:ring-2 focus:ring-[#7D3024] focus:border-[#7D3024] focus:bg-white transition placeholder:text-stone-400 text-stone-800 outline-none resize-none"
                  id="home-msg"
                  name="message"
                  aria-label="Type Your Message"
                  placeholder="Type Your Message*"
                  required=""
                  rows="3"
                ></textarea>
              </div>

              <!-- Trust / NDA Badge -->
              <div class="px-3.5 py-2.5 bg-[#FAF9F6] border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600">
                <span class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-[#7D3024]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                  <span class="font-medium">100% Strict Mutual NDA Protected</span>
                </span>
                <span class="font-bold text-neutral-900">Verified</span>
              </div>
              <!-- Google reCAPTCHA v3 Protection Badge -->
              <div class="px-3.5 py-2.5 bg-white border border-stone-200 rounded-xl flex items-center justify-between text-xs text-stone-600 shadow-2xs">
                <span class="flex items-center gap-2 font-medium text-stone-700">
                  <svg
                    class="w-4 h-4 text-[#1a73e8]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                  <span>Protected by Google reCAPTCHA v3</span>
                </span>
                <span class="text-[11px] text-stone-400">
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Privacy
                  </a>
                  <span class="mx-1">&bull;</span>
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline hover:text-stone-600 transition-colors"
                  >
                    Terms
                  </a>
                </span>
              </div>

              <!-- Submit Button -->
              <div class="pt-1">
                <button type="submit" class="btn-salow-submit">
                  <span class="btn-salow-logo-mark">
                    <Image
                      src={salowtechLogo}
                      width={24}
                      height={24}
                      alt="Salowtech"
                      loading="lazy"
                      decoding="async"
                      format="webp"
                      quality={90}
                    />
                  </span>
                  <span class="btn-salow-text">SUBMIT REQUEST</span>
                  <span class="btn-salow-arrow">&rarr;</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="faq" id="faq-section" aria-labelledby="faq-title">
      <div class="head">
        <span class="eyebrow">+ FAQ</span>
        <h2 id="faq-title">
          Frequently Asked <em>Questions</em>
        </h2>
      </div>

      <div class="list">
        <div class="q open">
          <h3>
            <button type="button" id="b1" aria-expanded="true" aria-controls="p1">
              What services do you offer?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p1" role="region" aria-labelledby="faq-btn-1">
            <div>
              <p>Websites, mobile apps, CRM/HRM/ERM software, AI chatbots and Voice Assistants, all in one place.</p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="b2" aria-expanded="false" aria-controls="p2">
              What is the difference between CRM, HRM and ERM?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p2" role="region" aria-labelledby="faq-btn-2">
            <div>
              <p>
                CRM manages your customers, leads and sales. HRM manages your people: attendance, leave, payroll and
                hiring. ERM brings day-to-day operations like inventory, accounts and reports into one system. We can
                build them separately or connected.
              </p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="faq-btn-3" aria-expanded="false" aria-controls="p3">
              What will the AI and Voice Assistant do for my business?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p3" role="region" aria-labelledby="faq-btn-3">
            <div>
              <p>
                The AI chatbot answers customer questions on your website and WhatsApp 24/7, captures leads and books
                appointments. The Voice Assistant does the same on phone calls and hands over to your team whenever
                needed.
              </p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="faq-btn-4" aria-expanded="false" aria-controls="p4">
              How much time and cost will my project need?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p4" role="region" aria-labelledby="faq-btn-4">
            <div>
              <p>
                It depends on the features and size of your project. After a short discovery call we share a clear
                scope, timeline and fixed quote, so there are no surprise costs later.
              </p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="faq-btn-5" aria-expanded="false" aria-controls="p5">
              Will the mobile app work on both Android and iOS?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p5" role="region" aria-labelledby="faq-btn-5">
            <div>
              <p>
                Yes. We build one app that runs on both Android and iOS, so you manage a single product and can launch
                on both stores together.
              </p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="faq-btn-6" aria-expanded="false" aria-controls="p6">
              Is my data safe?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p6" role="region" aria-labelledby="faq-btn-6">
            <div>
              <p>
                Yes. Your data is encrypted, access is role-based so people only see what they should, and automatic
                backups run regularly.
              </p>
            </div>
          </div>
        </div>

        <div class="q">
          <h3>
            <button type="button" id="faq-btn-7" aria-expanded="false" aria-controls="p7">
              Do you provide support after launch?
              <i class="ic" aria-hidden="true"></i>
            </button>
          </h3>
          <div class="a" id="p7" role="region" aria-labelledby="faq-btn-7">
            <div>
              <p>
                Yes. We stay with you after launch with bug fixes, updates, team training and help whenever you want to
                add new features.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="foot">
        <p>Something else on your mind? Talk to the team that builds it.</p>
        <a class="cta" href="/contact-us">
          Talk to our team
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 7h10M8 3l4 4-4 4" />
          </svg>
        </a>
      </div>
    </section>

    <!-- CTA Section (replaces Testimonials) -->
    <section class="cta-wrap" id="cta-section">
      <div class="cta-card">
        <div class="cta-text">
          <h2>
            Choose SalowTech.
            <br />
            Accelerate business growth.
          </h2>
          <a href="/contact-us" class="cta-btn" aria-label="Start Your Journey with Salowtech">
            Start Your Journey &rarr;
          </a>
          <ul class="cta-points">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 12l5 5L20 6" />
              </svg>
              Custom AI solutions for your business
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 12l5 5L20 6" />
              </svg>
              Fast setup and delivery
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 12l5 5L20 6" />
              </svg>
              Dedicated support after launch
            </li>
          </ul>
        </div>

        <div class="cta-art" aria-hidden="true">
          <Image
            src={ctaIllustration}
            alt="Salowtech Growth Illustration"
            class="cta-img"
            width={967}
            height={1024}
            loading="lazy"
            decoding="async"
            format="webp"
            quality={90}
          />
        </div>
      </div>
    </section>
    <div id="testimonials" class="sr-only" aria-hidden="true"></div>
  </main>
  <!-- END: #spa-container -->

  <!-- BEGIN: Footer Section -->
  <script is:inline slot="scripts" src="/js/personas-desktop.min.js"></script>
</Layout>
