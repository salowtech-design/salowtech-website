                .am-personas-tabs-body > .am-personas-tabs-content-wrapper:not(.w--tab-active) {
                  opacity: 0 !important;
                  transition: none !important;
                }
                .am-personas-tabs-body > .am-personas-tabs-content-wrapper:not(.w--tab-active),
                .am-personas-tabs-body > .am-personas-tabs-content-wrapper:not(.w--tab-active) * {
