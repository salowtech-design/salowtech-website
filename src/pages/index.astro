            <div class="w-11 h-11 xs:w-12 xs:h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-white rounded-xl sm:rounded-2xl shadow-xs sm:shadow-md border border-neutral-100 flex items-center justify-center p-2 sm:p-3.5 lg:p-4 group-hover:scale-95 transition-transform">
              <img
                class="w-full h-full object-contain"
                src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg"
                alt="HTML"
                width="48"
                height="48"
                loading="eager"
                decoding="async"
