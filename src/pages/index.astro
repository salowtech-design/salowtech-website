                id="videoPlayLabel"
                class="text-xs sm:text-sm font-medium text-neutral-900 bg-white/90 px-3.5 py-1 rounded-full shadow-sm backdrop-blur-sm tracking-wide"
              >
                Watch System Overview
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Script to toggle overlay and play/pause video seamlessly -->
      <script is:inline>
        function startPromoVideo() {
          const video = document.getElementById('salowtechPromoVideo');
          const overlay = document.getElementById('videoPlayOverlay');
          if (video) {
            if (overlay) {
              overlay.style.opacity = '0';
              overlay.style.pointerEvents = 'none';
            }
            video.play().catch(function() {});
          }
        }

        document.addEventListener('DOMContentLoaded', function() {
          const video = document.getElementById('salowtechPromoVideo');
          const overlay = document.getElementById('videoPlayOverlay');
          if (video && overlay) {
            video.addEventListener('ended', function() {
              overlay.style.opacity = '1';
              overlay.style.pointerEvents = 'auto';
            });
            video.addEventListener('pause', function() {
              if (video.currentTime === 0 || video.ended) {
                overlay.style.opacity = '1';
                overlay.style.pointerEvents = 'auto';
              }
            });
          }
        });
      </script>
