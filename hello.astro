<script is:inline>
/* ============================================================
   Deterministic animation engine.
   Everything is a pure function of virtual time t (seconds)
   and scroll position y (pixels). Capture mode drives both.
   ============================================================ */
const CAPTURE = new URLSearchParams(location.search).has('capture');
const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
const lerp=(a,b,p)=>a+(b-a)*p;
const eoExpo=p=>p>=1?1:1-Math.pow(2,-10*p);
const eoCubic=p=>1-Math.pow(1-p,3);
const eioCubic=p=>p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2;
const eoBack=p=>{const c=1.70158,c3=c+1;return 1+c3*Math.pow(p-1,3)+c*Math.pow(p-1,2)};
const spring=p=>1-Math.cos(p*Math.PI*2.2)*Math.exp(-4.2*p);

const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];

/* ---- split hero headline into words ---- */
function splitWords(el){
  const walk=n=>{[...n.childNodes].forEach(c=>{
    if(c.nodeType===3){
      const frag=document.createDocumentFragment();
      c.textContent.split(/(\s+)/).forEach(part=>{
        if(!part)return;
        if(/^\s+$/.test(part)){frag.appendChild(document.createTextNode(' '));return}
        const w=document.createElement('span');w.className='w';
        const wi=document.createElement('span');wi.className='wi';wi.textContent=part;
        w.appendChild(wi);frag.appendChild(w);
      });
      n.replaceChild(frag,c);
    } else if(c.nodeType===1) walk(c);
  })};walk(el);
  return [...el.querySelectorAll('.wi')];
}
const heroWords=splitWords($('#h1'));

/* ---- split statement into words ---- */
function splitStmt(el){
  const walk=n=>{[...n.childNodes].forEach(c=>{
    if(c.nodeType===3){
      const frag=document.createDocumentFragment();
      c.textContent.split(/(\s+)/).forEach(part=>{
        if(!part)return;
        if(/^\s+$/.test(part)){frag.appendChild(document.createTextNode(' '));return}
        const s=document.createElement('span');s.className='sw';s.textContent=part;frag.appendChild(s);
      });n.replaceChild(frag,c);
    } else if(c.nodeType===1) walk(c);
  })};walk(el);
  return [...el.querySelectorAll('.sw')];
}
const stmtWords=splitStmt($('#stmtP'));

/* ---- split footer big word into letters ---- */
const bw=$('#bigWord');
bw.innerHTML=[...bw.textContent].map(ch=>`<span class="bw">${ch}</span>`).join('');
const bwLetters=$$('#bigWord .bw');

/* ---- marquees ---- */
const MQ1=['Web Development','Mobile Apps','CRM','ERP','HRM & Payroll','AI Voice','SEO & Growth'];
$('#mq1').innerHTML=Array(3).fill(MQ1.map(s=>`<span>${s}<i class="st">✦</i></span>`).join('')).join('');
const MQ3=['Let\'s build yours','Salowtech','Let\'s build yours','Salowtech'];
$('#mq3').innerHTML=Array(2).fill(MQ3.map(s=>`<span>${s}</span>`).join('')).join('');

/* ---- geometry (measured after layout) ---- */
let G=null;
function measure(){
  const q=s=>$(s).getBoundingClientRect().top + curY;
  G={
    vh:innerHeight,
    stmtTop:q('#stmtWrap'), stmtH:$('#stmtWrap').offsetHeight,
    storyTop:q('#story'), storyH:$('#story').offsetHeight,
    teamTop:q('#team'), teamH:$('#team').offsetHeight,
    foundersTop:q('#founders'), frowsH:$('#founders').offsetHeight,
    frows:$$('.fcard').map(c=>c.getBoundingClientRect().top+window.scrollY),
    statsTop:q('#stats'), statsH:$('#stats').offsetHeight,
    valuesTop:q('#valuesWrap'), valuesH:$('#valuesWrap').offsetHeight,
    vcards:$$('.vcard').map(el=>({top:el.getBoundingClientRect().top+curY,h:el.offsetHeight})),
    howTop:q('#how'), howH:$('#how').offsetHeight,
    ctaTop:q('#cta'), ctaH:$('#cta').offsetHeight,
    footerTop:q('#footer'), footerH:$('#footer').offsetHeight,
    pageH:$('#page').offsetHeight,
    mq1W:$('#mq1').scrollWidth/3, mq3W:$('#mq3').scrollWidth/2,
  };
  G.maxY=G.pageH-G.vh;
}
let curY=0;

/* ---- per-frame render ---- */
let lastY=0, velo=0;
function render(t,y){
  curY=y;
  velo=lerp(velo,(y-lastY),0.35); lastY=y;
  const vh=G.vh;

  /* page translate */
  $('#page').style.transform=`translate3d(0,${-y}px,0)`;

  /* nav bg fades in */
  $('#navBg').style.opacity=clamp(y/60);

  /* ============ HERO (time-based intro + scroll parallax) ============ */
  const heroP=clamp(y/vh);
  $('#eyebrow').style.opacity=eoCubic(clamp((t-0.15)/0.7));
  $('#eyebrow').style.transform=`translateY(${(1-eoCubic(clamp((t-0.15)/0.7)))*18}px)`;
  heroWords.forEach((w,i)=>{
    const p=clamp((t-0.35-i*0.085)/0.9), e=eoExpo(p);
    w.style.transform=`translateY(${(1-e)*112}%) rotate(${(1-e)*7}deg)`;
    w.style.opacity=p<=0?0:1;
  });
  const sp=eoCubic(clamp((t-1.35)/0.9));
  $('#heroSub').style.opacity=sp; $('#heroSub').style.transform=`translateY(${(1-sp)*26}px)`;
  const mp=eoCubic(clamp((t-1.6)/0.9));
  $('#heroMeta').style.opacity=mp; $('#heroMeta').style.transform=`translateY(${(1-mp)*26}px)`;
  /* hero content parallax drift up + fade as you scroll */
  const heroFade=clamp((heroP-0.15)/0.6);
  $('#h1').style.transform=`translateY(${-heroP*vh*0.22}px)`;
  $('#heroSub').style.opacity=sp*(1-heroFade);
  $('#heroMeta').style.opacity=mp*(1-heroFade);
  $('#eyebrow').style.opacity=eoCubic(clamp((t-0.15)/0.7))*(1-heroFade);
  /* watermark slow drift */
  $('#watermark').style.transform=`translate(calc(-50% + ${t*-14}px), calc(-50% + ${-heroP*vh*0.35}px))`;
  /* rotating badge */
  const bp=eoBack(clamp((t-1.8)/0.8));
  $('#badge').style.opacity=bp; $('#badge svg').style.transform=`rotate(${t*14}deg) scale(${bp})`;
  $('#badge .star').style.transform=`scale(${bp}) rotate(${-t*20}deg)`;
  /* mascot: spring in, idle bob, scroll tilt */
  const sw=eoCubic(clamp((t-1.75)/0.8));
  const swp=document.getElementById('swashPath'); if(swp) swp.setAttribute('stroke-dashoffset',100*(1-sw));
  const mp2=spring(clamp((t-2.0)/1.4));
  const bob=Math.sin(t*2.1)*9;
  const tilt=clamp(velo*0.25,-14,14);
  $('#mascotHero').style.transform=`translateY(${(1-mp2)*260+bob}px) rotate(${Math.sin(t*1.4)*3+tilt}deg) scale(${mp2})`;
  $('#mascotHero').style.opacity=clamp((t-2.0)/0.3);
  const sh=$('#mascotShadow'); sh.style.opacity=clamp((t-2.0)/0.4)*(1-heroFade)*(0.9-bob*0.02); sh.style.transform=`scaleX(${1-bob*0.006})`;
  const arr=$('#heroMeta .btnPrimary span'); if(arr) arr.style.transform=`translateX(${Math.max(0,Math.sin(t*2.4))*4}px)`;
  $('#progress').style.transform=`scaleX(${clamp(y/G.maxY)})`;
  /* bubble pop */
  const bb=spring(clamp((t-2.9)/1.1));
  $('#bubble').style.transform=`scale(${bb})`;
  $('#bubble').style.opacity=clamp((t-2.9)/0.25);
  /* scroll hint */
  $('#scrollHint').style.opacity=clamp((t-2.4)/0.6)*(1-heroFade*2);
  const shl=$('#scrollHint .line i'); if(shl) shl.style.top=`${((t*0.7)%1.6-0.6)*100}%`;

  /* ============ MARQUEES ============ */
  const sk=clamp(velo*0.55,-16,16);
  $('#mq1').style.transform=`translateX(${-((t*70)%G.mq1W)}px) skewX(${sk}deg)`;
  $('#mq3').style.transform=`translateX(${-((t*40)%G.mq3W)}px)`;

  /* ============ STATEMENT (pinned word-by-word) ============ */
  const stP=clamp((y-G.stmtTop)/(G.stmtH-vh));
  stmtWords.forEach((w,i)=>{
    const p=clamp((stP*1.15 - i/stmtWords.length)*stmtWords.length/4);
    w.style.opacity=lerp(0.13,1,p);
  });
  /* pin the statement section */
  pinSection('#stmtWrap','#stmt',vh);

  /* ============ STORY reveals ============ */
  revLines('#story',y,vh);
  const storyP=clamp((y+vh-G.storyTop)/(vh+G.storyH));
  $('#yrBadge').style.opacity=eoCubic(clamp((y+vh*0.6-G.storyTop)/300));
  $('#yrBadge').style.transform=`translateY(${(1-eoCubic(clamp((y+vh*0.6-G.storyTop)/300)))*30}px) rotate(${-3+eoCubic(clamp((y+vh*0.6-G.storyTop)/300))*3}deg)`;
  $('#story .rules').style.transform=`translateY(${(storyP-0.5)*-40}px)`;

  /* ============ TEAM ============ */
  revLines('#team',y,vh);
  const tc=$('#teamCard');
  if(tc){
    const tcP=clamp((y+vh-G.teamTop-vh*0.45)/(vh*0.7));
    const tcE=eoCubic(tcP);
    tc.style.transform=`scale(${lerp(0.9,1,tcE)}) translateY(${lerp(70,0,tcE)}px)`;
    tc.style.opacity=tcE;
    const tp=clamp((y+vh-G.teamTop)/(vh+G.teamH));
    const ti=$('#teamImg'); if(ti) ti.style.transform=`translateY(${lerp(-2,-13,tp)}%) scale(1.05)`;
  }
  $$('.fcard').forEach((c,i)=>{
    const rt=G.frows[i];
    const base=clamp((y+vh*0.82-rt)/560);
    const p=eoCubic(base);
    const tilt=(i%2?0.8:-0.8)*p;
    c.style.opacity=clamp(base*1.6); c.style.transform=`translateY(${(1-p)*52}px) rotate(${tilt}deg)`;
    const ph=c.querySelector('.fph');
    if(ph) ph.style.clipPath=`inset(${(1-eoCubic(clamp(base*1.15)))*100}% 0 0 0)`;
    const phImg=c.querySelector('.fph>img');
    if(phImg) phImg.style.transform=`scale(${lerp(1.12,1,eoCubic(clamp(base*1.15)))})`;
    const ghost=c.querySelector('.fghost'); if(ghost){ghost.style.opacity=eoCubic(clamp(base));}
    const rule=c.querySelector('.frule'); if(rule) rule.style.transform=`scaleX(${eoCubic(clamp(base-0.28))})`;
    c.querySelectorAll('.fname,.frole,.fbio').forEach((el,j)=>{
      const q=eoCubic(clamp(base-0.14-j*0.10));
      el.style.opacity=q; el.style.transform=`translateY(${(1-q)*20}px)`;
    });
  });

  /* ============ STATS counters ============ */
  const staP=eoExpo(clamp((y+vh*0.72-G.statsTop)/(vh*0.55)));
  $$('.stat .num').forEach(n=>{
    const target=+n.dataset.count;
    if(n.dataset.plain){n.textContent=Math.round(lerp(1999,target,staP));}
    else n.textContent=Math.round(target*staP)+(n.dataset.suffix||'');
  });
  $$('.stat .bar').forEach(b=>b.style.transform=`scaleX(${staP})`);
  $$('.stat .lb').forEach(l=>{l.style.opacity=staP;l.style.transform=`translateY(${(1-staP)*16}px)`});
  $('#stats .kick').style.opacity=clamp((y+vh*0.85-G.statsTop)/200);
  $('#stats .big').style.transform=`translateX(calc(-50% + ${(y-G.statsTop)*-0.06}px))`;

  /* ============ VALUES stacking cards ============ */
  $$('.vcard').forEach((el,i)=>{
    const c=G.vcards[i], inner=el.querySelector('.inner');
    /* each card pins when its top reaches viewport top; previous cards scale down */
    const entering=clamp((y+vh-c.top)/vh);              /* 0 below fold -> 1 fully in place */
    const next=G.vcards[i+1];
    let covered=0;
    if(next) covered=clamp((y-(next.top-vh))/vh);        /* next card covering this one */
    const pinTy=Math.max(0,y-c.top);                     /* counter-translate keeps it stuck */
    inner.style.transform=`translateY(${pinTy+lerp(90,0,eoCubic(clamp(entering)))}px) scale(${lerp(1,0.93,eioCubic(covered))})`;
    inner.style.opacity=1;                               /* card body stays fully opaque */
    inner.querySelector('.shade').style.opacity=eioCubic(covered)*0.55; /* opaque overlay dims it instead */
  });

  /* ============ VALUE CARD CHARACTER ILLUSTRATIONS (original hand-drawn line art, deterministic) ============ */
  const mg=document.getElementById('prMag');
  if(mg) mg.setAttribute('transform',`rotate(${5*Math.sin(t*1.6)} 96 96)`);
  const pbk=document.getElementById('prBlink');
  if(pbk) pbk.setAttribute('opacity',0.3+0.7*Math.abs(Math.sin(t*2.2)));
  const pc1=document.getElementById('prChar1');
  if(pc1) pc1.setAttribute('transform',`translate(0 ${1.5*Math.sin(t*1.3)})`);
  const shk=document.getElementById('ptShake');
  if(shk) shk.setAttribute('transform',`translate(0 ${1.7*Math.sin(t*5.5)})`);
  const spk=document.getElementById('ptSpark');
  if(spk){const s=0.85+0.25*Math.sin(t*2.4);
    spk.setAttribute('transform',`translate(110 52) scale(${s}) rotate(${9*Math.sin(t*1.1)})`);
    spk.setAttribute('opacity',0.75+0.25*Math.sin(t*2.4));}
  const pmc=document.getElementById('pmChar');
  if(pmc) pmc.setAttribute('transform',`translate(0 ${1.5*Math.sin(t*1.2+1)})`);
  const pmcn=document.getElementById('pmCan');
  if(pmcn) pmcn.setAttribute('transform',`rotate(${-4-4*Math.sin(t*1.2)} 108 112)`);
  const pmt=document.getElementById('pmTree');
  if(pmt) pmt.setAttribute('transform',`rotate(${2.2*Math.sin(t*0.9)} 151 148)`);
  for(let di=1;di<=3;di++){const wd=document.getElementById('wd'+di);
    if(wd){const q=((t*0.85)+di*0.37)%1;
      wd.setAttribute('cy',104+38*q); wd.setAttribute('opacity',Math.sin(Math.PI*clamp(q)));}}

  /* ============ HOW line + steps ============ */
  const howP=clamp((y+vh*0.6-G.howTop)/(vh*0.8));
  $('#howLine i').style.width=`${eoCubic(howP)*100}%`;
  $$('.hstep').forEach((s,i)=>{
    const p=eoCubic(clamp(howP*2.2-i*0.45));
    s.style.opacity=p; s.style.transform=`translateY(${(1-p)*40}px)`;
  });
  revLines('#how',y,vh);

  /* ============ CTA ============ */
  revLines('#cta',y,vh);
  const ctaP=eoCubic(clamp((y+vh*0.55-G.ctaTop)/(vh*0.6)));
  $('#cta .sub').style.opacity=ctaP; $('#cta .sub').style.transform=`translateY(${(1-ctaP)*26}px)`;
  const bp2=spring(clamp((y+vh*0.45-G.ctaTop)/(vh*0.5)));
  $('#cta .btnLight').style.transform=`scale(${bp2})`;
  $('#cta .btnLight').style.opacity=clamp((y+vh*0.5-G.ctaTop)/(vh*0.4));
  $('#cta .mail').style.opacity=clamp((y+vh*0.35-G.ctaTop)/(vh*0.4));
  const mcp=spring(clamp((y+vh*0.75-G.ctaTop)/(vh*0.7)));
  $('#mascotCta').style.transform=`translateY(${(1-mcp)*180+Math.sin(t*2.3)*6}px) rotate(${Math.sin(t*1.8)*4}deg)`;
  $('#mascotCta').style.opacity=clamp((y+vh*0.75-G.ctaTop)/(vh*0.3));
  $$('.spark').forEach((s,i)=>{
    const d=+getComputedStyle(s).getPropertyValue('--d')||i*1.3;
    s.style.transform=`translateY(${Math.sin(t*1.25+d)*10}px) rotate(${Math.sin(t*0.9+d)*20}deg) scale(${0.85+0.3*Math.sin(t*1.6+d)})`;
    s.style.opacity=(0.45+0.4*Math.sin(t*1.4+d))*ctaP;
  });

  /* ============ FOOTER big word ============ */
  const ftP=clamp((y+vh-G.footerTop-G.footerH*0.35)/(vh*0.7));
  bwLetters.forEach((l,i)=>{
    const p=eoExpo(clamp(ftP*1.6-i*0.09));
    l.style.transform=`translateY(${(1-p)*0.55}em) rotate(${(1-p)*6}deg)`;
    l.style.opacity=p;
  });
  $('#footer .top').style.opacity=clamp((y+vh*0.8-G.footerTop)/(vh*0.5));
  $('#footer .base').style.opacity=clamp((y+vh*0.5-G.footerTop-G.footerH*0.5)/(vh*0.4));
}

/* pin a section's inner content by counter-translating it against the page drift */
function pinSection(wrapSel,innerSel,vh){
  const wrap=$(wrapSel),inner=$(innerSel);
  const top=wrap.getBoundingClientRect().top+curY;
  const span=wrap.offsetHeight-vh;
  const ty=clamp(curY-top,0,span);
  inner.style.transform=`translate3d(0,${ty}px,0)`;
}

/* line reveals for any section with .rl and .rlP */
function revLines(secSel,y,vh){
  const sec=$(secSel),top=sec.getBoundingClientRect().top+curY;
  sec.querySelectorAll('.rl>span').forEach((s,i)=>{
    const p=eoExpo(clamp((y+vh*0.82-top-80)/380 - i*0.14));
    s.style.transform=`translateY(${(1-p)*110}%)`;
  });
  sec.querySelectorAll('.rlP').forEach((p2,i)=>{
    const p=eoCubic(clamp((y+vh*0.72-top-140)/300 - i*0.16));
    p2.style.opacity=p; p2.style.transform=`translateY(${(1-p)*28}px)`;
  });
}

/* ---- drivers ---- */
function boot(){measure();render(0,0);
  if(CAPTURE){window.__ready=true;return}
  let start=performance.now();
  const loop=now=>{const t=(now-start)/1000;render(t,window.scrollY||window.pageYOffset);requestAnimationFrame(loop)};
  requestAnimationFrame(loop);
  addEventListener('resize',()=>{measure()});
}
window.__frame=(t,y)=>{render(t,y)};
window.__flat=()=>{render(8,G.maxY);document.body.classList.add('flat');};
window.__metrics=()=>G;
window.__settle=async()=>{await document.fonts.ready;await Promise.all([...document.images].map(i=>i.complete?1:new Promise(r=>{i.onload=r;i.onerror=r})));measure();render(0,0);return G};
if(document.readyState==='complete'||document.readyState==='interactive')boot();else addEventListener('DOMContentLoaded',boot);
</script>
</body>
</html>
