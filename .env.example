# ==============================================================================
# Salowtech Sovereign Platforms - Environment Configuration Template
# NOTE: Do NOT put sensitive secrets or production API keys in this file.
# Copy this file to .env and configure your local values.
# ==============================================================================

# Google reCAPTCHA v3 Server-Side Secret Key
RECAPTCHA_SECRET_KEY=

# CRM Webhook Verification Token
WEBHOOK_VERIFY_TOKEN=

# Optional: Local Server Port (default: 4321 for Astro, 3000 for tools/server.js)
PORT=

# Environment Mode (development / production)
NODE_ENV=
